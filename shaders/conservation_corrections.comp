#version 450
#extension GL_GOOGLE_include_directive : require
#include "materials.glsl"
#include "tiles.glsl"
#include "chunks.glsl"
#include "bee_swarm.glsl"
#include "beehive.glsl"
#include "queen_ventilation.glsl"
#include "conservation.glsl"
#include "rain_membership.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer CurrentCells { Cell cells[]; };
layout(std430, binding = 1) buffer NextCells { Cell nextCells[]; };
layout(std430, binding = 2) readonly buffer Sunlight { uint light[]; };
layout(std430, binding = 4) readonly buffer Tiles { TileState tiles[]; };
layout(std430, binding = 7) readonly buffer Chunks { ChunkState chunks[]; };

const uint CORRECTION_BEE_TIMER_BITS = 14u;
const uint CORRECTION_BEE_TIMER_MAX = 0x3fffu;
const uint CORRECTION_BEE_TARGET_NEWBORN = 0x3fffeu;
const uint CORRECTION_BEE_TARGET_NONE = 0x3ffffu;
const uint CORRECTION_BEE_AUX_POLLEN = 0x20000000u;
const uint CORRECTION_BEE_AUX_FED = 0x10000000u;
const uint CORRECTION_BEE_AUX_SWARM = 0x08000000u;
const uint CORRECTION_BEE_AUX_MIGRATING = 0x02000000u;

const ivec2 correctionNeighborOffsets[8] = ivec2[8](
    ivec2(-1, -1), ivec2(0, -1), ivec2(1, -1), ivec2(-1, 0),
    ivec2(1, 0), ivec2(-1, 1), ivec2(0, 1), ivec2(1, 1));

Cell sourceAt(ivec2 position) {
    return inside(position) ? cells[indexOf(position)] : makeCell(MAT_STONE);
}

bool sourceHasNeighbor(ivec2 position, uint material) {
    for (uint i = 0u; i < 8u; ++i)
        if (sourceAt(position + correctionNeighborOffsets[i]).material == material) return true;
    return false;
}

bool sourceHasWithin(ivec2 position, uint material, int radius) {
    for (int dy = -radius; dy <= radius; ++dy) {
        for (int dx = -radius; dx <= radius; ++dx) {
            if (dx == 0 && dy == 0) continue;
            if (sourceAt(position + ivec2(dx, dy)).material == material) return true;
        }
    }
    return false;
}

uint correctionBeeTimer(uint age) {
    return age & CORRECTION_BEE_TIMER_MAX;
}

uint correctionBeeTarget(uint age) {
    return age >> CORRECTION_BEE_TIMER_BITS;
}

uint correctionBeePackAge(uint timer, uint target) {
    return min(timer, CORRECTION_BEE_TIMER_MAX) |
           (min(target, CORRECTION_BEE_TARGET_NONE) << CORRECTION_BEE_TIMER_BITS);
}

bool correctionTargetHasFlags(uint target, uint required, uint forbidden) {
    uint tileColumns = (pc.width + 7u) / 8u;
    uint tileRows = (pc.height + 7u) / 8u;
    return target < tileColumns * tileRows &&
           (tiles[target].flags & required) == required &&
           (tiles[target].flags & forbidden) == 0u;
}

uint correctionBeeSlot(uint aux) {
    return beeFormationSlotFromAux(aux, pc.width, pc.height);
}

bool correctionBeeIsForager(uint aux) {
    uint slot = correctionBeeSlot(aux);
    return ((slot * 37u + 11u) % 10u) == 0u;
}

ivec2 correctionBeeExactHome(Cell bee) {
    ivec2 approximate = beeHomeCenterFromAux(bee.aux, pc.width, pc.height);
    ivec2 exact = approximate;
    int bestDistance = 0x3fffffff;
    int extent = beeHomeSearchExtent(bee.aux, pc.width, pc.height);
    for (int dy = -2; dy <= extent; ++dy) {
        for (int dx = -2; dx <= extent; ++dx) {
            ivec2 candidate = approximate + ivec2(dx, dy);
            if (!inside(candidate) ||
                sourceAt(candidate).material != MAT_QUEEN_BEE) continue;
            int distance = dx * dx + dy * dy;
            if (distance < bestDistance) {
                exact = candidate;
                bestDistance = distance;
            }
        }
    }
    return exact;
}

uint correctionNearestBeeTile(ivec2 position, uint required, uint forbidden,
                              int maximumTileDistance) {
    uint columns = (pc.width + 7u) / 8u;
    uint rows = (pc.height + 7u) / 8u;
    ivec2 origin = position / 8;
    uint best = CORRECTION_BEE_TARGET_NONE;
    int bestDistance = 0x3fffffff;
    for (int dy = -maximumTileDistance; dy <= maximumTileDistance; ++dy) {
        for (int dx = -maximumTileDistance; dx <= maximumTileDistance; ++dx) {
            int tileDistance = abs(dx) + abs(dy);
            if (tileDistance > maximumTileDistance) continue;
            ivec2 candidate = origin + ivec2(dx, dy);
            if (candidate.x < 0 || candidate.y < 0 ||
                candidate.x >= int(columns) || candidate.y >= int(rows)) continue;
            uint candidateIndex = uint(candidate.y) * columns + uint(candidate.x);
            if (!correctionTargetHasFlags(candidateIndex, required, forbidden)) continue;
            int distanceSquared = dx * dx + dy * dy;
            if (distanceSquared < bestDistance ||
                (distanceSquared == bestDistance && candidateIndex < best)) {
                bestDistance = distanceSquared;
                best = candidateIndex;
            }
        }
    }
    return best;
}

bool correctionBeeBesideTarget(ivec2 position, uint target, uint material) {
    if (!correctionTargetHasFlags(target, 0u, 0u)) return false;
    for (uint i = 0u; i < 8u; ++i) {
        ivec2 candidate = position + correctionNeighborOffsets[i];
        if (sourceAt(candidate).material == material &&
            tileIndex(candidate, pc.width) == target) return true;
    }
    return false;
}

bool sourceHasAnyWater(ivec2 position) {
    for (uint i = 0u; i < 8u; ++i) {
        uint material = sourceAt(position + correctionNeighborOffsets[i]).material;
        if (material == MAT_WATER || material == MAT_DIRTY_WATER ||
            material == MAT_SALTWATER) return true;
    }
    return false;
}

ivec2 correctionNearestQueen(ivec2 position, out bool found) {
    ivec2 nearest = position;
    int bestDistance = 0x3fffffff;
    uint bestIndex = 0xffffffffu;
    found = false;
    for (int dy = -5; dy <= 5; ++dy) {
        for (int dx = -5; dx <= 5; ++dx) {
            ivec2 candidate = position + ivec2(dx, dy);
            if (!inside(candidate) || sourceAt(candidate).material != MAT_QUEEN_BEE)
                continue;
            int distance = dx * dx + dy * dy;
            uint candidateIndex = indexOf(candidate);
            if (distance < bestDistance ||
                (distance == bestDistance && candidateIndex < bestIndex)) {
                found = true;
                nearest = candidate;
                bestDistance = distance;
                bestIndex = candidateIndex;
            }
        }
    }
    return nearest;
}

ivec2 correctionBeeDistrictOrigin(ivec2 homeCenter) {
    if (beeUsesPersistentWorldHome(pc.width, pc.height)) {
        uint district = 0u;
        ivec2 districtLocal = ivec2(0);
        if (beePersistentAddress(homeCenter, pc.width, pc.height,
                                 district, districtLocal))
            return beePersistentDistrictOrigin(pc.width, pc.height, district);
    }
    return beeAuthoredWorldOrigin(pc.width, pc.height);
}

uint correctionDistrictBeePopulation(ivec2 homeCenter) {
    ivec2 origin = correctionBeeDistrictOrigin(homeCenter);
    ivec2 firstTile = max(origin / int(TILE_SIZE), ivec2(0));
    ivec2 finalCell = min(origin + BEE_AUTHORED_WORLD_CELLS - ivec2(1),
                          ivec2(int(pc.width) - 1, int(pc.height) - 1));
    ivec2 finalTile = finalCell / int(TILE_SIZE);
    uint columns = tileColumns(pc.width);
    uint count = 0u;
    for (int tileY = firstTile.y; tileY <= finalTile.y; ++tileY) {
        for (int tileX = firstTile.x; tileX <= finalTile.x; ++tileX)
            count += tileBeeCount(tiles[uint(tileY) * columns + uint(tileX)]);
    }
    return count;
}

uint correctionStationaryBeeCount(ivec2 homeCenter, out uint firstMissingSlot) {
    uint count = 0u;
    firstMissingSlot = BEE_FORMATION_COUNT;
    for (uint slot = 0u; slot < BEE_FORMATION_COUNT; ++slot) {
        Cell bee = sourceAt(homeCenter + beeFormationOffset(slot));
        ivec2 storedHome = beeHomeCenterFromAux(bee.aux, pc.width, pc.height);
        bool exact = bee.material == MAT_BEE &&
            (bee.aux & BEE_AUX_SWARM) != 0u &&
            beeFormationSlotFromAux(bee.aux, pc.width, pc.height) == slot &&
            beeOwnsHome(bee.aux, homeCenter, pc.width, pc.height);
        if (exact) ++count;
        else if (firstMissingSlot == BEE_FORMATION_COUNT)
            firstMissingSlot = slot;
    }
    return count;
}

uint correctionCountWithin(ivec2 position, uint material, int radius) {
    uint count = 0u;
    for (int dy = -radius; dy <= radius; ++dy) {
        for (int dx = -radius; dx <= radius; ++dx) {
            if (dx * dx + dy * dy <= radius * radius &&
                sourceAt(position + ivec2(dx, dy)).material == material)
                ++count;
        }
    }
    return count;
}

bool correctionCurrentBirthCandidate(ivec2 position,
                                     out ivec2 queenPosition) {
    bool queenFound = false;
    queenPosition = correctionNearestQueen(position, queenFound);
    ivec2 queenOffset = queenPosition - position;
    int queenDistance = queenOffset.x * queenOffset.x +
        queenOffset.y * queenOffset.y;
    bool nestFrontier = sourceHasNeighbor(position, MAT_QUEEN_BEE) ||
        sourceHasNeighbor(position, MAT_BEEHIVE);
    bool foodFrontier = sourceHasNeighbor(position, MAT_HONEY) ||
        sourceHasNeighbor(position, MAT_POLLEN);
    bool chemistryAvailable = nextCells[indexOf(position)].material == MAT_EMPTY ||
        nextCells[indexOf(position)].material == MAT_BEE;
    return sourceAt(position).material == MAT_EMPTY && queenFound &&
        queenDistance > 0 && queenDistance <= 6 && nestFrontier && foodFrontier &&
        chemistryAvailable && correctionCountWithin(position, MAT_BEE, 6) < 4u &&
        ((pc.step + indexOf(queenPosition)) & 4095u) == 0u;
}

uint correctionBirthOwner(ivec2 queenPosition) {
    uint owner = 0xffffffffu;
    for (int dy = -3; dy <= 3; ++dy) {
        for (int dx = -3; dx <= 3; ++dx) {
            ivec2 candidate = queenPosition + ivec2(dx, dy);
            if (!inside(candidate)) continue;
            uint candidateIndex = indexOf(candidate);
            ivec2 candidateQueen = ivec2(0);
            if (correctionCurrentBirthCandidate(candidate, candidateQueen) &&
                all(equal(candidateQueen, queenPosition)))
                owner = min(owner, candidateIndex);
        }
    }
    return owner;
}

bool openSkylightMedium(uint material) {
    return material == MAT_EMPTY || isGas(material);
}

bool shallowSkylightSurface(ivec2 position, uint firstOpaqueRow) {
    for (int distance = 1; distance <= 3; ++distance) {
        ivec2 above = position + ivec2(0, -distance);
        uint material = sourceAt(above).material;
        if (openSkylightMedium(material))
            return uint(above.y) < firstOpaqueRow;
        if (material != MAT_GRASS && material != MAT_DIRT) return false;
    }
    return false;
}

Cell advancedSource(Cell source) {
    Cell restored = source;
    restored.age = source.age + 1u;
    restored.aux &= ~AUX_MOVED;
    return restored;
}

void undoConvertedStat() {
    atomicAdd(conservation[CONS_CONVERTED], 0xffffffffu);
}

void undoMaterialChangeStat(Cell before, Cell after) {
    if (before.material >= MATERIAL_COUNT || after.material >= MATERIAL_COUNT) {
        atomicAdd(conservation[CONS_ERRORS], 0xffffffffu);
        return;
    }
    if (before.material == MAT_EMPTY && after.material != MAT_EMPTY) {
        atomicAdd(conservation[CONS_CREATED], 0xffffffffu);
    } else if (before.material != MAT_EMPTY && after.material == MAT_EMPTY) {
        uint counter = isEphemeralEnergy(before.material)
            ? CONS_BOUNDARY_LOST : CONS_DESTROYED;
        atomicAdd(conservation[counter], 0xffffffffu);
    } else if (before.material != after.material) {
        atomicAdd(conservation[CONS_CONVERTED], 0xffffffffu);
    }
    if (before.material == after.material && cellPhase(before) != cellPhase(after))
        atomicAdd(conservation[CONS_PHASE_CHANGES], 0xffffffffu);
    if (!isStructural(before) && isStructural(after))
        atomicAdd(conservation[CONS_STABILIZED], 0xffffffffu);
    if (isStructural(before) && !isStructural(after))
        atomicAdd(conservation[CONS_BROKEN], 0xffffffffu);
}

void addConvertedStat() {
    atomicAdd(conservation[CONS_CONVERTED], 1u);
}

bool queenVentInsideDispatch(ivec2 position) {
    if (!inside(position) || !sectionActiveAt(position, pc.activeSectionX,
        pc.activeSectionY, pc.activeMode)) return false;
    ivec2 local = position - activeDispatchCellOrigin(
        pc.activeSectionX, pc.activeSectionY, pc.activeMode);
    return pc.radius == 0u || (all(greaterThanEqual(local, ivec2(0))) &&
        uint(local.x) < pc.radius && uint(local.y) < pc.material);
}

bool queenVentOpenMedium(Cell cell) {
    return cell.material == MAT_EMPTY || cell.material == MAT_ATMOSPHERE;
}

bool queenVentChemistryAwake(ivec2 position) {
    ivec2 center = ivec2(chunkCoordinate(position));
    ivec2 limit = ivec2(int(chunkColumns(pc.width)), int(chunkRows(pc.height)));
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x) {
            ivec2 candidate = center + ivec2(x, y);
            if (any(lessThan(candidate, ivec2(0))) ||
                any(greaterThanEqual(candidate, limit))) continue;
            ChunkState state = chunks[uint(candidate.y) * uint(limit.x) + uint(candidate.x)];
            if (!chunkHas(state, CHUNK_SLEEPING) || chunkHas(state, CHUNK_DIRTY)) return true;
        }
    return false;
}

bool queenVentHomeBee(Cell cell, ivec2 queen) {
    return cell.material == MAT_BEE &&
        (cell.aux & (BEE_AUX_SWARM | BEE_AUX_QUEEN | BEE_AUX_MIGRATING)) == BEE_AUX_SWARM &&
        beeFormationSlotFromAux(cell.aux, pc.width, pc.height) < 60u &&
        beeOwnsHome(cell.aux, queen, pc.width, pc.height);
}

bool queenVentCanonicalBody(ivec2 queen) {
    if (!inside(queen - ivec2(10)) || !inside(queen + ivec2(10))) return false;
    ivec2 entropyQueen = queen;
    uint district = 0u;
    ivec2 local = ivec2(0);
    if (beePersistentAddress(queen, pc.width, pc.height, district, local))
        entropyQueen = local;
    for (int y = -10; y <= 10; ++y) {
        for (int x = -10; x <= 10; ++x) {
            ivec2 offset = ivec2(x, y);
            uint expected = beehivePrefabMaterial(entropyQueen, offset,
                beehivePrefabEntropy(entropyQueen, offset));
            if (expected == MATERIAL_COUNT || expected == MAT_QUEEN_BEE) continue;
            Cell cell = sourceAt(queen + offset);
            if (expected == MAT_EMPTY) {
                bool homeBee = queenVentHomeBee(cell, queen);
                if (!queenVentOpenMedium(cell) && !homeBee) return false;
            } else if (cell.material != expected ||
                (cell.aux & (AUX_STRUCTURAL | AUX_SUPPORTED)) !=
                    (AUX_STRUCTURAL | AUX_SUPPORTED)) return false;
        }
    }
    // Own returning/newborn Bees may cross the open exit without sealing it.
    // Besides refusing a sealed/flooded vent, this excludes a machine controller
    // at queen+(6,1), not merely the centerline controller at queen+(6,0).
    for (int x = 1; x <= 10; ++x)
        for (int y = -1; y <= 1; ++y) {
            Cell cell = sourceAt(queen + ivec2(x, y));
            if (!queenVentOpenMedium(cell) && !queenVentHomeBee(cell, queen)) return false;
        }
    return true;
}

// Both endpoints derive this transaction solely from the immutable canonical
// input. The unique mouth at queen+(11,0) has exactly one inverse Queen; each
// invocation writes only its own nextCells index, with no mutable-neighbor
// proposal read or atomic reservation whose result could fund only one side.
bool queenVentTransaction(ivec2 queen, out Cell restoredQueen, out Cell breathed) {
    ivec2 mouth = queen + ivec2(11, 0);
    if (!queenVentInsideDispatch(queen) || !queenVentInsideDispatch(mouth)) return false;
    if (!tileHas(tiles[tileIndex(queen, pc.width)], TILE_HAS_QUEEN)) return false;
    Cell owner = sourceAt(queen);
    if (owner.material != MAT_QUEEN_BEE || isStructural(owner)) return false;
    uint roll = cellHash(queen, owner.age ^ owner.aux);
    // An intact open exit has at least one Empty/Air neighbor, so the legacy
    // fully-choked mask cannot apply. Rescue only its exact zero-local-O2
    // suffocation opportunity; real senescence remains an unfunded death.
    if ((roll & 1023u) != 0u ||
        (owner.age > 900000u && (roll & 16383u) == 0u)) return false;
    // Mirror the immutable nonstructural chemistry sleep gate at both ends.
    // Even supplied stale metadata must not admit just one side of a breath.
    if (!queenVentChemistryAwake(queen) || !queenVentChemistryAwake(mouth)) return false;
    for (int y = -2; y <= 2; ++y)
        for (int x = -2; x <= 2; ++x) {
            if (x * x + y * y > 4) continue;
            uint material = sourceAt(queen + ivec2(x, y)).material;
            if (material == MAT_ATMOSPHERE || material == MAT_OXYGEN) return false;
        }
    Cell donor = sourceAt(mouth);
    if (donor.material != MAT_ATMOSPHERE || isStructural(donor)) return false;
    // Exclude unrelated respiration, photosynthesis, aeration, combustion,
    // and synthesis; admitted home-Bee respiration is budgeted below.
    // The complete exit/body check excludes remote controller
    // input to this same mouth. Its chemistry proposal may change age/heat,
    // but cannot independently spend or replace its pressure/component owner.
    uint nearbyHomeBees = 0u;
    for (uint i = 0u; i < 8u; ++i) {
        Cell neighbor = sourceAt(mouth + correctionNeighborOffsets[i]);
        if (queenVentHomeBee(neighbor, queen)) ++nearbyHomeBees;
        else if (!queenVentOpenMedium(neighbor)) return false;
    }
    if (!queenVentCanonicalBody(queen)) return false;

    // A legitimate transit Bee does not occlude the whole three-row entrance,
    // but its ordinary gas-side respiration still owns its Oxygen. Reserve
    // that exact legacy breath before the Queen's additional breath. Failure
    // on either endpoint leaves the original chemistry proposal untouched.
    breathed = donor;
    uint breaths = queenVentRequiredBreaths(nearbyHomeBees,
        cellHash(mouth, donor.age ^ donor.aux));
    for (uint breath = 0u; breath < breaths; ++breath)
        if (!respirePackedMedium(breathed)) return false;

    restoredQueen = advancedSource(owner);
    int neighbors = (sourceAt(queen + ivec2(1, 0)).temperature +
        sourceAt(queen + ivec2(-1, 0)).temperature +
        sourceAt(queen + ivec2(0, 1)).temperature +
        sourceAt(queen + ivec2(0, -1)).temperature) / 4;
    int ambient = 20 + int(light[indexOf(queen)] / 48u);
    int target = (neighbors * 3 + ambient) / 4;
    int divisor = clamp(36 - int(materialThermalConductivity(owner.material)) / 9, 6, 36);
    restoredQueen.temperature = clamp(owner.temperature +
        clamp((target - owner.temperature) / divisor, -20, 20), -200, 5000);
    if (restoredQueen.temperature > 160) return false;

    // Preserve the frozen Queen's actual pre-death stress update. Its legacy
    // population threshold is90 (the frozen100-bee model), not the current
    // authored60; redesigning Queen reproduction is separate from ventilation.
    uint nearbyBees = 0u;
    bool nearbyHoney = false;
    ivec2 centerTile = queen / int(TILE_SIZE);
    ivec2 tileLimit = ivec2(int(tileColumns(pc.width)), int((pc.height + 7u) / 8u));
    for (int y = -6; y <= 6; ++y)
        for (int x = -6; x <= 6; ++x) {
            ivec2 candidate = centerTile + ivec2(x, y);
            if (any(lessThan(candidate, ivec2(0))) ||
                any(greaterThanEqual(candidate, tileLimit))) continue;
            TileState tile = tiles[uint(candidate.y) * tileColumns(pc.width) + uint(candidate.x)];
            nearbyBees += tileBeeCount(tile);
            if (abs(x) <= 2 && abs(y) <= 2 && tileHas(tile, TILE_HAS_HONEY)) nearbyHoney = true;
        }
    uint stress = stateValue(owner);
    bool stressed = (nearbyBees >= 90u && nearbyHoney) || !nearbyHoney;
    uint nextStress = stressed ? min(255u, stress + 8u) :
        (stress > 0u ? stress - 1u : 0u);
    // Do not fund a Queen whose other legitimate same-pass outcome could be
    // a migrating carrier. That lifecycle retains its existing decision path.
    if (nextStress >= 240u && owner.age > 36000u) return false;
    setStateValue(restoredQueen, nextStress);
    return true;
}

void main() {
    // Do not publish metadata or counters for padded scratch invocations that
    // are outside the exact rectangle subsequently copied to canonical cells.
    if (pc.radius != 0u && (gl_GlobalInvocationID.x >= pc.radius ||
                           gl_GlobalInvocationID.y >= pc.material)) return;
    ivec2 position = ivec2(gl_GlobalInvocationID.xy) + activeDispatchCellOrigin(
        pc.activeSectionX, pc.activeSectionY, pc.activeMode);
    if (!inside(position) ||
        !sectionActiveAt(position, pc.activeSectionX, pc.activeSectionY, pc.activeMode)) return;

    uint index = indexOf(position);
    Cell source = cells[index];
    Cell proposed = nextCells[index];
    Cell corrected = proposed;
    bool rainEmissionReserved = false;

    if (source.material == MAT_QUEEN_BEE && proposed.material == MAT_WASTE) {
        Cell restoredQueen;
        Cell breathed;
        if (queenVentTransaction(position, restoredQueen, breathed)) {
            corrected = restoredQueen;
            undoMaterialChangeStat(source, proposed);
            recordConservation(source, corrected);
        }
    } else if (source.material == MAT_ATMOSPHERE && position.x >= 11) {
        ivec2 queen = position - ivec2(11, 0);
        // Classification is already ordered before chemistry. Its conservative
        // Queen bit cheaply excludes almost all ordinary Atmosphere invocations.
        if (tileHas(tiles[tileIndex(queen, pc.width)], TILE_HAS_QUEEN)) {
            Cell restoredQueen;
            Cell breathed;
            if (queenVentTransaction(queen, restoredQueen, breathed)) {
                breathed.age = proposed.age;
                breathed.temperature = proposed.temperature;
                breathed.aux = (breathed.aux & ~AUX_MOVED) | (proposed.aux & AUX_MOVED);
                corrected = breathed;
            }
        }
    }

    // The frozen chemistry kernel retains its historical Empty -> Bee birth
    // path only to preserve the proven software-Vulkan control-flow shape.
    // Reject that unpaired proposal here. Do not reject Queen -> Bee: that is
    // the legitimate queen-carrier migration transition owned by the current
    // lifecycle. The dedicated Bee movement phase owns replacement births.
    if (source.material == MAT_EMPTY && proposed.material == MAT_BEE) {
        corrected = advancedSource(source);
        undoMaterialChangeStat(source, proposed);
    }

    // Preserve the proven monolithic chemistry control-flow shape for
    // software Vulkan, but never commit its retired circular-nest growth.
    // Canonical Beehive bodies are authored only by reset/import/tool paths;
    // the dedicated Bee birth phase below is the sole replacement authority.
    if (source.material != MAT_BEEHIVE && proposed.material == MAT_BEEHIVE) {
        corrected = advancedSource(source);
        undoMaterialChangeStat(source, proposed);
    }

    // Keep the proven monolithic chemistry kernel's control-flow shape for
    // software Vulkan, but own the complete current 14-bit-timer/18-bit-target
    // lifecycle for authored bees here. The frozen kernel still owns hazards
    // and paired Pollen creation; this shallow pass preserves current metadata
    // and performs flower departure, pickup, return/deposit, and Honey feeding.
    if (source.material == MAT_BEE && proposed.material == MAT_BEE &&
        (source.aux & CORRECTION_BEE_AUX_SWARM) != 0u &&
        (source.aux & CORRECTION_BEE_AUX_MIGRATING) == 0u) {
        corrected = source;
        uint target = correctionBeeTarget(source.age);
        uint timer = target == CORRECTION_BEE_TARGET_NEWBORN
            ? correctionBeeTimer(source.age)
            : min(correctionBeeTimer(source.age) + 1u,
                  CORRECTION_BEE_TIMER_MAX);
        bool carryingPollen = (source.aux & CORRECTION_BEE_AUX_POLLEN) != 0u;
        bool fed = (source.aux & CORRECTION_BEE_AUX_FED) != 0u;
        corrected.age = correctionBeePackAge(timer, target);

        // Birth is an explicit lifecycle state, not a position guess. Several
        // legitimate lower-lobe slots sit inside the same 21x21 neighborhood
        // as the chamber; treating every bee there as a newborn dragged those
        // established owners through the exit on every reset. A new owner keeps
        // this reserved target only while it traverses the photographed
        // right-hand exit. Once outside, normal slot/forager ownership resumes.
        bool newbornTransit = target == CORRECTION_BEE_TARGET_NEWBORN;
        if (newbornTransit) {
            ivec2 home = correctionBeeExactHome(source);
            ivec2 settled = home + beeFormationOffset(
                correctionBeeSlot(source.aux));
            if (all(equal(position, settled))) {
                target = CORRECTION_BEE_TARGET_NONE;
                timer = 0u;
                newbornTransit = false;
                corrected.age = correctionBeePackAge(timer, target);
            }
        }

        if (!newbornTransit && fed && !carryingPollen &&
            target == CORRECTION_BEE_TARGET_NONE &&
            correctionBeeIsForager(source.aux) &&
            timer >= 1200u + ((correctionBeeSlot(source.aux) * 29u) % 600u)) {
            target = correctionNearestBeeTile(
                position, TILE_HAS_FLOWER,
                TILE_HAS_HIVE | TILE_HAS_QUEEN | TILE_HAS_MIGRATING_QUEEN |
                    TILE_BEE_HAZARD,
                16);
            // No known Flower is not a command to become a static decoration.
            // Six real owners make a bounded food-search excursion, then
            // return; search itself never invents pollen, food or Bees.
            if (target == CORRECTION_BEE_TARGET_NONE) target = BEE_TARGET_SEARCH;
            timer = 0u;
            corrected.age = correctionBeePackAge(timer, target);
        }

        if (!newbornTransit && target == BEE_TARGET_SEARCH) {
            if (timer < 192u && (timer & 31u) == 0u) {
                uint flower = correctionNearestBeeTile(position, TILE_HAS_FLOWER,
                    TILE_HAS_HIVE | TILE_HAS_QUEEN | TILE_HAS_MIGRATING_QUEEN |
                        TILE_BEE_HAZARD, 16);
                if (flower != CORRECTION_BEE_TARGET_NONE) {
                    target = flower;
                    timer = 0u;
                }
            }
            ivec2 rest = correctionBeeExactHome(source) +
                beeFormationOffset(correctionBeeSlot(source.aux));
            if (target == BEE_TARGET_SEARCH && timer >= 192u &&
                all(equal(position, rest))) {
                target = CORRECTION_BEE_TARGET_NONE;
                timer = 0u;
            }
            corrected.age = correctionBeePackAge(timer, target);
        }

        if (!newbornTransit && fed && !carryingPollen &&
            target != CORRECTION_BEE_TARGET_NONE && target != BEE_TARGET_SEARCH) {
            if (!correctionTargetHasFlags(target, TILE_HAS_FLOWER,
                                          TILE_BEE_HAZARD)) {
                target = CORRECTION_BEE_TARGET_NONE;
                timer = 0u;
                corrected.age = correctionBeePackAge(timer, target);
            } else if (correctionBeeBesideTarget(position, target, MAT_FLOWER)) {
                corrected.aux |= CORRECTION_BEE_AUX_POLLEN;
                corrected.aux &= ~CORRECTION_BEE_AUX_FED;
                carryingPollen = true;
                fed = false;
                target = CORRECTION_BEE_TARGET_NONE;
                timer = 0u;
                corrected.age = correctionBeePackAge(timer, target);
            }
        }

        if (!newbornTransit && carryingPollen &&
            (sourceHasNeighbor(position, MAT_QUEEN_BEE) ||
             sourceHasNeighbor(position, MAT_BEEHIVE))) {
            corrected.aux &= ~(CORRECTION_BEE_AUX_POLLEN |
                               CORRECTION_BEE_AUX_FED);
            carryingPollen = false;
            fed = false;
            target = correctionNearestBeeTile(
                position, TILE_HAS_HONEY, TILE_BEE_HAZARD, 12);
            timer = 0u;
            corrected.age = correctionBeePackAge(timer, target);
        }

        if (!newbornTransit && !carryingPollen && !fed) {
            if (!correctionTargetHasFlags(target, TILE_HAS_HONEY,
                                          TILE_BEE_HAZARD)) {
                target = correctionNearestBeeTile(
                    position, TILE_HAS_HONEY, TILE_BEE_HAZARD, 12);
                timer = 0u;
                corrected.age = correctionBeePackAge(timer, target);
            }
            if (target != CORRECTION_BEE_TARGET_NONE &&
                correctionBeeBesideTarget(position, target, MAT_HONEY)) {
                if (timer == 0u) {
                    timer = 1u;
                    corrected.age = correctionBeePackAge(timer, target);
                } else {
                    corrected.aux |= CORRECTION_BEE_AUX_FED;
                    corrected.age = correctionBeePackAge(
                        0u, CORRECTION_BEE_TARGET_NONE);
                }
            }
        }
    }

    // The fine-authored Fix29 shell is canonical body content, not loose cargo.
    if (source.material == MAT_BEEHIVE && isStructural(source)) {
        corrected = source;
        corrected.aux |= AUX_STRUCTURAL | AUX_SUPPORTED;
        corrected.aux &= ~AUX_MOVED;
        corrected.age = 0u;
        if (isStructural(source) && !isStructural(proposed))
            atomicAdd(conservation[CONS_BROKEN], 0xffffffffu);
    }

    // The legacy monolithic kernel retains its proven software-Vulkan shape;
    // cancel the two formerly unowned Acid conversions transactionally here.
    bool acidInventedWater = source.material == MAT_ACID &&
        (proposed.material == MAT_WATER || proposed.material == MAT_SALTWATER);
    uint reactionRandom = cellHash(position, source.age ^ source.aux);
    bool acidInventedSolution = !isWaterBased(source.material) &&
        source.material != MAT_CLOUD && !acidImmune(source.material) &&
        !isOrganic(source.material) && proposed.material == MAT_DIRTY_WATER &&
        sourceHasNeighbor(position, MAT_ACID) &&
        (reactionRandom & 31u) == 0u &&
        ((reactionRandom >> 8u) & 255u) > acidResistance(source.material);
    if (acidInventedWater || acidInventedSolution) {
        corrected = advancedSource(source);
        undoConvertedStat();
    } else if (source.material == MAT_WASTE && proposed.material == MAT_DIRTY_WATER &&
               sourceHasAnyWater(position)) {
        corrected = makeCell(MAT_FERTILIZER);
        // Waste -> Dirty Water and Waste -> Fertilizer are both one conversion,
        // so the existing conversion count already describes the final event.
    }

    // The weather schedule exclusively owns precipitation. Dry periods never
    // animate Cloud. During the bounded rain interval, sectors emit one lower-
    // edge owner at staggered phases into a per-column tracker; the separate
    // narrow rainfall pass then carries only already-falling Water off-window.
    if (source.material == MAT_CLOUD) {
        const uint weatherCycleTicks = 7200u;
        const uint rainStartTick = 4800u;
        const uint rainDurationTicks = 600u;
        const uint emissionCadence = 360u;
        const uint sectorWidth = 256u;
        uint weatherTick = pc.step % weatherCycleTicks;
        uint sector = uint(max(position.x, 0)) / sectorWidth;
        uint rainTick = weatherTick >= rainStartTick
            ? weatherTick - rainStartTick : 0u;
        uint sectorPhase = (sector * 37u) % emissionCadence;
        uint eventIndex = rainTick / emissionCadence;
        uint lane = hash32(sector ^ eventIndex * 0x9e3779b9u ^
                           (pc.step / weatherCycleTicks) * 0x85ebca6bu) %
                    sectorWidth;
        bool rainScheduled = weatherTick >= rainStartTick &&
            weatherTick < rainStartTick + rainDurationTicks;
        bool candidate = rainScheduled && source.age > 600u &&
            (rainTick % emissionCadence) == sectorPhase &&
            (uint(max(position.x, 0)) % sectorWidth) == lane &&
            sourceAt(position + ivec2(0, 1)).material != MAT_CLOUD;
        bool oldRain = proposed.material == MAT_WATER ||
            proposed.material == MAT_DIRTY_WATER;
        bool ownsColumn = candidate &&
            rainTryReserveEmission(uint(position.x), pc.width);
        if (ownsColumn) {
            rainEmissionReserved = true;
            corrected = makeCell((source.aux & AUX_WET) != 0u
                                     ? MAT_DIRTY_WATER : MAT_WATER);
            corrected.aux |= AUX_RAIN_DROP;
            corrected.temperature = source.temperature;
            if (!oldRain) addConvertedStat();
        } else if (oldRain) {
            corrected = advancedSource(source);
            undoConvertedStat();
        }
    }

    // Grass is a shallow skin, not a full authored 8x8 dirt substitute. The
    // correction stays shallow and deterministic so the proven chemistry
    // kernel remains unchanged. Wet earth may regrow only within three cells
    // of an open sky column; buried Grass immediately returns to Dirt.
    if ((source.material == MAT_GRASS || source.material == MAT_DIRT) &&
        (corrected.material == MAT_GRASS || corrected.material == MAT_DIRT)) {
        uint encodedOpaqueRow = light[uint(light.length()) - pc.width +
                                      uint(position.x)];
        // A reset/edit may invalidate sunlight before its next production
        // dispatch. Missing derived metadata must not manufacture exposure.
        bool exposureReady = encodedOpaqueRow != 0u;
        bool shallowSurface = exposureReady &&
            shallowSkylightSurface(position, encodedOpaqueRow - 1u);
        if (exposureReady && corrected.material == MAT_GRASS && !shallowSurface) {
            undoMaterialChangeStat(source, corrected);
            corrected = makeCell(MAT_DIRT);
            corrected.aux = source.aux & ~AUX_MOVED;
            corrected.temperature = source.temperature;
            if (source.material != MAT_DIRT) addConvertedStat();
        } else if (corrected.material == source.material &&
                   source.material == MAT_DIRT && shallowSurface &&
                   sourceHasAnyWater(position) && source.age > 1200u &&
                   (reactionRandom & 1023u) == 0u) {
            corrected = makeCell(MAT_GRASS);
            corrected.aux = source.aux & ~AUX_MOVED;
            corrected.temperature = source.temperature;
            addConvertedStat();
        }
    }

    // Sleeping vapor still participates in the same one-for-one Cloud phase
    // transition without forcing the monolithic kernel's sleep selector open.
    if ((source.material == MAT_STEAM || source.material == MAT_DIRTY_STEAM) &&
        proposed.material == source.material) {
        bool dirtyVapor = source.material == MAT_DIRTY_STEAM;
        bool joinsCloud = sourceHasNeighbor(position, MAT_CLOUD) &&
            (source.age > 120u || proposed.temperature < (dirtyVapor ? 70 : 75));
        bool nucleatesCloud = source.age > (dirtyVapor ? 2100u : 1800u) &&
            (sourceHasNeighbor(position, MAT_ICE) || sourceHasNeighbor(position, MAT_SNOW) ||
             proposed.temperature < (dirtyVapor ? 32 : 34)) &&
            (cellHash(position, source.age ^ source.aux) & 255u) == 0u;
        if (joinsCloud || nucleatesCloud) {
            corrected = makeCell(MAT_CLOUD);
            if (dirtyVapor) corrected.aux |= AUX_WET;
            corrected.temperature = source.temperature;
            addConvertedStat();
        }
    }

    // Authored bees are advanced by the dedicated lightweight bee movement
    // pass after generic fine movement. Marking them moved here keeps the
    // frozen material kernel from applying its legacy 100-slot target model.
    if (corrected.material == MAT_BEE &&
        (corrected.aux & CORRECTION_BEE_AUX_SWARM) != 0u)
        corrected.aux |= AUX_MOVED;

    nextCells[index] = corrected;
    // Membership follows the final committed proposal, not the immutable
    // source: a phase change can remove a tag and rain emission can add one.
    // Ordinary non-rain chemistry performs no tracker atomic operation.
    if (rainEmissionReserved) {
        if (isTrackedRain(corrected)) rainRegisterReserved(position, pc.width);
        else {
            rainCancelEmission(uint(position.x), pc.width);
            rainReconcile(position, corrected, pc.width);
        }
    } else if (isTrackedRain(source) || isTrackedRain(corrected)) {
        rainReconcile(position, corrected, pc.width);
    }
}
