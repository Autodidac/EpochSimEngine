#version 450
#extension GL_GOOGLE_include_directive : require
#define SANDHYBRID_NO_SIM_PUSH
#include "materials.glsl"
#include "actor.glsl"
#include "conservation.glsl"
#include "tiles.glsl"
#include "chunks.glsl"
#include "debug_stats.glsl"
#include "rain_membership.glsl"

layout(local_size_x = 1, local_size_y = 1) in;
layout(std430, binding = 0) buffer CurrentCells { Cell cells[]; };
layout(std430, binding = 3) buffer ActorBuffer { ActorState actor; };
layout(std430, binding = 5) buffer DebugStatsBuffer { uint debugStats[]; };
layout(std430, binding = 7) buffer Chunks { ChunkState chunks[]; };

layout(push_constant) uniform ActorPush {
    uint width;
    uint height;
    uint step;
    uint seed;
    int moveX;
    int moveY;
    int aimX;
    int aimY;
    uint fire;
    uint reset;
    uint scene;
    uint deposit;
    uint simulate;
    int activeSectionX;
    int activeSectionY;
    uint activeMode;
    uint inventorySlot;
} actorPc;

const uint SCENE_SANDBOX = 0u;
const uint SCENE_BLANK = 1u;
const uint SCENE_VOLCANO = 2u;
const uint SCENE_WATERWORKS = 3u;
const uint SCENE_ECOSYSTEM = 4u;
const uint SCENE_ENGINEERING = 5u;
const uint SCENE_GOLD_MINE = 6u;
const uint SCENE_DEMOLITION = 7u;
const uint SCENE_FRONTIER_BASE = 8u;

bool actorInside(ivec2 p) {
    return p.x >= 0 && p.y >= 0 && p.x < int(actorPc.width) && p.y < int(actorPc.height);
}

uint actorIndex(ivec2 p) {
    return uint(p.y) * actorPc.width + uint(p.x);
}

void markActorChunkDirty(ivec2 p) {
    if (!actorInside(p)) return;
    // The actor is one exclusive invocation. Reconcile both committed swap
    // endpoints here, including cross-column rain displaced by its body.
    rainReconcile(p, cells[actorIndex(p)], actorPc.width);
    atomicOr(chunks[chunkIndex(p, actorPc.width)].flags, CHUNK_DIRTY | CHUNK_ACTIVE);
}

Cell actorAt(ivec2 p) {
    if (!actorInside(p)) return Cell(MAT_STONE, 0u, 20, AUX_STRUCTURAL | AUX_SUPPORTED | 255u);
    return cells[actorIndex(p)];
}

bool blocksActor(Cell cell) {
    if (cell.material == MAT_EMPTY || isGas(cell.material) || isLiquid(cell.material) ||
        cell.material == MAT_BEE || cell.material == MAT_POLLEN ||
        cell.material == MAT_FLOWER || cell.material == MAT_GRASS || cell.material == MAT_PLANT_STEM ||
        cell.material == MAT_ANT) return false;
    bool loosePickup = !isStructural(cell) &&
        (cell.material == MAT_GOLD || cell.material == MAT_IRON ||
         cell.material == MAT_COPPER || cell.material == MAT_ALUMINUM ||
         cell.material == MAT_ALUMINUM_SHAVINGS || cell.material == MAT_IRON_ORE ||
         cell.material == MAT_POWER_CELL || cell.material == MAT_PLASMA_AMMO);
    return !loosePickup;
}


void nudgeMedium(ivec2 sourcePosition, ivec2 direction) {
    if (all(equal(direction, ivec2(0)))) return;
    ivec2 targetPosition = sourcePosition + direction;
    if (!actorInside(sourcePosition) || !actorInside(targetPosition)) return;
    uint sourceIndex = actorIndex(sourcePosition);
    uint targetIndex = actorIndex(targetPosition);
    Cell source = cells[sourceIndex];
    Cell target = cells[targetIndex];
    if (!isCellGas(source) && !isCellLiquid(source)) return;
    if (isStructural(target) || (!isCellGas(target) && !isCellLiquid(target) && target.material != MAT_EMPTY)) return;
    source.age = 0u;
    target.age = 0u;
    source.aux |= AUX_MOVED;
    target.aux |= AUX_MOVED;
    cells[sourceIndex] = target;
    cells[targetIndex] = source;
    markActorChunkDirty(sourcePosition);
    markActorChunkDirty(targetPosition);
    atomicAdd(debugStats[STAT_PLAYER_IMPULSES], 1u);
}

void disturbMediumAroundActor(ivec2 center, ivec2 direction) {
    if (all(equal(direction, ivec2(0)))) return;
    if (direction.x != 0) {
        int edgeX = center.x + direction.x * (ACTOR_HALF_WIDTH + 1);
        nudgeMedium(ivec2(edgeX, center.y - 2), direction);
        nudgeMedium(ivec2(edgeX, center.y + ACTOR_TOOL_ORIGIN_OFFSET), direction);
        nudgeMedium(ivec2(edgeX, center.y + ACTOR_HEAD_CENTER_OFFSET), direction);
    } else {
        int edgeY = direction.y < 0 ? center.y + ACTOR_TOP_OFFSET - 1 : center.y + 1;
        nudgeMedium(ivec2(center.x - ACTOR_HALF_WIDTH, edgeY), direction);
        nudgeMedium(ivec2(center.x, edgeY), direction);
        nudgeMedium(ivec2(center.x + ACTOR_HALF_WIDTH, edgeY), direction);
    }
}

bool bodyClear(ivec2 center) {
    for (int y = ACTOR_TOP_OFFSET; y <= 0; ++y) {
        for (int x = -ACTOR_HALF_WIDTH; x <= ACTOR_HALF_WIDTH; ++x) {
            if (blocksActor(actorAt(center + ivec2(x, y)))) return false;
        }
    }
    return true;
}

bool groundedAt(ivec2 center) {
    for (int x = -ACTOR_HALF_WIDTH; x <= ACTOR_HALF_WIDTH; ++x) {
        if (blocksActor(actorAt(center + ivec2(x, 1)))) return true;
    }
    return false;
}

bool stableLaserMedium(uint material) {
    // Only canonical breathable/component gas can receive a terminal fragment.
    // Cloud, vapor, smoke, Fire, Radiation, and Lightning are visible material
    // owners and must not masquerade as an open transfer destination.
    return material == MAT_ATMOSPHERE || material == MAT_OXYGEN ||
           material == MAT_CARBON_DIOXIDE || material == MAT_HYDROGEN;
}

bool toolTransparent(Cell cell) {
    // The ray may cross true Vacuum and the ordinary atmospheric transport
    // medium. A cell already transferred this tick is also transparent: moving
    // powder, liquid, gas, debris, and life may not shield a stationary owner.
    return cell.material == MAT_EMPTY || stableLaserMedium(cell.material) ||
           (cell.aux & AUX_MOVED) != 0u;
}

void updateUnlocks(inout ActorState state) {
    // Element-linked progression is deterministic and visible in the HUD.
    // Iron improves drill integrity damage; copper extends range; aluminum
    // improves movement/jump; gold unlocks plasma use against hostile fauna.
    if (state.iron >= 8u) state.unlocks |= 1u;
    if (state.copper >= 6u) state.unlocks |= 2u;
    if (state.aluminum >= 6u) state.unlocks |= 4u;
    if (state.gold >= 3u) state.unlocks |= 8u;
    state.drillLevel = 1u + ((state.unlocks & 1u) != 0u ? 1u : 0u);
}

bool tryStoreResource(inout ActorState state, uint material) {
    if (material == MAT_GOLD && state.gold < 9999u) state.gold += 1u;
    else if ((material == MAT_IRON || material == MAT_IRON_ORE ||
              material == MAT_STEEL) && state.iron < 9999u) state.iron += 1u;
    else if (material == MAT_COPPER && state.copper < 9999u) state.copper += 1u;
    else if ((material == MAT_ALUMINUM || material == MAT_ALUMINUM_SHAVINGS) &&
             state.aluminum < 9999u) state.aluminum += 1u;
    else if (material == MAT_PLASMA_AMMO && state.ammo < 999u) state.ammo += 1u;
    else return false;
    atomicAdd(conservation[CONS_CONVERTED], 1u);
    return true;
}

bool isInventoryResource(uint material) {
    return material == MAT_GOLD || material == MAT_IRON ||
           material == MAT_IRON_ORE || material == MAT_STEEL ||
           material == MAT_COPPER || material == MAT_ALUMINUM ||
           material == MAT_ALUMINUM_SHAVINGS || material == MAT_PLASMA_AMMO;
}

void markLaserFragmentWorldOnly(inout Cell fragment) {
    // AUX_BEE_POLLEN is type-disjoint for ordinary condensed materials and
    // survives normal fine movement. It prevents both later actor collection
    // and immediate loose-cell repair into the same damaged tile. Live bee
    // owners retain the bit's canonical pollen meaning.
    if (fragment.material != MAT_BEE && fragment.material != MAT_QUEEN_BEE)
        fragment.aux |= AUX_BEE_POLLEN;
}

void collectResources(inout ActorState state) {
    ivec2 center = ivec2(state.x, state.y);
    for (int y = ACTOR_TOP_OFFSET; y <= 1; ++y) {
        for (int x = -ACTOR_HALF_WIDTH - 1; x <= ACTOR_HALF_WIDTH + 1; ++x) {
            ivec2 p = center + ivec2(x, y);
            if (!actorInside(p)) continue;
            uint index = actorIndex(p);
            Cell resourceCell = cells[index];
            // AUX_BEE_POLLEN is material-specific. On storable mineral/cargo
            // cells it is reserved as persistent world-only laser provenance,
            // preventing a later normal actor tick from turning the released
            // fragment into inventory plus Empty/Vacuum.
            if (isStructural(resourceCell) ||
                (resourceCell.aux & AUX_BEE_POLLEN) != 0u ||
                !tryStoreResource(state, resourceCell.material)) continue;
            cells[index] = Cell(MAT_EMPTY, 0u, 20, 0u);
            markActorChunkDirty(p);
        }
    }
    updateUnlocks(state);
}

bool insideActorPickup(ActorState state, ivec2 p) {
    ivec2 delta = p - ivec2(state.x, state.y);
    return abs(delta.x) <= ACTOR_HALF_WIDTH + 1 &&
           delta.y >= ACTOR_TOP_OFFSET && delta.y <= 1;
}

bool releaseDamagedFragment(ActorState state, ivec2 sourcePosition,
                            Cell fragment) {
    ivec2 toolOrigin = ivec2(state.x, state.y + ACTOR_TOOL_ORIGIN_OFFSET);
    ivec2 towardTool = toolOrigin - sourcePosition;
    ivec2 impactNormal = abs(towardTool.x) >= abs(towardTool.y)
        ? ivec2(towardTool.x >= 0 ? 1 : -1, 0)
        : ivec2(0, towardTool.y >= 0 ? 1 : -1);
    ivec2 tangent = ivec2(-impactNormal.y, impactNormal.x);
    // Eject through the acquired impact face first. The old unconditional
    // upward preference stacked side/underside fragments into one column and
    // let them repair back into the damaged tile. Two-cell destinations make
    // the released unit visibly leave the face while retaining an exact
    // one-for-one swap with a real gas owner.
    ivec2 targets[8] = ivec2[8](
        sourcePosition + impactNormal * 2,
        sourcePosition + impactNormal,
        sourcePosition + impactNormal * 2 + tangent,
        sourcePosition + impactNormal * 2 - tangent,
        sourcePosition + impactNormal + tangent,
        sourcePosition + impactNormal - tangent,
        sourcePosition + tangent,
        sourcePosition - tangent);
    for (uint targetIndex = 0u; targetIndex < 8u; ++targetIndex) {
        ivec2 targetPosition = targets[targetIndex];
        if (!actorInside(targetPosition) || insideActorPickup(state, targetPosition))
            continue;
        ivec2 targetDelta = targetPosition - sourcePosition;
        ivec2 firstStep = sourcePosition + ivec2(
            targetDelta.x == 0 ? 0 : (targetDelta.x > 0 ? 1 : -1),
            targetDelta.y == 0 ? 0 : (targetDelta.y > 0 ? 1 : -1));
        if (max(abs(targetDelta.x), abs(targetDelta.y)) > 1 &&
            !stableLaserMedium(actorAt(firstStep).material)) continue;
        Cell target = actorAt(targetPosition);
        // A terminal hit is an exact world-to-world swap with canonical real
        // gas. Empty would leave visible Vacuum at the source; transient
        // weather/plasma gas is itself a physical material owner. If no stable
        // destination exists, retain the exact source.
        if (!stableLaserMedium(target.material)) continue;
        cells[actorIndex(sourcePosition)] = target;
        cells[actorIndex(targetPosition)] = fragment;
        markActorChunkDirty(sourcePosition);
        markActorChunkDirty(targetPosition);
        return true;
    }
    return false;
}

void damageCell(inout ActorState state, ivec2 p, uint damage) {
    if (!actorInside(p)) return;
    uint index = actorIndex(p);
    Cell cell = cells[index];
    if (toolTransparent(cell)) return;
    markActorChunkDirty(p);

    if (cell.material == MAT_BEETLE) {
        uint health = stateValue(cell);
        if (health <= damage) cells[index] = Cell(MAT_ALUMINUM, 0u, 20, 255u);
        else {
            setStateValue(cell, health - damage);
            cells[index] = cell;
        }
        return;
    }

    if (isStructural(cell)) {
        uint health = stateValue(cell);
        if (health == 0u) health = 255u;
        if (health <= damage) {
            Cell fragment = cell;
            fragment.aux &= ~(AUX_STRUCTURAL | AUX_SUPPORTED);
            fragment.aux |= AUX_MOVED;
            markLaserFragmentWorldOnly(fragment);
            fragment.age = 0u;
            setStateValue(fragment, 1u);
            if (releaseDamagedFragment(state, p, fragment)) {
                recordConservation(cell, fragment);
            }
            // If no body-clear gas destination accepts the unit, retain the
            // exact pre-hit structural cell. A terminal tool
            // action may not destroy or temporarily unown represented matter.
        } else {
            setStateValue(cell, health - damage);
            cell.age = 0u;
            cells[index] = cell;
        }
        return;
    }

    uint looseHealth = stateValue(cell);
    if (looseHealth == 0u) looseHealth = 48u;
    if (damage >= looseHealth) {
        Cell fragment = cell;
        fragment.age = 0u;
        fragment.aux |= AUX_MOVED;
        markLaserFragmentWorldOnly(fragment);
        setStateValue(fragment, 1u);
        releaseDamagedFragment(state, p, fragment);
        // A blocked material remains byte-identical at source.
    } else {
        setStateValue(cell, looseHealth - damage);
        cell.age = 0u;
        cells[index] = cell;
    }
}
void fireTool(inout ActorState state) {
    vec2 origin = vec2(float(state.x), float(state.y + ACTOR_TOOL_ORIGIN_OFFSET));
    vec2 target = vec2(float(actorPc.aimX), float(actorPc.aimY));
    vec2 delta = target - origin;
    float targetDistance = length(delta);
    if (targetDistance < 0.5) return;

    vec2 direction = delta / targetDistance;
    float range = (state.unlocks & 2u) != 0u ? 340.0 : 260.0;
    float maximumDistance = min(targetDistance, range);
    ivec2 hit = ivec2(origin);
    bool found = false;
    uint hitMaterial = MAT_EMPTY;
    for (int stepIndex = 1; stepIndex <= 340; ++stepIndex) {
        float distanceAlongRay = float(stepIndex);
        if (distanceAlongRay > maximumDistance) break;
        ivec2 p = ivec2(round(origin + direction * distanceAlongRay));
        if (!actorInside(p)) break;
        Cell candidate = actorAt(p);
        if (!toolTransparent(candidate)) {
            hit = p;
            hitMaterial = candidate.material;
            found = true;
            break;
        }
        hit = p;
    }

    // One reliable primary action serves both tools: terrain and machines are
    // drilled; a visible hostile under the cursor receives a plasma shot when
    // ammunition exists. Ammo never blocks ordinary mining.
    bool plasma = found && hitMaterial == MAT_BEETLE && state.ammo > 0u && (state.unlocks & 8u) != 0u;
    if (found) {
        uint damage = plasma ? 255u : (state.drillLevel >= 2u ? 192u : 144u);
        // The ray owns exactly its first stationary damageable cell. Material
        // fracture/motion, not a hidden radius burst, propagates consequences.
        damageCell(state, hit, damage);
        if (plasma) state.ammo -= 1u;
    }
    state.hitX = hit.x;
    state.hitY = hit.y;
    state.shotTimer = plasma ? 6u : 4u;
}


void depositResource(inout ActorState state) {
    ivec2 target = ivec2(actorPc.aimX, actorPc.aimY);
    if (!actorInside(target) || actorAt(target).material != MAT_EMPTY) return;

    // Do not drop directly inside the actor pickup volume. The deposited cell
    // remains in the unified world and can then fall onto a conveyor or machine.
    ivec2 delta = target - ivec2(state.x, state.y + ACTOR_TOOL_ORIGIN_OFFSET);
    if (abs(delta.x) <= ACTOR_HALF_WIDTH + 2 && delta.y >= ACTOR_TOP_OFFSET - ACTOR_TOOL_ORIGIN_OFFSET - 1 && delta.y <= -ACTOR_TOOL_ORIGIN_OFFSET + 1) return;

    // BUILD mode consumes the explicitly selected compact-inventory slot.
    uint slot = actorPc.inventorySlot % 4u;
    uint material = slot == 0u ? MAT_IRON :
                    (slot == 1u ? MAT_GOLD :
                    (slot == 2u ? MAT_COPPER : MAT_ALUMINUM));
    uint available = slot == 0u ? state.iron :
                     (slot == 1u ? state.gold :
                     (slot == 2u ? state.copper : state.aluminum));
    if (available == 0u) return;

    atomicAdd(conservation[CONS_CONVERTED], 1u);
    cells[actorIndex(target)] = makeCellWithEntropy(material, actorPc.seed, actorPc.step);
    markActorChunkDirty(target);
    if (slot == 0u) state.iron -= 1u;
    else if (slot == 1u) state.gold -= 1u;
    else if (slot == 2u) state.copper -= 1u;
    else state.aluminum -= 1u;
    state.moveCooldown = 5u;
}

void updateBreathing(inout ActorState state) {
    ivec2 center = ivec2(state.x, state.y + ACTOR_HEAD_CENTER_OFFSET);
    ivec2 oxygenCell = center;
    uint oxygenVolume = 0u;
    uint toxicVolume = 0u;
    for (int y = -4; y <= 4; ++y) {
        for (int x = -4; x <= 4; ++x) {
            ivec2 p = center + ivec2(x, y);
            Cell medium = actorAt(p);
            if (medium.material == MAT_OXYGEN || medium.material == MAT_ATMOSPHERE) {
                if (oxygenVolume == 0u) oxygenCell = p;
                oxygenVolume += max(stateValue(medium), 1u);
            } else if (isGas(medium.material) || isLiquid(medium.material)) {
                toxicVolume += max(stateValue(medium), 1u);
            }
        }
    }

    uint sealedContacts = 0u;
    const ivec2 breathOffsets[4] = ivec2[4](
        ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
    for (uint i = 0u; i < 4u; ++i) {
        uint material = actorAt(center + breathOffsets[i]).material;
        if (isLiquid(material) || (isGas(material) && material != MAT_OXYGEN && material != MAT_ATMOSPHERE)) ++sealedContacts;
    }

    bool fullyChoked = sealedContacts == 4u;
    bool breathable = oxygenVolume > 0u && !fullyChoked;
    bool toxicPocket = toxicVolume > oxygenVolume * 2u;
    if (breathable && !toxicPocket) {
        state.oxygen = min(255u, state.oxygen + 3u);
        state.exposureTicks = 0u;
        if ((actorPc.step % 180u) == 0u && actorInside(oxygenCell)) {
            uint oxygenIndex = actorIndex(oxygenCell);
            Cell before = cells[oxygenIndex];
            Cell after = before;
            if (respirePackedMedium(after)) {
                recordConservation(before, after);
                cells[oxygenIndex] = after;
                markActorChunkDirty(oxygenCell);
            }
        }
    } else {
        state.exposureTicks = min(state.exposureTicks + 1u, 4095u);
        if ((actorPc.step % 30u) == 0u && state.oxygen > 0u)
            state.oxygen -= fullyChoked || toxicPocket ? min(state.oxygen, 2u) : 1u;
        if (state.oxygen == 0u && state.exposureTicks > 120u &&
            (actorPc.step % 60u) == 0u && state.health > 0u) {
            state.health -= 1u;
        }
    }
}

bool spawnSupportedAndBreathable(ivec2 center) {
    if (!bodyClear(center) || !groundedAt(center)) return false;
    uint head = actorAt(center + ivec2(0, ACTOR_HEAD_CENTER_OFFSET)).material;
    return head == MAT_ATMOSPHERE || head == MAT_OXYGEN;
}

void recoverActorSpawn(inout ActorState state) {
    if (state.enabled == 0u) return;
    ivec2 configured = ivec2(state.x, state.y);
    if (spawnSupportedAndBreathable(configured)) return;

    // Scene edits must not silently bury or suffocate the player. Search the
    // nearby authored tile columns deterministically and keep the closest valid
    // supported Air position.
    bool found = false;
    ivec2 recovered = configured;
    for (int tileBand = 0; tileBand <= 8 && !found; ++tileBand) {
        int distanceX = tileBand * 8;
        for (int side = 0; side < (tileBand == 0 ? 1 : 2) && !found; ++side) {
            int offsetX = tileBand == 0 ? 0 : (side == 0 ? distanceX : -distanceX);
            for (int offsetY = -24; offsetY <= 96; ++offsetY) {
                ivec2 candidate = configured + ivec2(offsetX, offsetY);
                if (spawnSupportedAndBreathable(candidate)) {
                    recovered = candidate;
                    found = true;
                    break;
                }
            }
        }
    }
    state.x = recovered.x;
    state.y = recovered.y;
}
void resetActor(inout ActorState state) {
    state = ActorState(0, 0, 0, 0u, 0u, 0u, 0u, 0u, 0u, 0u,
                       255u, 255u, 0, 0, actorPc.scene, 0u, 0u, 0u, 0u, 1u);
    int authoredOriginX = int(actorPc.width) >= 640 * 3 ? 640 * 2 :
        max((int(actorPc.width) - 640) / 2, 0);
    int authoredOriginY = int(actorPc.height) >= 1080 ? 720 : 0;
    bool persistentWorld = int(actorPc.width) >= 5120 && int(actorPc.height) >= 360;
    if (persistentWorld && actorPc.scene == SCENE_SANDBOX) {
        int spare = max(int(actorPc.width) - 5120, 0);
        int gap = (spare / 7 / 8) * 8;
        int worldSurface = authoredOriginY + 40 * 8;
        int frontierOriginX = 3 * (640 + gap);
        int frontierOriginY = worldSurface - 17 * 8;
        state.x = frontierOriginX + 168;
        state.y = frontierOriginY + 207;
        state.ammo = 24u;
        state.enabled = 1u;
    } else if (actorPc.scene == SCENE_SANDBOX || actorPc.scene == SCENE_BLANK) {
        state.x = authoredOriginX + 80;
        state.y = authoredOriginY + 319;
        state.ammo = 12u;
        state.enabled = 1u;
    } else if (actorPc.scene == SCENE_VOLCANO) {
        state.x = authoredOriginX + 392;
        state.y = authoredOriginY + 175;
        state.ammo = 12u;
        state.enabled = 1u;
    } else if (actorPc.scene == SCENE_WATERWORKS) {
        state.x = authoredOriginX + 40;
        state.y = authoredOriginY + 311;
        state.ammo = 12u;
        state.enabled = 1u;
    } else if (actorPc.scene == SCENE_ECOSYSTEM) {
        state.x = authoredOriginX + 80;
        state.y = authoredOriginY + 295;
        state.ammo = 12u;
        state.enabled = 1u;
    } else if (actorPc.scene == SCENE_ENGINEERING) {
        state.x = authoredOriginX + 200;
        state.y = authoredOriginY + 335;
        state.ammo = 18u;
        state.enabled = 1u;
    } else if (actorPc.scene == SCENE_GOLD_MINE) {
        state.x = authoredOriginX + 78;
        state.y = authoredOriginY + 127;
        state.ammo = 18u;
        state.enabled = 1u;
    } else if (actorPc.scene == SCENE_DEMOLITION) {
        state.x = authoredOriginX + 80;
        state.y = authoredOriginY + 327;
        state.ammo = 12u;
        state.enabled = 1u;
    } else if (actorPc.scene == SCENE_FRONTIER_BASE) {
        state.x = authoredOriginX + 168;
        state.y = authoredOriginY + 207;
        state.ammo = 24u;
        state.enabled = 1u;
    }
    recoverActorSpawn(state);
    state.hitX = state.x;
    state.hitY = state.y + ACTOR_TOOL_ORIGIN_OFFSET;
}

void main() {
    ActorState state = actor;
    if (actorPc.reset != 0u || state.scene != actorPc.scene) resetActor(state);
    if (state.enabled == 0u || state.health == 0u) {
        actor = state;
        return;
    }

    if (actorPc.simulate != 0u &&
        !sectionActiveAt(ivec2(state.x, state.y), actorPc.activeSectionX,
                         actorPc.activeSectionY, actorPc.activeMode)) {
        actor = state;
        return;
    }

    if (actorPc.simulate != 0u) {
        if (state.shotTimer > 0u) state.shotTimer -= 1u;
        if (state.moveCooldown > 0u) state.moveCooldown -= 1u;

        ivec2 center = ivec2(state.x, state.y);
        ivec2 originalCenter = center;
        bool grounded = groundedAt(center);
        state.grounded = grounded ? 1u : 0u;

        if (actorPc.moveY < 0 && grounded) state.velocityY = (state.unlocks & 4u) != 0u ? -6 : -4;
        state.velocityY = min(state.velocityY + 1, 4);

        if (state.moveCooldown == 0u && actorPc.moveX != 0) {
            ivec2 horizontal = center + ivec2(actorPc.moveX, 0);
            if (bodyClear(horizontal)) {
                center = horizontal;
                state.moveCooldown = 2u;
            } else {
                ivec2 stepUp = center + ivec2(actorPc.moveX, -1);
                if (bodyClear(stepUp)) center = stepUp;
            }
        }

        int verticalSteps = abs(state.velocityY);
        int verticalDirection = state.velocityY < 0 ? -1 : 1;
        for (int stepIndex = 0; stepIndex < verticalSteps; ++stepIndex) {
            ivec2 next = center + ivec2(0, verticalDirection);
            if (!bodyClear(next)) {
                state.velocityY = 0;
                break;
            }
            center = next;
        }

        state.x = clamp(center.x, ACTOR_HALF_WIDTH + 1, int(actorPc.width) - ACTOR_HALF_WIDTH - 2);
        state.y = clamp(center.y, -ACTOR_TOP_OFFSET, int(actorPc.height) - 2);
        ivec2 finalCenter = ivec2(state.x, state.y);
        ivec2 actorDelta = clamp(finalCenter - originalCenter, ivec2(-1), ivec2(1));
        if (any(notEqual(actorDelta, ivec2(0)))) {
            atomicAdd(debugStats[STAT_ACTOR_MOVES], 1u);
            disturbMediumAroundActor(finalCenter, actorDelta);
        }
        collectResources(state);
        updateBreathing(state);
    }

    if (actorPc.fire != 0u && state.shotTimer == 0u) fireTool(state);
    if (actorPc.deposit != 0u && state.moveCooldown == 0u) depositResource(state);
    actor = state;
}
