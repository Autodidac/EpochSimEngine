bool beeNeedsFootprintRoute(ivec2 home) {
    return !inside(home + ivec2(-23, -24)) ||
           !inside(home + ivec2(23, 16));
}

ivec2 beeFootprintWaypoint(uint slot, uint point) {
    uvec3 route = BEE_FOOTPRINT_ROUTES[min(slot, 59u)];
    uint packed = (route[point / 2u] >> ((point & 1u) * 12u)) & 0xfffu;
    return ivec2(int(packed & 63u) - 32, int((packed >> 6u) & 63u) - 32);
}

ivec2 beeFootprintTransitTarget(ivec2 position, ivec2 home, uint slot,
                                 bool homeward, out bool exactRouteStep) {
    exactRouteStep = true;
    ivec2 local = position - home;
    // A searcher reverses the same physical path it used to leave its slot.
    // Check each segment in travel order, skipping its already reached end.
    for (int ordinal = 0; ordinal < 5; ++ordinal) {
        uint segment = uint(homeward ? ordinal : 4 - ordinal);
        ivec2 a = beeFootprintWaypoint(slot, segment);
        ivec2 b = beeFootprintWaypoint(slot, segment + 1u);
        ivec2 end = homeward ? b : a;
        if (all(equal(a, b)) || all(equal(local, end))) continue;
        if (!all(greaterThanEqual(local, min(a, b))) ||
            !all(lessThanEqual(local, max(a, b)))) continue;
        ivec2 next = position + sign(end - local);
        // The immutable snapshot rejects occupied route cells without racing
        // another mover's payload. The actual CAS still owns the one-cell
        // transaction; a blocked/replaced owner waits rather than sidestepping.
        if (!inside(next) ||
            !sectionActiveAt(next, pc.activeSectionX, pc.activeSectionY, pc.activeMode) ||
            !beeMovePassable(nextCells[indexOf(next)])) return position;
        return next;
    }
    // Exact endpoint, or an externally displaced Bee no longer on this route:
    // remain a live owner rather than teleporting or overwriting a neighbor.
    return position;
}

ivec2 beeNewbornTransitTarget(ivec2 position, ivec2 home, uint slot,
                                out bool exactRouteStep) {
    exactRouteStep = false;
    ivec2 local = position - home;
    ivec2 settled = beeFormationOffset(slot);
    if (beeNeedsFootprintRoute(home)) {
        // The photographed tunnel reaches x=10, beyond the radius<88 shell.
        // Center before its mouth so a y=+/-1 owner enters the route at(11,0),
        // not off-path at(11,+/-1). Footprint paths never re-enter this tunnel.
        bool inExitTunnel = local.x >= 1 && local.x <= 10 && abs(local.y) <= 1;
        if (inExitTunnel && local.y != 0)
            return home + ivec2(local.x, 0);
        if (local.x * local.x + local.y * local.y < 88 || inExitTunnel)
            return home + ivec2(11, 0);
        return beeFootprintTransitTarget(position, home, slot, true, exactRouteStep);
    }

    // Leave through the historical right-hand tunnel, then stay outside both
    // the body and the occupied three-lobe symbol. Upper-lobe births approach
    // along the clear row above the top edge at y=-24; lower-lobe births
    // approach from y=16.
    // This prevents a new
    // owner from endlessly pressing into the already occupied inner ring.
    if (local.x <= 10 && abs(local.y) <= 10) return home + ivec2(11, 0);
    // x=23 is outside the r^2<88 body and the max-x=20 formation, while also
    // avoiding an aligned 8-cell ownership boundary for the canonical hives.
    // Crossing that boundary at x=24 let hierarchy metadata strand a newborn
    // even though every adjacent canonical cell was Atmosphere.
    const int outsideLaneX = 23;
    if (local.x < outsideLaneX && local.y == 0)
        return home + ivec2(outsideLaneX, 0);
    int approachY = settled.y < 0 ? -24 : 16;
    if (local.x == outsideLaneX && local.y != approachY)
        return home + ivec2(outsideLaneX, approachY);
    if (local.y == approachY && local.x != settled.x)
        return home + ivec2(settled.x, approachY);
    if (local.x == settled.x)
        return home + settled;
    // Recover a displaced newborn to the clear outside lane before resuming
    // the deterministic staged route.
    if (local.x != outsideLaneX)
        return home + ivec2(outsideLaneX, local.y);
    return home + settled;
}

ivec2 beeForagerDepartureTarget(ivec2 home, uint slot) {
    ivec2 formation = beeFormationOffset(slot);
    // Each of the three photographed crescents opens away from the hive body.
    // Hold a newly assigned forager on that lobe's first clear outside lane for
    // a bounded 64-tick stage before normal flower seeking. This keeps the
    // exact resting symbol unchanged while preventing a greedy target step
    // from oscillating against the next frozen owner in a dense crescent.
    if (formation.y < 0) return home + ivec2(formation.x, -24);
    return home + ivec2(formation.x < 0 ? -23 : 23, formation.y);
}

ivec2 beeMoveDestination(ivec2 position, Cell bee, out bool exactRouteStep) {
    exactRouteStep = false;
    uint slot = beeFormationSlotFromAux(bee.aux, pc.width, pc.height);
    ivec2 home = beeMoveExactHome(bee);
    uint targetTile = beeTargetTileFromAge(bee.age);
    if ((bee.aux & BEE_AUX_QUEEN) != 0u) {
        if (!beeMoveTargetValid(targetTile, TILE_HAS_FLOWER)) return home;
        return beeMigrationSite(
            tileFlowerPosition(targetTile, pc.width, beeMoveTileFeatures(targetTile)),
            pc.width, pc.height);
    }
    if ((bee.aux & BEE_AUX_MIGRATING) != 0u) {
        if (!beeMoveTargetValid(targetTile, TILE_HAS_MIGRATING_QUEEN) &&
            !beeMoveTargetValid(targetTile, TILE_HAS_QUEEN)) return home;
        ivec2 queen = tileQueenPosition(targetTile, pc.width, beeMoveTileFeatures(targetTile));
        return queen + beeRotateOffset(beeFormationOffset(slot) / 2, pc.step / 8u);
    }
    // Only an explicitly marked replacement is routed through the photographed
    // right-hand x=1..10, |y|<=1 exit. Position alone cannot identify a birth:
    // six valid lower-lobe slots are deliberately close to the hive body.
    if (targetTile == BEE_TARGET_NEWBORN)
        return beeNewbornTransitTarget(position, home, slot, exactRouteStep);
    if ((bee.aux & BEE_AUX_POLLEN) != 0u)
        return home + beeLandingOffset(slot);
    if ((bee.aux & BEE_AUX_FED) == 0u) {
        if (!beeMoveTargetValid(targetTile, TILE_HAS_HONEY))
            return home + beeLandingOffset(slot);
        ivec2 honey = tileHoneyPosition(targetTile, pc.width, beeMoveTileFeatures(targetTile));
        return beeApproachPosition(honey, home);
    }
    if (targetTile == BEE_TARGET_SEARCH) {
        uint timer = beeTimerFromAge(bee.age);
        if (beeNeedsFootprintRoute(home))
            return beeFootprintTransitTarget(position, home, slot, timer >= 192u,
                                              exactRouteStep);
        // The slot17 return formerly approached diagonally from(-5,-21) and
        // oscillated against the frozen upper crescent. Align with its clear
        // x=0 outside lane before entering; other proven interior routes stay
        // unchanged.
        if (timer >= 192u && slot == 17u &&
            position.x != home.x + beeFormationOffset(slot).x)
            return beeForagerDepartureTarget(home, slot);
        if (timer >= 192u) return home + beeFormationOffset(slot);
        ivec2 outside = beeForagerDepartureTarget(home, slot);
        if (timer < 64u) return outside;
        ivec2 offset = beeFormationOffset(slot);
        ivec2 outward = offset.y < 0 ? ivec2(0, -1) :
            ivec2(offset.x < 0 ? -1 : 1, 0);
        ivec2 tangent = ivec2(-outward.y, outward.x);
        return outside + outward * 12 + tangent * (timer < 128u ? 5 : -5);
    }
    if (targetTile != BEE_TARGET_NONE) {
        if (!beeMoveTargetValid(targetTile, TILE_HAS_FLOWER))
            return home + beeBiohazardTargetOffset(slot, pc.step);
        if (beeForagerSlot(slot) && beeTimerFromAge(bee.age) <= 64u) {
            if (beeNeedsFootprintRoute(home))
                return beeFootprintTransitTarget(position, home, slot, false, exactRouteStep);
            return beeForagerDepartureTarget(home, slot);
        }
        ivec2 flower = tileFlowerPosition(targetTile, pc.width, beeMoveTileFeatures(targetTile));
        ivec2 approach = beeForagerApproachPosition(flower, slot);
        return beeNeedsFootprintRoute(home)
            ? clamp(approach, ivec2(0), ivec2(pc.width, pc.height) - ivec2(1))
            : approach;
    }
    return home + beeBiohazardTargetOffset(slot, pc.step);
}

bool beeMovePassable(Cell target) {
    return target.material == MAT_EMPTY ||
           (isCellGas(target) && target.material != MAT_CLOUD);
}

bool beeBirthInsideDispatch(ivec2 position) {
    // Birth-only push fields carry the exact copied/committed rectangle.
    // The normal movement pass does not use these brush fields.
    ivec2 local = position - ivec2(pc.brushX, pc.brushY);
    return inside(position) && all(greaterThanEqual(local, ivec2(0))) &&
        uint(local.x) < pc.radius && uint(local.y) < pc.reserved &&
        sectionActiveAt(position, pc.activeSectionX,
                        pc.activeSectionY, pc.activeMode);
}

void markBeeMoveDirty(ivec2 position) {
    // This is candidate membership, not an increment of the cached count.
    // Stale positives are harmless: population validates canonical owners.
    // Only classification may clear the bit after inspecting the full tile.
    // Birth reads the immutable tile snapshot; its newly occupied chamber is
    // already conservatively nominated by HAS_HIVE/HAS_QUEEN until reclassified.
    if (pc.material == BEE_PASS_MOVE)
        atomicOr(tiles[tileIndex(position, pc.width)].flags, TILE_HAS_BEES);
    atomicOr(chunks[chunkIndex(position, pc.width)].flags,
             CHUNK_DIRTY | CHUNK_ACTIVE | CHUNK_FINE_ACTIVE);
}

bool beeMoveAcceptedBirth(ivec2 queenPosition,
                          out uint missingSlot,
                          out uint birthOwner) {
    missingSlot = BEE_FORMATION_COUNT;
    birthOwner = 0xffffffffu;
    if ((pc.step & 4095u) != 0u) return false;
    uint stationaryBees = beeMoveStationaryPopulation(queenPosition, missingSlot);
    // Healthy full formations cannot need a replacement. Avoid the resident
    // candidate scan entirely for this overwhelmingly common opportunity.
    if (stationaryBees >= BEE_COLONY_MAX || missingSlot >= BEE_FORMATION_COUNT) return false;
    uint districtBees = beeMoveDistrictPopulation(queenPosition);
    if (districtBees >= BEE_COLONY_MAX || stationaryBees != districtBees ||
        missingSlot >= BEE_FORMATION_COUNT) return false;

    ivec2 missingPosition = queenPosition + beeFormationOffset(missingSlot);
    if (!beeBirthInsideDispatch(missingPosition) ||
        beeMoveSourceAt(missingPosition).material != MAT_ASH) return false;

    birthOwner = beeMoveBirthOwner(queenPosition);
    if (birthOwner == 0xffffffffu) return false;
    ivec2 birthPosition = ivec2(int(birthOwner % pc.width),
                               int(birthOwner / pc.width));
    return beeBirthInsideDispatch(birthPosition) &&
        beeMoveBirthMedium(cells[birthOwner]);
}

bool beeMoveAshFormationOwner(ivec2 position,
                              out ivec2 queenPosition,
                              out uint formationSlot) {
    for (uint slot = 0u; slot < BEE_FORMATION_COUNT; ++slot) {
        ivec2 candidateQueen = position - beeFormationOffset(slot);
        if (inside(candidateQueen) &&
            beeMoveSourceAt(candidateQueen).material == MAT_QUEEN_BEE) {
            queenPosition = candidateQueen;
            formationSlot = slot;
            return true;
        }
    }
    queenPosition = ivec2(0);
    formationSlot = BEE_FORMATION_COUNT;
    return false;
}

void runBeeBirth(ivec2 position, Cell source) {
    if ((pc.step & 4095u) != 0u) return;

    ivec2 queenPosition = ivec2(0);
    uint missingSlot = BEE_FORMATION_COUNT;
    uint birthOwner = 0xffffffffu;
    if (beeMoveBirthMedium(source)) {
        if (!beeMoveNearNestTile(position)) return;
        bool queenFound = false;
        queenPosition = beeMoveNearestQueen(position, queenFound);
        if (!queenFound ||
            !beeMoveAcceptedBirth(queenPosition, missingSlot, birthOwner) ||
            indexOf(position) != birthOwner) return;

        Cell newborn = makeCell(MAT_BEE);
        newborn.aux |= BEE_AUX_SWARM | BEE_AUX_FED;
        newborn.aux &= ~(BEE_AUX_QUEEN | BEE_AUX_POLLEN |
                         BEE_AUX_MIGRATING);
        newborn.aux = beePackMetadata(newborn.aux, queenPosition, missingSlot,
                                      pc.width, pc.height);
        newborn.age = beePackAge(beeNewbornHomeTimer(queenPosition, newborn.aux),
                                 BEE_TARGET_NEWBORN);
        nextCells[indexOf(position)] = newborn;
        markBeeMoveDirty(position);
        return;
    }

    // A missing outer-crescent slot can be several tiles from its queen.
    // The chamber-only near-nest shortcut must not suppress the elected Ash
    // endpoint while the medium endpoint commits. Only Ash performs this
    // bounded exact formation-owner lookup; normal bee movement is unchanged.
    uint formationSlot = BEE_FORMATION_COUNT;
    if (source.material != MAT_ASH ||
        !beeMoveAshFormationOwner(position, queenPosition, formationSlot) ||
        !beeMoveAcceptedBirth(queenPosition, missingSlot, birthOwner) ||
        formationSlot != missingSlot) return;

    // CurrentCells is immutable throughout this rare bounded phase. The birth
    // medium and missing-slot Ash invocations independently own their matching
    // NextCells outputs, forming one deterministic two-cell transaction without
    // same-dispatch cross-cell writes.
    nextCells[indexOf(position)] = cells[birthOwner];
    markBeeMoveDirty(position);
}

bool tryBeeMove(ivec2 sourcePosition, Cell bee, ivec2 offset) {
    if (all(equal(offset, ivec2(0)))) return false;
    ivec2 targetPosition = sourcePosition + offset;
    if (!inside(targetPosition) ||
        !sectionActiveAt(targetPosition, pc.activeSectionX,
                         pc.activeSectionY, pc.activeMode)) return false;

    uint sourceIndex = indexOf(sourcePosition);
    uint targetIndex = indexOf(targetPosition);
    Cell target = cells[targetIndex];
    if (!beeMovePassable(target)) return false;
    if (atomicCompSwap(cells[targetIndex].material,
                       target.material, MAT_BEE) != target.material) return false;

    bee.aux &= ~AUX_MOVED;
    cells[targetIndex].age = bee.age;
    cells[targetIndex].temperature = bee.temperature;
    cells[targetIndex].aux = bee.aux;
    cells[sourceIndex] = target;
    markBeeMoveDirty(sourcePosition);
    markBeeMoveDirty(targetPosition);
    atomicAdd(debugStats[STAT_BEE_MOVES], 1u);
    return true;
}

void main() {
    bool birthPass = pc.material == BEE_PASS_BIRTH;
    ivec2 dispatchOrigin = birthPass ? ivec2(pc.brushX, pc.brushY) :
        activeDispatchCellOrigin(pc.activeSectionX, pc.activeSectionY, pc.activeMode);
    ivec2 position = ivec2(gl_GlobalInvocationID.xy) + dispatchOrigin;
    if (!inside(position) ||
        !sectionActiveAt(position, pc.activeSectionX,
                         pc.activeSectionY, pc.activeMode)) return;
    if (birthPass && !beeBirthInsideDispatch(position)) return;

    uint index = indexOf(position);
    Cell bee = cells[index];
    if (birthPass) {
        runBeeBirth(position, bee);
        return;
    }
    if (pc.material != BEE_PASS_MOVE) return;
    if (bee.material != MAT_BEE || (bee.aux & BEE_AUX_SWARM) == 0u ||
        (bee.aux & AUX_MOVED) == 0u) return;

    // NextCells is the immutable beginning-of-movement snapshot. Requiring the
    // same persistent owner rejects an invocation whose target was published as
    // MAT_BEE by an earlier in-place move in this dispatch, even if that target
    // invocation raced the remaining payload writes.
    Cell snapshotBee = nextCells[index];
    if (snapshotBee.material != MAT_BEE ||
        (snapshotBee.aux & BEE_AUX_SWARM) == 0u ||
        (snapshotBee.aux & BEE_METADATA_MASK) !=
            (bee.aux & BEE_METADATA_MASK)) return;
    uint claimedAux = atomicAnd(cells[index].aux, ~AUX_MOVED);
    if ((claimedAux & AUX_MOVED) == 0u) return;
    bee.aux = claimedAux & ~AUX_MOVED;

    uint slot = beeFormationSlotFromAux(bee.aux, pc.width, pc.height);
    bool newbornTransit = beeTargetTileFromAge(bee.age) == BEE_TARGET_NEWBORN;
    // A replacement owns a single bounded route and cannot contend with any
    // other replacement while the strict cap is below 60. Advance that route
    // every fixed tick; established owners retain the staggered quarter-rate
    // cadence that keeps the resting symbol and ordinary foraging lightweight.
    if (!newbornTransit && ((slot + pc.step) & 3u) != 0u) {
        atomicAnd(cells[index].aux, ~AUX_MOVED);
        return;
    }

    bool exactRouteStep = false;
    ivec2 destination = beeMoveDestination(position, bee, exactRouteStep);
    ivec2 delta = destination - position;
    if (all(equal(delta, ivec2(0)))) {
        atomicAnd(cells[index].aux, ~AUX_MOVED);
        return;
    }

    ivec2 horizontal = ivec2(delta.x > 0 ? 1 : (delta.x < 0 ? -1 : 0), 0);
    ivec2 vertical = ivec2(0, delta.y > 0 ? 1 : (delta.y < 0 ? -1 : 0));
    bool horizontalFirst = abs(delta.x) >= abs(delta.y);
    if (tryBeeMove(position, bee, horizontalFirst ? horizontal : vertical)) return;
    if (exactRouteStep) return;
    if (tryBeeMove(position, bee, horizontalFirst ? vertical : horizontal)) return;

    bool clockwise = ((slot * 17u + 3u) & 1u) == 0u;
    ivec2 sidestep = clockwise
        ? ivec2(delta.y > 0 ? -1 : 1, delta.x > 0 ? 1 : -1)
        : ivec2(delta.y > 0 ? 1 : -1, delta.x > 0 ? -1 : 1);
    if (tryBeeMove(position, bee, ivec2(sidestep.x, 0))) return;
    if (tryBeeMove(position, bee, ivec2(0, sidestep.y))) return;
    atomicAnd(cells[index].aux, ~AUX_MOVED);
}
