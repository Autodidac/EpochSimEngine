#version 450
#extension GL_GOOGLE_include_directive : require
#include "materials.glsl"
#include "tiles.glsl"
#include "chunks.glsl"
#include "bee_swarm.glsl"
#include "debug_stats.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) buffer CurrentCells { Cell cells[]; };
layout(std430, binding = 1) buffer NextCells { Cell nextCells[]; };
layout(std430, binding = 4) buffer Tiles { TileState tiles[]; };
layout(std430, binding = 5) buffer DebugStatsBuffer { uint debugStats[]; };
layout(std430, binding = 7) buffer Chunks { ChunkState chunks[]; };

const uint BEE_PASS_MOVE = 0u;
const uint BEE_PASS_BIRTH = 1u;

Cell beeMoveSourceAt(ivec2 position) {
    return inside(position) ? cells[indexOf(position)] : makeCell(MAT_STONE);
}

bool beeMoveHasNeighbor(ivec2 position, uint material) {
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            if ((dx != 0 || dy != 0) &&
                beeMoveSourceAt(position + ivec2(dx, dy)).material == material)
                return true;
        }
    }
    return false;
}

uint beeMoveCountWithin(ivec2 position, uint material, int radius) {
    uint count = 0u;
    for (int dy = -radius; dy <= radius; ++dy) {
        for (int dx = -radius; dx <= radius; ++dx) {
            if (dx * dx + dy * dy <= radius * radius &&
                beeMoveSourceAt(position + ivec2(dx, dy)).material == material)
                ++count;
        }
    }
    return count;
}

ivec2 beeMoveNearestQueen(ivec2 position, out bool found) {
    ivec2 nearest = position;
    int bestDistance = 0x3fffffff;
    uint bestIndex = 0xffffffffu;
    found = false;
    for (int dy = -5; dy <= 5; ++dy) {
        for (int dx = -5; dx <= 5; ++dx) {
            ivec2 candidate = position + ivec2(dx, dy);
            if (!inside(candidate) ||
                beeMoveSourceAt(candidate).material != MAT_QUEEN_BEE) continue;
            int distance = dx * dx + dy * dy;
            uint candidateIndex = indexOf(candidate);
            if (distance < bestDistance ||
                (distance == bestDistance && candidateIndex < bestIndex)) {
                found = true;
                nearest = candidate;
                bestDistance = distance;
                bestIndex = candidateIndex;
            }
        }
    }
    return nearest;
}

ivec2 beeMoveDistrictOrigin(ivec2 homeCenter) {
    if (beeUsesPersistentWorldHome(pc.width, pc.height)) {
        uint district = 0u;
        ivec2 districtLocal = ivec2(0);
        if (beePersistentAddress(homeCenter, pc.width, pc.height,
                                 district, districtLocal))
            return beePersistentDistrictOrigin(pc.width, pc.height, district);
    }
    return beeAuthoredWorldOrigin(pc.width, pc.height);
}

uint beeMoveDistrictPopulation(ivec2 homeCenter) {
    // Replacement is capped per home, never per district. On the rare birth
    // opportunity, skip empty tile summaries and inspect only Bee-bearing
    // canonical tiles, including foragers beyond the active camera window.
    uint columns = tileColumns(pc.width);
    uint count = 0u;
    uint tileCount = columns * ((pc.height + TILE_SIZE - 1u) / TILE_SIZE);
    for (uint tile = 0u; tile < tileCount; ++tile) {
        // Counts are a previous classification snapshot. Movement publishes a
        // conservative candidate bit at both endpoints, so a newly occupied
        // off-camera tile is never skipped before its next classification.
        if (tileBeeCount(tiles[tile]) == 0u &&
            !tileHas(tiles[tile], TILE_HAS_BEES | TILE_HAS_HIVE | TILE_HAS_QUEEN)) continue;
        ivec2 origin = brickOriginFromIndex(tile, pc.width);
        for (int y = 0; y < int(TILE_SIZE); ++y)
            for (int x = 0; x < int(TILE_SIZE); ++x) {
                ivec2 p = origin + ivec2(x, y);
                if (!inside(p)) continue;
                Cell bee = beeMoveSourceAt(p);
                if (bee.material == MAT_BEE && (bee.aux & BEE_AUX_SWARM) != 0u &&
                    beeOwnsHome(bee.aux, homeCenter, pc.width, pc.height)) ++count;
            }
    }
    return count;
}

uint beeMoveStationaryPopulation(ivec2 homeCenter, out uint firstMissingSlot) {
    uint count = 0u;
    firstMissingSlot = BEE_FORMATION_COUNT;
    for (uint slot = 0u; slot < BEE_FORMATION_COUNT; ++slot) {
        Cell bee = beeMoveSourceAt(homeCenter + beeFormationOffset(slot));
        ivec2 storedHome = beeHomeCenterFromAux(bee.aux, pc.width, pc.height);
        bool exact = bee.material == MAT_BEE &&
            (bee.aux & BEE_AUX_SWARM) != 0u &&
            beeFormationSlotFromAux(bee.aux, pc.width, pc.height) == slot &&
            beeOwnsHome(bee.aux, homeCenter, pc.width, pc.height);
        if (exact) ++count;
        else if (firstMissingSlot == BEE_FORMATION_COUNT)
            firstMissingSlot = slot;
    }
    return count;
}

bool beeMoveBirthMedium(Cell cell) {
    return cell.material == MAT_EMPTY || cell.material == MAT_ATMOSPHERE;
}

bool beeMoveNearNestTile(ivec2 position) {
    ivec2 center = position / int(TILE_SIZE);
    ivec2 limits = ivec2(int(tileColumns(pc.width)) - 1,
                         int((pc.height + TILE_SIZE - 1u) / TILE_SIZE) - 1);
    for (int tileY = -1; tileY <= 1; ++tileY) {
        for (int tileX = -1; tileX <= 1; ++tileX) {
            ivec2 candidate = center + ivec2(tileX, tileY);
            if (any(lessThan(candidate, ivec2(0))) ||
                any(greaterThan(candidate, limits))) continue;
            uint flags = tiles[uint(candidate.y) * tileColumns(pc.width) +
                               uint(candidate.x)].flags;
            if ((flags & (TILE_HAS_HIVE | TILE_HAS_QUEEN)) != 0u) return true;
        }
    }
    return false;
}

bool beeMoveBirthCandidate(ivec2 position, ivec2 queenPosition) {
    Cell medium = beeMoveSourceAt(position);
    if (!beeMoveBirthMedium(medium)) return false;
    bool queenFound = false;
    ivec2 nearestQueen = beeMoveNearestQueen(position, queenFound);
    ivec2 queenOffset = queenPosition - position;
    int queenDistance = queenOffset.x * queenOffset.x +
        queenOffset.y * queenOffset.y;
    bool nestFrontier = beeMoveHasNeighbor(position, MAT_QUEEN_BEE) ||
        beeMoveHasNeighbor(position, MAT_BEEHIVE);
    bool foodFrontier = beeMoveHasNeighbor(position, MAT_HONEY) ||
        beeMoveHasNeighbor(position, MAT_POLLEN);
    return queenFound && all(equal(nearestQueen, queenPosition)) &&
        queenDistance > 0 && queenDistance <= 6 && nestFrontier &&
        foodFrontier && beeMoveCountWithin(position, MAT_BEE, 6) < 4u;
}

uint beeMoveBirthOwner(ivec2 queenPosition) {
    uint owner = 0xffffffffu;
    for (int dy = -3; dy <= 3; ++dy) {
        for (int dx = -3; dx <= 3; ++dx) {
            ivec2 candidate = queenPosition + ivec2(dx, dy);
            if (inside(candidate) && beeMoveBirthCandidate(candidate, queenPosition))
                owner = min(owner, indexOf(candidate));
        }
    }
    return owner;
}

uint beeMoveTileCount() {
    return tileColumns(pc.width) * ((pc.height + TILE_SIZE - 1u) / TILE_SIZE);
}

bool beeMoveTargetValid(uint index, uint requiredFlags) {
    // Other movement invocations may publish only the conservative Bee bit.
    // Read the shared flag word atomically even when testing a different bit.
    return index < beeMoveTileCount() &&
        (atomicOr(tiles[index].flags, 0u) & requiredFlags) != 0u;
}

TileState beeMoveTileFeatures(uint index) {
    // Feature positions live solely in occupancy, which this pass never writes.
    // Avoid a whole-struct load racing another mover's atomic flag publication.
    return TileState(0u, tiles[index].occupancy, 0u, 0u);
}

ivec2 beeMoveExactHome(Cell bee) {
    ivec2 approximate = beeHomeCenterFromAux(bee.aux, pc.width, pc.height);
    if (beeTargetTileFromAge(bee.age) == BEE_TARGET_NEWBORN)
        return beeNewbornExactHome(bee.age, approximate);
    ivec2 exact = approximate;
    int bestDistance = 0x3fffffff;
    int extent = beeHomeSearchExtent(bee.aux, pc.width, pc.height);
    for (int dy = -2; dy <= extent; ++dy) {
        for (int dx = -2; dx <= extent; ++dx) {
            ivec2 candidate = approximate + ivec2(dx, dy);
            if (!inside(candidate) ||
                cells[indexOf(candidate)].material != MAT_QUEEN_BEE) continue;
            int distance = dx * dx + dy * dy;
            if (distance < bestDistance) {
                exact = candidate;
                bestDistance = distance;
            }
        }
    }
    return exact;
}

bool beeMovePassable(Cell target);

