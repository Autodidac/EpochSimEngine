#version 450
#extension GL_GOOGLE_include_directive : require
#include "materials.glsl"
#include "bee_swarm.glsl"
#include "beehive.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) buffer CurrentCells { Cell cells[]; };

const uint SCENE_SANDBOX = 0u;
const uint SCENE_BLANK = 1u;
const uint SCENE_VOLCANO = 2u;
const uint SCENE_WATERWORKS = 3u;
const uint SCENE_ECOSYSTEM = 4u;
const uint SCENE_ENGINEERING = 5u;
const uint SCENE_GOLD_MINE = 6u;
const uint SCENE_DEMOLITION = 7u;
const uint SCENE_FRONTIER_BASE = 8u;
const uint SCENE_COUNT = 9u;
const int BRICK_SIZE = 8;
const ivec2 AUTHORED_WORLD_CELLS = ivec2(640, 360);

ivec2 authoredWorldOrigin() {
    int x = max((int(pc.width) - AUTHORED_WORLD_CELLS.x) / 2, 0);
    int skyHeight = int(pc.height) >= AUTHORED_WORLD_CELLS.y * 3
        ? AUTHORED_WORLD_CELLS.y * 2
        : 0;
    return ivec2(x, skyHeight);
}

ivec2 authoredLocalCoordinate(ivec2 worldPosition) {
    return worldPosition - authoredWorldOrigin();
}

bool insideAuthoredLocal(ivec2 local) {
    return local.x >= 0 && local.y >= 0 &&
           local.x < min(int(pc.width), AUTHORED_WORLD_CELLS.x) &&
           local.y < min(int(pc.height), AUTHORED_WORLD_CELLS.y);
}

bool insideAuthoredWorld(ivec2 worldPosition) {
    return insideAuthoredLocal(authoredLocalCoordinate(worldPosition));
}

ivec2 brickCoordinate(ivec2 p) { return p / BRICK_SIZE; }
ivec2 brickOrigin(ivec2 brick) { return brick * BRICK_SIZE; }
ivec2 brickCenter(ivec2 brick) { return brickOrigin(brick) + ivec2(BRICK_SIZE / 2); }
ivec2 worldBrickSize() {
    ivec2 authored = min(ivec2(int(pc.width), int(pc.height)), AUTHORED_WORLD_CELLS);
    return (authored + ivec2(BRICK_SIZE - 1)) / BRICK_SIZE;
}

uint sceneBoundaryMaterial(uint scene) {
    if (scene == SCENE_ENGINEERING) return MAT_INSULATOR;
    if (scene == SCENE_GOLD_MINE || scene == SCENE_DEMOLITION) return MAT_STEEL;
    return MAT_STONE;
}

uint residentGroundHash(ivec2 position) {
    uint value = uint(position.x) * 0x9e3779b9u ^
       uint(position.y) * 0x85ebca6bu ^ 0xc2b2ae35u;
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

bool residentGroundHostMaterial(uint material) {
    return material == MAT_SAND || material == MAT_DIRT ||
 material == MAT_SILT || material == MAT_MUD ||
 material == MAT_STONE;
}

int residentGroundBoundaryOffset(int x, uint salt, int amplitude) {
    uint coarse = residentGroundHash(ivec2(x / 24, int(salt))) % uint(amplitude * 2 + 1);
    uint fine = residentGroundHash(ivec2(x / 7, int(salt ^ 0x51f2a3b7u))) % 7u;
    return int(coarse) - amplitude + int(fine) - 3;
}

bool residentGroundRoughEdgeCell(ivec2 position, uint salt) {
    return (residentGroundHash(ivec2(position.x / 3, position.y / 3 + int(salt))) & 15u) == 0u;
}

uint residentGroundDepositMaterial(uint baseMaterial, ivec2 position, int depth) {
    if (!residentGroundHostMaterial(baseMaterial)) return baseMaterial;
    const ivec2 clusterSize = ivec2(32, 24);
    ivec2 cluster = position / clusterSize;
    uint seed = residentGroundHash(cluster);
    uint roll = seed & 2047u;

    uint deposit = MAT_EMPTY;
    if (depth >= 160 && roll < 8u) deposit = MAT_URANIUM;
    else if (roll < 24u) deposit = MAT_ALUMINUM;
    else if (roll < 52u) deposit = MAT_COPPER;
    else if (roll < 132u) deposit = MAT_IRON_ORE;
    if (deposit == MAT_EMPTY) return baseMaterial;

    ivec2 local = position % clusterSize;
    ivec2 center = ivec2(10 + int((seed >> 11u) % 13u),
                         7 + int((seed >> 16u) % 9u));
    ivec2 radius = ivec2(8 + int((seed >> 21u) % 6u),
                         5 + int((seed >> 25u) % 4u));
    ivec2 delta = local - center;
    int roughness = int(residentGroundHash(position / 4) & 31u) - 15;
    int lhs = delta.x * delta.x * radius.y * radius.y +
              delta.y * delta.y * radius.x * radius.x;
    int rhs = radius.x * radius.x * radius.y * radius.y + roughness * radius.x;
    return lhs <= rhs ? deposit : baseMaterial;
}

// Every scene occupies the crystal-marker camera footprint: the third
// 640x360 resident row. The two complete rows above it remain empty sky. A
// one-brick foundation separates the scene from the remaining lower geology;
// a two-brick lava band spans the bottom inside stone cap, shell, and side walls.
uint residentWorldSubstrateMaterial(ivec2 worldPosition) {
    int width = int(pc.width);
    int height = int(pc.height);
    int sceneTop = authoredWorldOrigin().y;
    int sceneBottom = min(height, sceneTop + AUTHORED_WORLD_CELLS.y);
    int horizontalShell = min(width, BRICK_SIZE);
    bool sideShell = worldPosition.x < horizontalShell ||
                     worldPosition.x >= width - horizontalShell;
    if (worldPosition.y < sceneTop) return MAT_EMPTY;

    int foundation = min(sceneBottom - sceneTop, BRICK_SIZE);
    int foundationStart = sceneBottom - foundation;
    if (worldPosition.y < sceneBottom) {
        if (worldPosition.y >= foundationStart || sideShell) return MAT_STONE;
        return MAT_EMPTY;
    }
    if (sideShell) return MAT_STONE;

    int bottomShell = min(height, BRICK_SIZE);
    int bottomShellStart = height - bottomShell;
    if (worldPosition.y >= bottomShellStart) return MAT_STONE;
    int lavaRoom = max(bottomShellStart - sceneBottom, 0);
    int lavaThickness = min(lavaRoom, BRICK_SIZE * 2);
    int lavaStart = bottomShellStart - lavaThickness;
    if (worldPosition.y >= lavaStart) return MAT_LAVA;
    int capRoom = max(lavaStart - sceneBottom, 0);
    int capThickness = min(capRoom, BRICK_SIZE);
    int lavaCapStart = lavaStart - capThickness;
    if (worldPosition.y >= lavaCapStart) return MAT_STONE;

    int depth = worldPosition.y - sceneBottom;
    int zone = min(depth / AUTHORED_WORLD_CELLS.y, 2);
    int localY = depth % AUTHORED_WORLD_CELLS.y;
    int boundaryA = 106 + residentGroundBoundaryOffset(worldPosition.x, uint(zone * 17 + 3), 18);
    int boundaryB = 232 + residentGroundBoundaryOffset(worldPosition.x, uint(zone * 19 + 7), 24);
    int boundaryC = 304 + residentGroundBoundaryOffset(worldPosition.x, uint(zone * 23 + 11), 16);

    uint geology = MAT_STONE;
    if (zone == 0) geology = localY < boundaryA ? MAT_DIRT : (localY < boundaryB ? MAT_SAND : MAT_SILT);
    else if (zone == 1) geology = localY < boundaryA ? MAT_SAND : (localY < boundaryB ? MAT_SILT : MAT_DIRT);
    else geology = localY < boundaryA ? MAT_SILT : (localY < boundaryB ? MAT_DIRT : MAT_STONE);

    int nearest = min(abs(localY - boundaryA), min(abs(localY - boundaryB), abs(localY - boundaryC)));
    if (nearest <= 7 && residentGroundRoughEdgeCell(worldPosition, uint(zone * 31 + 13))) {
        if (geology == MAT_DIRT) geology = MAT_SAND;
        else if (geology == MAT_SAND) geology = MAT_SILT;
        else if (geology == MAT_SILT) geology = MAT_DIRT;
    }

    uint mudSeed = residentGroundHash(ivec2(worldPosition.x / 24, worldPosition.y / 18 + zone * 97));
    ivec2 mudLocal = ivec2(worldPosition.x % 24 - 12, worldPosition.y % 18 - 9);
    if ((mudSeed & 31u) == 0u &&
        mudLocal.x * mudLocal.x * 9 + mudLocal.y * mudLocal.y * 16 < 900) {
        geology = MAT_MUD;
    }
    return residentGroundDepositMaterial(geology, worldPosition, depth);
}

bool residentSubstrateStructural(uint material) {
    return material == MAT_STONE || material == MAT_DIRT ||
           material == MAT_SAND || material == MAT_SILT;
}

bool brickRect(ivec2 p, ivec2 minimumBrick, ivec2 maximumBrick) {
    ivec2 brick = brickCoordinate(p);
    return all(greaterThanEqual(brick, minimumBrick)) && all(lessThan(brick, maximumBrick));
}

bool brickFrame(ivec2 p, ivec2 minimumBrick, ivec2 maximumBrick, int thickness) {
    ivec2 brick = brickCoordinate(p);
    if (!all(greaterThanEqual(brick, minimumBrick)) || !all(lessThan(brick, maximumBrick))) return false;
    return brick.x < minimumBrick.x + thickness || brick.x >= maximumBrick.x - thickness ||
           brick.y < minimumBrick.y + thickness || brick.y >= maximumBrick.y - thickness;
}

bool brickStair(ivec2 p, ivec2 startBrick, int count, bool risingRight) {
    ivec2 brick = brickCoordinate(p);
    int localX = brick.x - startBrick.x;
    if (localX < 0 || localX >= count) return false;
    int stairY = risingRight ? startBrick.y - localX : startBrick.y + localX;
    return brick.y == stairY;
}

ivec2 sandboxQueen() { return brickCenter(ivec2(58, 24)); }

// Canonical Fix28 compact Beehive shared by generated scenes and the tool.
void applyBeehive(ivec2 p, ivec2 queen, inout uint material, bool includeFormation) {
    ivec2 offset = p - queen;
    uint prefab = beehivePrefabMaterial(offset, hash32(indexOf(p) ^ pc.seed ^ 0xb33u));
    if (prefab != MATERIAL_COUNT) material = prefab;
    if (includeFormation) {
        int slot = beeFormationSlotFromOffset(offset);
        if (material == MAT_EMPTY && slot >= 0) material = MAT_BEE;
    }
}

uint sandboxMaterial(ivec2 p) {
    ivec2 world = worldBrickSize();
    ivec2 b = brickCoordinate(p);
    int ground = world.y - 5;
    uint material = MAT_EMPTY;

    if (b.y >= world.y - 2) material = MAT_STONE;
    else if (b.y == ground) material = MAT_GRASS;
    else if (b.y > ground) material = MAT_DIRT;
    if ((b.x == 0 || b.x == world.x - 1) && b.y >= 2) material = MAT_STONE;

    // Brick-aligned water basin.
    ivec2 basinMin = ivec2(world.x * 2 / 5, ground - 7);
    ivec2 basinMax = ivec2(world.x * 3 / 5, ground + 1);
    if (brickFrame(p, basinMin, basinMax, 1)) material = MAT_GLASS;
    else if (brickRect(p, basinMin + ivec2(1), basinMax - ivec2(1))) material = MAT_WATER;

    // Brick-aligned crystal monument and acid-safe tank.
    if (brickRect(p, ivec2(world.x * 3 / 4, ground - 4), ivec2(world.x * 3 / 4 + 3, ground)))
        material = MAT_CRYSTAL;
    ivec2 acidMin = ivec2(world.x - 10, ground - 7);
    ivec2 acidMax = ivec2(world.x - 3, ground + 1);
    if (brickFrame(p, acidMin, acidMax, 1)) material = MAT_ACID_RESISTANT_PLASTIC;
    else if (brickRect(p, acidMin + ivec2(1), acidMax - ivec2(1))) material = MAT_ACID;

    // Deliberately loose granular sample; it is not structural terrain.
    ivec2 pileCenter = ivec2(world.x * BRICK_SIZE / 5, ground * BRICK_SIZE - 1);
    ivec2 d = p - pileCenter;
    if (d.y >= 0 && d.y < 48 && abs(d.x) < 52 - d.y) material = MAT_SAND;

    applyBeehive(p, sandboxQueen(), material, true);
    return material;
}

uint volcanoMaterial(ivec2 p) {
    ivec2 world = worldBrickSize();
    ivec2 b = brickCoordinate(p);
    int center = world.x / 2;
    int floorRow = world.y - 2;
    int top = max(3, floorRow - 27);
    uint material = MAT_EMPTY;

    if (b.y >= floorRow) return MAT_STONE;
    int depth = b.y - top;
    int halfWidth = max(0, depth * 2 / 3 + 2);
    if (b.y >= top && b.y < floorRow && abs(b.x - center) <= halfWidth) material = MAT_STONE;

    // Brick-aligned magma chamber, conduit, crater, and vents.
    ivec2 chamberCenter = ivec2(center, floorRow - 6);
    ivec2 chamberDelta = b - chamberCenter;
    if (chamberDelta.x * chamberDelta.x * 2 + chamberDelta.y * chamberDelta.y * 5 <= 54)
        material = MAT_MAGMA_VENT;
    if (abs(b.x - center) <= 1 && b.y >= top + 2 && b.y <= chamberCenter.y) material = MAT_MAGMA_VENT;
    if (b.y >= top && b.y < top + 2 && abs(b.x - center) <= 3) material = MAT_EMPTY;
    if (b.y == chamberCenter.y + 2 && abs(b.x - center) <= 1) material = MAT_MAGMA_VENT;

    // Brick-aligned cooling lake.
    ivec2 lakeMin = ivec2(min(world.x - 17, center + 14), floorRow - 8);
    ivec2 lakeMax = ivec2(min(world.x - 2, center + 30), floorRow + 1);
    if (brickFrame(p, lakeMin, lakeMax, 1)) material = MAT_STONE;
    else if (brickRect(p, lakeMin + ivec2(1), lakeMax - ivec2(1))) material = MAT_WATER;

    if (material == MAT_EMPTY && p.y < top * BRICK_SIZE && p.y > max(8, top * BRICK_SIZE - 88) &&
        abs(p.x - center * BRICK_SIZE) < 72 && (hash32(indexOf(p) ^ pc.seed ^ 0x51a9u) % 19u) == 0u)
        material = MAT_SMOKE;
    return material;
}

uint waterworksMaterial(ivec2 p) {
    ivec2 world = worldBrickSize();
    ivec2 b = brickCoordinate(p);
    int floorRow = world.y - 2;
    uint material = b.y >= floorRow ? MAT_STONE : MAT_EMPTY;

    int tankWidth = max(8, (world.x - 10) / 3);
    for (int tank = 0; tank < 3; ++tank) {
        int left = 2 + tank * (tankWidth + 1);
        ivec2 minimumBrick = ivec2(left, 3);
        ivec2 maximumBrick = ivec2(min(left + tankWidth, world.x - 2), floorRow - 9);
        if (brickFrame(p, minimumBrick, maximumBrick, 1)) material = MAT_GLASS;
        else if (brickRect(p, minimumBrick + ivec2(1), maximumBrick - ivec2(1)))
            material = tank == 0 ? MAT_WATER : (tank == 1 ? MAT_SALTWATER : MAT_OIL);

        int outlet = (minimumBrick.x + maximumBrick.x) / 2;
        if (b.x == outlet && b.y >= maximumBrick.y - 1 && b.y < floorRow - 3) material = MAT_EMPTY;
        if ((b.x == outlet - 1 || b.x == outlet + 1) &&
            b.y >= maximumBrick.y - 1 && b.y < floorRow - 3) material = MAT_GLASS;
    }

    ivec2 basinMin = ivec2(2, floorRow - 4);
    ivec2 basinMax = ivec2(world.x - 2, floorRow + 1);
    if (brickFrame(p, basinMin, basinMax, 1)) material = MAT_GLASS;
    else if (brickRect(p, basinMin + ivec2(1), basinMax - ivec2(1))) material = MAT_WATER;
    return material;
}

ivec2 ecosystemQueen() {
    ivec2 world = worldBrickSize();
    return brickCenter(ivec2(world.x - 22, world.y - 20));
}

uint ecosystemMaterial(ivec2 p) {
    ivec2 world = worldBrickSize();
    ivec2 b = brickCoordinate(p);
    int ground = world.y - 8;
    uint material = MAT_EMPTY;

    if (b.y >= world.y - 2) return MAT_STONE;
    if ((b.x == 0 || b.x == world.x - 1) && b.y >= 2) material = MAT_STONE;
    if (b.y == ground) material = MAT_GRASS;
    else if (b.y > ground) material = MAT_DIRT;

    // Brick reservoir and irrigation channel.
    ivec2 tankMin = ivec2(2, 4);
    ivec2 tankMax = ivec2(18, ground - 2);
    if (brickFrame(p, tankMin, tankMax, 1)) material = MAT_GLASS;
    else if (brickRect(p, tankMin + ivec2(1), tankMax - ivec2(1))) material = MAT_WATER;
    if (brickRect(p, ivec2(18, ground - 2), ivec2(world.x - 24, ground - 1))) material = MAT_WATER;
    if (brickRect(p, ivec2(18, ground - 1), ivec2(world.x - 24, ground))) material = MAT_GLASS;

    // Brick crop beds.
    for (int bed = 0; bed < 3; ++bed) {
        int left = 22 + bed * 10;
        if (brickRect(p, ivec2(left, ground - 1), ivec2(left + 7, ground + 1)))
            material = b.y == ground - 1 ? MAT_GRASS : MAT_DIRT;
        int stemX = (left + 2) * BRICK_SIZE + 4;
        int flowerX = (left + 5) * BRICK_SIZE + 4;
        if (p.x == stemX && p.y >= ground * BRICK_SIZE - 7 && p.y < ground * BRICK_SIZE)
            material = MAT_PLANT_STEM;
        if (p.x == stemX && p.y == ground * BRICK_SIZE - 8) material = MAT_FLOWER;
        if (p.x == flowerX && p.y == ground * BRICK_SIZE - 1) material = MAT_SEED;
    }

    // Brick-aligned insect farm under the soil.
    ivec2 farmMin = ivec2(world.x / 3, ground + 1);
    ivec2 farmMax = ivec2(world.x * 2 / 3, world.y - 2);
    if (brickFrame(p, farmMin, farmMax, 1)) material = MAT_WOOD;
    else if (brickRect(p, farmMin + ivec2(1), farmMax - ivec2(1))) material = MAT_EMPTY;
    if (brickRect(p, ivec2(farmMin.x + 2, farmMax.y - 2), ivec2(farmMin.x + 4, farmMax.y - 1)))
        material = MAT_INSECT_HABITAT;
    if (brickRect(p, ivec2(farmMin.x + 6, farmMax.y - 2), ivec2(farmMin.x + 8, farmMax.y - 1)))
        material = MAT_INSECT_HABITAT;
    if (p.y == brickOrigin(ivec2(0, farmMax.y - 2)).y - 1 &&
        p.x > (farmMin.x + 2) * BRICK_SIZE && p.x < (farmMax.x - 2) * BRICK_SIZE && (p.x % 13) == 0)
        material = ((p.x / 13) & 1) == 0 ? MAT_ANT : MAT_BEETLE;

    // Canonical Fix28 compact Beehive, shared with Sandbox and the buildable tool.
    applyBeehive(p, ecosystemQueen(), material, true);

    for (int flower = 0; flower < 6; ++flower) {
        int x = (world.x - 31 + flower * 3) * BRICK_SIZE + 4;
        if (p.x == x && p.y >= ground * BRICK_SIZE - 6 && p.y < ground * BRICK_SIZE)
            material = MAT_PLANT_STEM;
        if (p.x == x && p.y == ground * BRICK_SIZE - 7) material = MAT_FLOWER;
    }
    return material;
}

uint engineeringMaterial(ivec2 p) {
    ivec2 world = worldBrickSize();
    ivec2 b = brickCoordinate(p);
    int floorRow = world.y - 3;
    uint material = b.y >= floorRow ? MAT_INSULATOR : MAT_EMPTY;

    // Brick thermal vessel.
    ivec2 tankMin = ivec2(2, 5);
    ivec2 tankMax = ivec2(23, floorRow - 5);
    if (brickFrame(p, tankMin, tankMax, 1)) material = MAT_GLASS;
    else if (brickRect(p, tankMin + ivec2(1), tankMax - ivec2(1)))
        material = b.y >= (tankMin.y + tankMax.y) / 2 ? MAT_WATER : MAT_STEAM;
    if (brickRect(p, ivec2(10, tankMax.y), ivec2(16, tankMax.y + 1))) material = MAT_COPPER;
    if (brickRect(p, ivec2(12, tankMax.y - 1), ivec2(14, tankMax.y))) material = MAT_EMBER;

    // Center station: a real sediment sifter built entirely from aligned bricks.
    ivec2 hopperMin = ivec2(world.x / 3, 5);
    ivec2 hopperMax = ivec2(world.x / 3 + 21, 20);
    if (brickFrame(p, hopperMin, hopperMax, 1)) material = MAT_STEEL;
    else if (brickRect(p, hopperMin + ivec2(1), hopperMax - ivec2(1))) {
        uint mix = hash32(indexOf(p) ^ pc.seed ^ 0x5f17u);
        if ((mix % 71u) == 0u) material = MAT_ALUMINUM_SHAVINGS;
        else if ((mix % 43u) == 0u) material = MAT_COPPER;
        else if ((mix % 23u) == 0u) material = MAT_IRON_ORE;
        else material = (mix & 3u) == 0u ? MAT_SILT : MAT_SAND;
    }
    int outlet = (hopperMin.x + hopperMax.x) / 2;
    if (b.y == hopperMax.y - 1 && abs(b.x - outlet) <= 1) material = MAT_EMPTY;
    if (brickRect(p, ivec2(outlet + 5, hopperMax.y + 1), ivec2(outlet + 9, hopperMax.y + 7)))
        material = MAT_MAGNET;
    if (brickRect(p, ivec2(hopperMin.x, floorRow - 7), ivec2(hopperMax.x + 8, floorRow - 6)))
        material = MAT_STEEL;

    // Functional industrial line: loose sediment falls onto a powered conveyor,
    // the aligned sluice consumes nearby sand/silt only while water is present,
    // and separated gold/silt exits onto the continuing belt.
    int lineY = floorRow - 4;
    if (brickRect(p, ivec2(hopperMin.x, lineY + 1), ivec2(hopperMax.x + 8, lineY + 2)))
        material = MAT_CONVEYOR;
    if (brickRect(p, ivec2(outlet + 2, lineY), ivec2(outlet + 3, lineY + 1)))
        material = MAT_SLUICE_BOX;
    if (brickRect(p, ivec2(outlet + 1, hopperMax.y), ivec2(outlet + 2, lineY + 1)))
        material = MAT_WATER;

    // Right brick gas chamber: two controlled reservoirs share exactly one
    // aperture so diffusion is observable instead of beginning as an arbitrary mix.
    ivec2 gasMin = ivec2(world.x - 23, 5);
    ivec2 gasMax = ivec2(world.x - 2, 21);
    int gasDivider = (gasMin.x + gasMax.x) / 2;
    if (brickFrame(p, gasMin, gasMax, 1)) material = MAT_GLASS;
    else if (brickRect(p, gasMin + ivec2(1), gasMax - ivec2(1)))
        material = b.x < gasDivider ? MAT_HYDROGEN : MAT_OXYGEN;
    if (b.x == gasDivider && b.y > gasMin.y && b.y < gasMax.y - 1)
        material = b.y == (gasMin.y + gasMax.y) / 2 ? MAT_EMPTY : MAT_GLASS;

    // Paired compost experiment below the gas chamber. The left control contains
    // ash/mineral feed plus clean water and must not produce fertilizer. The right
    // treatment supplies ash, waste, silt, dirty water, air, and time so the actual
    // compost mechanics are visible without any hidden ember-to-fertilizer shortcut.
    ivec2 controlMin = ivec2(world.x - 23, 24);
    ivec2 controlMax = ivec2(world.x - 13, floorRow);
    ivec2 treatmentMin = ivec2(world.x - 12, 24);
    ivec2 treatmentMax = ivec2(world.x - 2, floorRow);
    if (brickFrame(p, controlMin, controlMax, 1)) material = MAT_GLASS;
    else if (brickRect(p, controlMin + ivec2(1), controlMax - ivec2(1))) {
        if (b.y >= controlMax.y - 3) material = MAT_SILT;
        else if (b.y == controlMax.y - 4) material = MAT_ASH;
        else if (b.y == controlMax.y - 5) material = MAT_WATER;
        else material = MAT_ATMOSPHERE;
    }
    if (brickFrame(p, treatmentMin, treatmentMax, 1)) material = MAT_GLASS;
    else if (brickRect(p, treatmentMin + ivec2(1), treatmentMax - ivec2(1))) {
        if (b.y >= treatmentMax.y - 3) material = MAT_SILT;
        else if (b.y == treatmentMax.y - 4) material = (b.x & 1) == 0 ? MAT_ASH : MAT_WASTE;
        else if (b.y == treatmentMax.y - 5) material = MAT_DIRTY_WATER;
        else material = MAT_ATMOSPHERE;
    }
    return material;
}

uint goldMineMaterial(ivec2 p) {
    ivec2 world = worldBrickSize();
    ivec2 b = brickCoordinate(p);
    uint material = MAT_EMPTY;
    int upper = 16;  // y=128, matching the player spawn.
    int middle = 26;
    int lower = 36;
    int floorRow = world.y - 2;

    if (b.y >= floorRow) return MAT_STONE;
    if ((b.x == 0 || b.x == world.x - 1) && b.y >= 2) material = MAT_STONE;

    // Large upper reservoir and filter bed, aligned to the global brick grid.
    ivec2 reservoirMin = ivec2(22, 3);
    ivec2 reservoirMax = ivec2(world.x - 3, 13);
    if (brickFrame(p, reservoirMin, reservoirMax, 1)) material = MAT_STEEL;
    else if (brickRect(p, reservoirMin + ivec2(1), reservoirMax - ivec2(1)))
        material = b.y < reservoirMax.y - 3 ? MAT_WATER : (((b.x & 1) == 0) ? MAT_STONE : MAT_GRASS);

    if (brickRect(p, ivec2(2, upper), ivec2(29, upper + 1))) material = MAT_STEEL;
    if (brickRect(p, ivec2(2, middle), ivec2(world.x - 2, middle + 1))) material = MAT_STEEL;
    if (brickRect(p, ivec2(2, lower), ivec2(world.x - 2, lower + 1))) material = MAT_STEEL;
    if (brickStair(p, ivec2(16, middle - 1), 10, true)) material = MAT_STEEL;
    if (brickStair(p, ivec2(5, lower - 1), 10, true)) material = MAT_STEEL;

    ivec2 pileCenter = ivec2(36 * BRICK_SIZE, middle * BRICK_SIZE - 1);
    ivec2 pile = p - pileCenter;
    if (pile.y <= 0 && pile.y > -56 && abs(pile.x) < 70 + pile.y) {
        uint mix = hash32(indexOf(p) ^ pc.seed ^ 0x91f3u);
        if ((mix % 97u) == 0u) material = MAT_ALUMINUM_SHAVINGS;
        else if ((mix % 41u) == 0u) material = MAT_COPPER;
        else if ((mix % 29u) == 0u) material = MAT_IRON_ORE;
        else if ((mix % 23u) == 0u) material = MAT_GOLD;
        else material = MAT_SAND;
    }

    ivec2 poolMin = ivec2(world.x - 22, 18);
    ivec2 poolMax = ivec2(world.x - 3, middle + 1);
    if (brickFrame(p, poolMin, poolMax, 1)) material = MAT_GLASS;
    else if (brickRect(p, poolMin + ivec2(1), poolMax - ivec2(1))) material = MAT_WATER;

    // Scientific wet-separation station. The existing sediment pile is untouched;
    // its right edge reaches this powered belt, which feeds one aligned sluice.
    // A narrow reservoir downcomer provides visible process water and the belt
    // continues beyond the output so retained water and trace gold can be observed.
    int sluiceX = world.x - 28;
    if (brickRect(p, ivec2(43, middle - 1), ivec2(sluiceX, middle))) material = MAT_CONVEYOR;
    if (brickRect(p, ivec2(sluiceX, middle - 1), ivec2(sluiceX + 1, middle))) material = MAT_SLUICE_BOX;
    if (brickRect(p, ivec2(sluiceX + 1, middle - 1), ivec2(sluiceX + 7, middle))) material = MAT_CONVEYOR;
    if (brickRect(p, ivec2(sluiceX - 1, reservoirMax.y - 1), ivec2(sluiceX, middle - 1)))
        material = MAT_WATER;
    if (brickRect(p, ivec2(sluiceX - 2, reservoirMax.y - 1), ivec2(sluiceX - 1, middle - 1)))
        material = MAT_GLASS;
    return material;
}

uint demolitionMaterial(ivec2 p) {
    ivec2 world = worldBrickSize();
    ivec2 b = brickCoordinate(p);
    int floorRow = world.y - 4;
    uint material = MAT_EMPTY;

    if (b.y >= floorRow) material = MAT_STONE;
    if ((b.x == 0 || b.x == world.x - 1) && b.y >= 2) material = MAT_STONE;

    ivec2 towerMin = ivec2(world.x / 3, 7);
    ivec2 towerMax = ivec2(world.x * 2 / 3, floorRow);
    if (brickFrame(p, towerMin, towerMax, 1)) material = MAT_STEEL;
    else if (brickRect(p, towerMin + ivec2(1), towerMax - ivec2(1))) material = MAT_EMPTY;
    for (int level = towerMin.y + 5; level < towerMax.y; level += 6)
        if (brickRect(p, ivec2(towerMin.x + 1, level), ivec2(towerMax.x - 1, level + 1))) material = MAT_STEEL;

    // Explosive cells remain canonical loose material inside brick-aligned rooms.
    if (brickRect(p, ivec2(towerMin.x + 3, towerMax.y - 8), ivec2(towerMin.x + 8, towerMax.y - 4)))
        material = ((p.x + p.y) & 1) == 0 ? MAT_GUNPOWDER : MAT_OIL;
    if (brickRect(p, ivec2(towerMax.x - 8, towerMax.y - 14), ivec2(towerMax.x - 3, towerMax.y - 10)))
        material = ((p.x + p.y) & 3) == 0 ? MAT_EMBER : MAT_GUNPOWDER;
    if (brickRect(p, ivec2(towerMin.x - 9, floorRow - 6), ivec2(towerMin.x - 2, floorRow))) material = MAT_SAND;
    return material;
}

uint frontierBaseMaterial(ivec2 p) {
    ivec2 world = worldBrickSize();
    ivec2 b = brickCoordinate(p);
    int surface = 17;
    int floorRow = world.y - 2;
    uint material = MAT_EMPTY;

    if (b.y >= floorRow) return MAT_STONE;
    if (b.y == surface) material = MAT_GRASS;
    else if (b.y > surface) material = MAT_DIRT;

    // Player bunker aligned around the fixed actor spawn at x=168, y=200.
    ivec2 baseMin = ivec2(6, 20);
    ivec2 baseMax = ivec2(50, 41);
    if (brickFrame(p, baseMin, baseMax, 1)) material = MAT_STEEL;
    else if (brickRect(p, baseMin + ivec2(1), baseMax - ivec2(1))) material = MAT_EMPTY;
    for (int level = 26; level < 41; level += 7)
        if (brickRect(p, ivec2(baseMin.x + 1, level), ivec2(baseMax.x - 1, level + 1))) material = MAT_STEEL;
    if (brickStair(p, ivec2(7, 39), 9, true)) material = MAT_STEEL;

    // Brick waterfall aerator.
    ivec2 waterMin = ivec2(5, 3);
    ivec2 waterMax = ivec2(14, 9);
    if (brickFrame(p, waterMin, waterMax, 1)) material = MAT_GLASS;
    else if (brickRect(p, waterMin + ivec2(1), waterMax - ivec2(1))) material = MAT_WATER;
    if (brickRect(p, ivec2(8, 8), ivec2(10, 22))) material = MAT_WATER;
    if (brickRect(p, ivec2(7, 8), ivec2(8, 23)) || brickRect(p, ivec2(10, 8), ivec2(11, 23)))
        material = MAT_GLASS;
    ivec2 catchMin = ivec2(5, 22);
    ivec2 catchMax = ivec2(15, 27);
    if (brickFrame(p, catchMin, catchMax, 1)) material = MAT_GLASS;
    else if (brickRect(p, catchMin + ivec2(1), catchMax - ivec2(1))) material = MAT_WATER;

    // Unified brick-grid factory floor.
    if (brickRect(p, ivec2(14, 35), ivec2(49, 36))) material = MAT_CONVEYOR;
    if (brickRect(p, ivec2(24, 34), ivec2(25, 35))) material = MAT_FACTORY_CORE;
    if (brickRect(p, ivec2(28, 34), ivec2(29, 35))) material = MAT_SMELTER;
    if (brickRect(p, ivec2(34, 34), ivec2(35, 35))) material = MAT_ASSEMBLER;
    if (brickRect(p, ivec2(41, 34), ivec2(42, 35))) material = MAT_INSECT_HABITAT;
    if (brickRect(p, ivec2(15, 32), ivec2(18, 35))) material = ((p.x + p.y) & 1) == 0 ? MAT_IRON : MAT_GOLD;
    if (brickRect(p, ivec2(31, 32), ivec2(33, 35))) material = MAT_COPPER;
    if (brickRect(p, ivec2(37, 32), ivec2(39, 35))) material = MAT_POWER_CELL;

    // Enemy bunker and factory remain on the same aligned grid.
    ivec2 enemyMin = ivec2(world.x - 21, 20);
    ivec2 enemyMax = ivec2(world.x - 2, 34);
    if (brickFrame(p, enemyMin, enemyMax, 1)) material = MAT_STEEL;
    else if (brickRect(p, enemyMin + ivec2(1), enemyMax - ivec2(1))) material = MAT_EMPTY;
    if (brickRect(p, ivec2(enemyMin.x + 2, 27), ivec2(enemyMin.x + 3, 28))) material = MAT_FACTORY_CORE;
    if (brickRect(p, ivec2(enemyMin.x + 7, 28), ivec2(enemyMin.x + 8, 29))) material = MAT_INSECT_HABITAT;
    if (brickRect(p, ivec2(enemyMin.x + 1, 29), ivec2(enemyMax.x - 1, 30))) material = MAT_CONVEYOR;
    if (brickRect(p, ivec2(enemyMin.x + 2, 25), ivec2(enemyMin.x + 4, 28))) material = MAT_STEEL;
    if (brickRect(p, ivec2(enemyMin.x + 5, 25), ivec2(enemyMin.x + 7, 28))) material = MAT_COPPER;
    if (brickRect(p, ivec2(enemyMin.x + 8, 25), ivec2(enemyMin.x + 10, 28))) material = MAT_PLASMA_AMMO;

    if (material == MAT_EMPTY && brickRect(p, baseMin + ivec2(1), baseMax - ivec2(1)) && ((p.x + p.y) & 1) == 0)
        material = MAT_ATMOSPHERE;
    if (p.y == surface * BRICK_SIZE - 1 && p.x > 150 && p.x < 250 && (p.x % 31) == 0) material = MAT_ANT;
    if (p.y == surface * BRICK_SIZE - 1 && p.x > AUTHORED_WORLD_CELLS.x - 220 && p.x < AUTHORED_WORLD_CELLS.x - 80 && (p.x % 17) == 0)
        material = MAT_BEETLE;
    return material;
}

uint materialForScene(uint scene, ivec2 p) {
    if (!insideAuthoredLocal(p)) return MAT_EMPTY;
    if (scene == SCENE_SANDBOX) return sandboxMaterial(p);
    if (scene == SCENE_BLANK) return MAT_EMPTY;
    if (scene == SCENE_VOLCANO) return volcanoMaterial(p);
    if (scene == SCENE_WATERWORKS) return waterworksMaterial(p);
    if (scene == SCENE_ECOSYSTEM) return ecosystemMaterial(p);
    if (scene == SCENE_ENGINEERING) return engineeringMaterial(p);
    if (scene == SCENE_GOLD_MINE) return goldMineMaterial(p);
    if (scene == SCENE_DEMOLITION) return demolitionMaterial(p);
    if (scene == SCENE_FRONTIER_BASE) return frontierBaseMaterial(p);
    return MAT_EMPTY;
}

bool looseAuthoredCargo(uint scene, ivec2 p, uint material) {
    if (scene == SCENE_ENGINEERING || scene == SCENE_GOLD_MINE || scene == SCENE_FRONTIER_BASE) {
        if (material == MAT_IRON || material == MAT_COPPER || material == MAT_GOLD ||
            material == MAT_ALUMINUM || material == MAT_ALUMINUM_SHAVINGS ||
            material == MAT_IRON_ORE || material == MAT_POWER_CELL ||
            material == MAT_PLASMA_AMMO) return true;
    }
    return false;
}

bool looseAuthoredTerrain(uint scene, ivec2 p, uint material) {
    if (material != MAT_SAND && material != MAT_SILT && material != MAT_SALT && material != MAT_ICE)
        return false;
    // Explicit samples stay loose; every structural scene surface is authored by brick helpers.
    return scene == SCENE_SANDBOX || scene == SCENE_ENGINEERING ||
           scene == SCENE_GOLD_MINE || scene == SCENE_DEMOLITION;
}

bool authoredStructuralCell(uint scene, ivec2 p, uint material) {
    // All structural assignments above originate from global 8x8 brick coordinates.
    // Organic agents and deliberate granular/cargo samples remain ordinary cells.
    bool authoredTerrain = material == MAT_DIRT || material == MAT_GRASS ||
                           material == MAT_SAND || material == MAT_SILT ||
                           material == MAT_SALT || material == MAT_ICE;
    return (isBlockCapable(material) || authoredTerrain) &&
           !looseAuthoredCargo(scene, p, material) &&
           !looseAuthoredTerrain(scene, p, material);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (!inside(p)) return;

    uint scene = pc.material % SCENE_COUNT;
    bool authored = insideAuthoredWorld(p);
    ivec2 local = authoredLocalCoordinate(p);
    uint material = authored ? materialForScene(scene, local) : MAT_EMPTY;
    uint substrateMaterial = residentWorldSubstrateMaterial(p);
    bool substrateCell = substrateMaterial != MAT_EMPTY;
    if (substrateCell) material = substrateMaterial;
    if (material == MAT_EMPTY) material = MAT_ATMOSPHERE;
    bool structural = substrateCell
        ? residentSubstrateStructural(material)
        : (authored && authoredStructuralCell(scene, local, material));
    Cell cell = structural ? makeStructuralCell(material, true) : makeCell(material);
    bool machineController = authored &&
        (material == MAT_SMELTER || material == MAT_ASSEMBLER ||
         material == MAT_INSECT_HABITAT || material == MAT_SLUICE_BOX) && (local.x & 7) == 3 && (local.y & 7) == 3;

    cell.aux = (cell.aux & ~AUX_RANDOM_MASK) | (hash32(indexOf(p) ^ pc.seed) & AUX_RANDOM_MASK) |
               (cell.aux & (AUX_WET | AUX_CHARGED | AUX_BEE_POLLEN | AUX_BEE_FED |
                            AUX_PLANT_STEM | AUX_STRUCTURAL | AUX_SUPPORTED | AUX_STATE_MASK));

    if (authored && (scene == SCENE_SANDBOX || scene == SCENE_ECOSYSTEM) &&
        material == MAT_BEE) {
        ivec2 localQueen = scene == SCENE_SANDBOX ? sandboxQueen() : ecosystemQueen();
        int slot = beeFormationSlotFromOffset(local - localQueen);
        if (slot >= 0) {
            ivec2 worldQueen = authoredWorldOrigin() + localQueen;
            cell.aux |= BEE_AUX_SWARM | BEE_AUX_FED;
            cell.aux = beePackMetadata(cell.aux, worldQueen, uint(slot), pc.width, pc.height);
            cell.age = beePackAge(uint((slot * 17) % 900), BEE_TARGET_NONE);
        }
    }

    if (machineController) {
        setMachineInventory(cell, uvec4(0u));
        if (scene == SCENE_FRONTIER_BASE && local.x > AUTHORED_WORLD_CELLS.x / 2) cell.aux &= ~AUX_CHARGED;
        else cell.aux |= AUX_CHARGED;
    }
    if (authored && scene == SCENE_ENGINEERING && isConductive(material) && local.x < 70)
        cell.aux |= AUX_CHARGED;
    if (material == MAT_BEETLE) cell.aux &= ~AUX_CHARGED;
    if (material == MAT_ANT || material == MAT_CONVEYOR) cell.aux |= AUX_CHARGED;
    if (material == MAT_FACTORY_CORE) {
        if (scene == SCENE_FRONTIER_BASE && local.x > AUTHORED_WORLD_CELLS.x / 2) cell.aux &= ~AUX_CHARGED;
        else cell.aux |= AUX_CHARGED;
    }
    cells[indexOf(p)] = cell;
}
