#version 450
#extension GL_GOOGLE_include_directive : require
#include "materials.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) buffer CurrentCells { Cell cells[]; };

const uint SCENE_SANDBOX = 0u;
const uint SCENE_BLANK = 1u;
const uint SCENE_VOLCANO = 2u;
const uint SCENE_WATERWORKS = 3u;
const uint SCENE_ECOSYSTEM = 4u;
const uint SCENE_ENGINEERING = 5u;
const uint SCENE_GOLD_MINE = 6u;
const uint SCENE_DEMOLITION = 7u;
const uint SCENE_FRONTIER_BASE = 8u;
const uint SCENE_COUNT = 9u;

bool rectContains(ivec2 p, ivec2 minimum, ivec2 maximum) {
    return all(greaterThanEqual(p, minimum)) && all(lessThan(p, maximum));
}

uint sandboxMaterial(ivec2 p) {
    uint terrain = pc.height - 44u + (hash32(uint(p.x) * 17u) % 9u);
    uint material = MAT_EMPTY;
    if (uint(p.y) >= pc.height - 8u) material = MAT_STONE;
    else if (uint(p.y) >= terrain) material = uint(p.y) == terrain ? MAT_GRASS : MAT_DIRT;

    ivec2 sandCenter = ivec2(int(pc.width / 5u), int(pc.height - 80u));
    ivec2 sandDelta = p - sandCenter;
    if (sandDelta.y >= 0 && sandDelta.y < 38 && abs(sandDelta.x) < 40 - sandDelta.y) material = MAT_SAND;

    if (p.x > int(pc.width * 2u / 5u) && p.x < int(pc.width * 3u / 5u) &&
        p.y > int(pc.height - 92u) && p.y < int(pc.height - 52u)) material = MAT_WATER;

    ivec2 crystalCenter = ivec2(int(pc.width * 3u / 4u), int(pc.height - 62u));
    ivec2 crystalDelta = p - crystalCenter;
    if (crystalDelta.x * crystalDelta.x + crystalDelta.y * crystalDelta.y < 180) material = MAT_CRYSTAL;

    if (p.x > int(pc.width - 72u) && p.x < int(pc.width - 48u) &&
        p.y > int(pc.height - 58u) && p.y < int(pc.height - 10u)) material = MAT_ACID_RESISTANT_PLASTIC;
    if (p.x > int(pc.width - 69u) && p.x < int(pc.width - 51u) &&
        p.y > int(pc.height - 52u) && p.y < int(pc.height - 14u)) material = MAT_ACID;

    ivec2 queen = ivec2(int(pc.width * 4u / 5u), int(pc.height - 126u));
    ivec2 q = p - queen;
    int q2 = q.x * q.x + q.y * q.y;
    if (p.x > queen.x - 34 && p.x < queen.x + 28 && p.y > queen.y - 16 && p.y < queen.y - 11) material = MAT_WOOD;
    if (q2 >= 24 && q2 < 88) material = MAT_BEE_NEST;
    if (q2 == 0) material = MAT_QUEEN_BEE;
    else if (q.x >= 1 && q.x <= 10 && abs(q.y) <= 1) material = MAT_EMPTY;
    else if (q2 < 24) {
        uint chamberPattern = hash32(indexOf(p) ^ pc.seed);
        material = (chamberPattern & 3u) == 0u ? MAT_EMPTY
            : (((chamberPattern >> 2u) & 3u) == 0u ? MAT_POLLEN : MAT_HONEY);
    }
    if (q2 > 110 && q2 < 620 && (hash32(indexOf(p) ^ pc.seed ^ 0xbee51u) % 37u) == 0u) material = MAT_BEE;
    return material;
}

uint volcanoMaterial(ivec2 p) {
    int floorY = int(pc.height) - 10;
    int centerX = int(pc.width / 2u);
    int coneTop = max(22, floorY - 198);
    int vertical = floorY - p.y;
    uint material = MAT_EMPTY;

    if (p.y >= floorY) return MAT_STONE;
    int halfWidth = max(0, 194 - vertical * 9 / 10);
    if (p.y >= coneTop && vertical >= 0 && abs(p.x - centerX) < halfWidth)
        material = MAT_STONE;

    int chamberTop = floorY - 86;
    int chamberBottom = floorY - 18;
    int dx = p.x - centerX;
    int chamberY = (chamberTop + chamberBottom) / 2;
    int dy = p.y - chamberY;
    if (dx * dx * 4 + dy * dy * 9 < 92 * 92) material = MAT_LAVA;
    if (abs(dx) <= 7 && p.y >= coneTop + 12 && p.y <= chamberTop + 20) material = MAT_LAVA;
    if (p.y >= coneTop && p.y < coneTop + 18 && abs(dx) < 24)
        material = p.y >= coneTop + 8 ? MAT_LAVA : MAT_EMPTY;
    if (rectContains(p, ivec2(centerX - 8, chamberBottom - 12),
                         ivec2(centerX + 9, chamberBottom))) material = MAT_MAGMA_VENT;
    if (abs(dx) <= 2 && p.y >= chamberTop - 4 && p.y <= coneTop + 18 && ((p.y - coneTop) % 14) == 0)
        material = MAT_MAGMA_VENT;

    int lakeLeft = min(int(pc.width) - 126, centerX + 150);
    int lakeRight = min(int(pc.width) - 18, centerX + 268);
    int lakeTop = floorY - 58;
    bool lakeWall = (p.x == lakeLeft || p.x == lakeRight || p.y == floorY - 1) &&
                    p.x >= lakeLeft && p.x <= lakeRight && p.y >= lakeTop && p.y < floorY;
    if (lakeWall) material = MAT_STONE;
    if (p.x > lakeLeft && p.x < lakeRight && p.y > lakeTop + 12 && p.y < floorY - 1)
        material = MAT_WATER;

    if (p.y < coneTop && p.y > max(3, coneTop - 92) && abs(dx) < 72 &&
        (hash32(indexOf(p) ^ pc.seed ^ 0x51a9u) % 17u) == 0u) material = MAT_SMOKE;
    return material;
}

uint waterworksMaterial(ivec2 p) {
    int floorY = int(pc.height) - 10;
    if (p.y >= floorY) return MAT_STONE;

    uint material = MAT_EMPTY;
    int basinTop = int(pc.height) - 74;
    if (p.y == basinTop || p.y == floorY - 1 || p.x == 18 || p.x == int(pc.width) - 19) {
        if (p.y >= basinTop && p.y < floorY) material = MAT_GLASS;
    }

    int reservoirTop = int(pc.height) - 220;
    int reservoirBottom = int(pc.height) - 118;
    int width = 112;
    for (int reservoir = 0; reservoir < 3; ++reservoir) {
        int left = 42 + reservoir * 176;
        int right = left + width;
        bool wall = (p.x == left || p.x == right || p.y == reservoirBottom) &&
                    p.y >= reservoirTop && p.y <= reservoirBottom;
        bool outlet = p.y == reservoirBottom && p.x >= left + width / 2 - 5 && p.x <= left + width / 2 + 5;
        if (wall && !outlet) material = MAT_GLASS;
        if (p.x > left && p.x < right && p.y > reservoirTop + 12 && p.y < reservoirBottom) {
            material = reservoir == 0 ? MAT_WATER : (reservoir == 1 ? MAT_SALTWATER : MAT_OIL);
        }

        int channelX = left + width / 2;
        int channelBottom = basinTop - 2;
        if (p.x >= channelX - 2 && p.x <= channelX + 2 && p.y > reservoirBottom && p.y < channelBottom) {
            material = MAT_EMPTY;
        }
        if ((p.x == channelX - 4 || p.x == channelX + 4) && p.y > reservoirBottom && p.y < channelBottom) {
            material = MAT_GLASS;
        }
    }

    if (p.y > basinTop + 8 && p.y < floorY - 2 && p.x > 22 && p.x < int(pc.width) - 22) {
        material = MAT_WATER;
    }
    return material;
}

uint ecosystemMaterial(ivec2 p) {
    int width = int(pc.width);
    int height = int(pc.height);
    int floorY = height - 10;
    uint material = MAT_EMPTY;

    if (p.y >= floorY) return MAT_STONE;
    if ((p.x < 8 || p.x >= width - 8) && p.y >= 8) material = MAT_STONE;

    int groundY = floorY - 54 + int(hash32(uint(p.x) * 31u) % 5u);
    if (p.y >= groundY && p.y < floorY)
        material = p.y == groundY ? MAT_GRASS : MAT_DIRT;

    // Four-pixel reservoir walls satisfy the 32-pixel cohesive minimum in each
    // aligned region; scene glass can no longer survive as one-pixel threads.
    int tankLeft = 22;
    int tankRight = 148;
    int tankTop = 54;
    int tankBottom = groundY - 8;
    int tankThickness = 4;
    bool tankBounds = p.x >= tankLeft && p.x <= tankRight &&
                      p.y >= tankTop && p.y <= tankBottom;
    bool tankWall = tankBounds &&
        (p.x < tankLeft + tankThickness || p.x > tankRight - tankThickness ||
         p.y < tankTop + tankThickness || p.y > tankBottom - tankThickness);
    bool outlet = p.x >= tankRight - 7 && p.x <= tankRight &&
                  p.y >= tankBottom - 11 && p.y <= tankBottom;
    if (tankWall && !outlet) material = MAT_GLASS;
    if (p.x >= tankLeft + tankThickness && p.x <= tankRight - tankThickness &&
        p.y >= tankTop + 14 && p.y <= tankBottom - tankThickness)
        material = MAT_WATER;

    int trenchY = groundY - 5;
    if (p.x >= tankRight && p.x < 430 && p.y >= trenchY + 4 && p.y < trenchY + 8)
        material = MAT_GLASS;
    if (p.x >= tankRight && p.x < 430 && p.y > trenchY && p.y < trenchY + 4)
        material = MAT_WATER;

    for (int bed = 0; bed < 3; ++bed) {
        int left = 178 + bed * 78;
        int right = left + 58;
        if (p.x >= left && p.x < right && p.y >= groundY - 8 && p.y <= groundY)
            material = p.y == groundY - 8 ? MAT_GRASS : MAT_DIRT;
        int seedX = left + 14;
        int matureX = left + 38;
        if (p.x == seedX && p.y == groundY - 9) material = MAT_SEED;
        if (p.x == matureX && p.y >= groundY - 12 && p.y <= groundY - 9)
            material = MAT_PLANT_STEM;
        if (p.x == matureX && p.y == groundY - 13) material = MAT_FLOWER;
        if (p.x == right - 4 && p.y == groundY - 9) material = MAT_FERTILIZER;
    }

    // Proper bottom insect farm: clear the chamber first, then add thick walls,
    // substrate, two habitats, recoverable waste/fertilizer, ants, and beetles.
    int farmLeft = 244;
    int farmRight = 420;
    int farmTop = groundY + 10;
    int farmBottom = floorY - 4;
    int farmWallThickness = 4;
    bool farmInterior = p.x > farmLeft && p.x < farmRight &&
                        p.y > farmTop && p.y < farmBottom;
    if (farmInterior) material = MAT_EMPTY;
    bool farmWall = p.x >= farmLeft && p.x <= farmRight &&
                    p.y >= farmTop && p.y <= farmBottom &&
        (p.x < farmLeft + farmWallThickness || p.x > farmRight - farmWallThickness ||
         p.y < farmTop + farmWallThickness || p.y > farmBottom - farmWallThickness);
    bool farmVent = p.y < farmTop + farmWallThickness &&
                    ((p.x >= farmLeft + 28 && p.x < farmLeft + 44) ||
                     (p.x >= farmRight - 44 && p.x < farmRight - 28));
    if (farmWall && !farmVent)
        material = p.y < farmTop + farmWallThickness ? MAT_GLASS : MAT_WOOD;

    int substrateTop = farmBottom - 12;
    if (p.x >= farmLeft + farmWallThickness && p.x <= farmRight - farmWallThickness &&
        p.y >= substrateTop && p.y < farmBottom - farmWallThickness)
        material = p.y == substrateTop ? MAT_GRASS : MAT_DIRT;

    if (rectContains(p, ivec2(farmLeft + 16, substrateTop - 8),
                        ivec2(farmLeft + 32, substrateTop)))
        material = MAT_INSECT_HABITAT;
    if (rectContains(p, ivec2(farmLeft + 48, substrateTop - 8),
                        ivec2(farmLeft + 64, substrateTop)))
        material = MAT_INSECT_HABITAT;

    if (rectContains(p, ivec2(farmRight - 62, substrateTop - 7),
                        ivec2(farmRight - 42, substrateTop)))
        material = ((p.x + p.y) & 1) == 0 ? MAT_WASTE : MAT_FERTILIZER;
    if (rectContains(p, ivec2(farmRight - 36, substrateTop - 7),
                        ivec2(farmRight - 16, substrateTop)))
        material = ((p.x + p.y) & 1) == 0 ? MAT_WOOD : MAT_WASTE;

    if (p.y == substrateTop - 1 && p.x > farmLeft + 72 && p.x < farmRight - 70 &&
        (p.x % 7) == 0)
        material = ((p.x / 7) & 1) == 0 ? MAT_ANT : MAT_BEETLE;
    if (p.y == substrateTop - 2 && p.x > farmLeft + 20 && p.x < farmLeft + 64 &&
        (p.x % 11) == 0)
        material = ((p.x / 11) & 1) == 0 ? MAT_BEETLE : MAT_ANT;

    // Canonical new hive. The shell/chambers stay compact, while three curved
    // authored bee bands establish the synchronized wave immediately on reset.
    ivec2 queen = ivec2(width - 104, groundY - 72);
    ivec2 q = p - queen;
    int q2 = q.x * q.x + q.y * q.y;
    if (q2 >= 28 && q2 < 108) material = MAT_BEE_NEST;
    if (q2 == 0) material = MAT_QUEEN_BEE;
    else if (q.x >= 1 && q.x <= 12 && abs(q.y) <= 1) material = MAT_EMPTY;
    else if (q2 < 28) {
        uint chamber = hash32(indexOf(p) ^ pc.seed ^ 0xb33u);
        material = (chamber & 3u) == 0u ? MAT_EMPTY
            : ((chamber & 4u) == 0u ? MAT_HONEY : MAT_POLLEN);
    }

    if (material == MAT_EMPTY && q2 > 130 && q2 < 6200) {
        float radius = length(vec2(q));
        float angle = atan(float(q.y), float(q.x));
        float wavePhase = angle * 3.0 + radius * 0.14;
        bool innerWave = abs(radius - (18.0 + sin(wavePhase) * 3.5)) < 1.15;
        bool middleWave = abs(radius - (30.0 + sin(wavePhase + 1.7) * 5.0)) < 1.25;
        bool outerWave = abs(radius - (44.0 + sin(wavePhase + 3.2) * 7.0)) < 1.35;
        uint swarm = hash32(indexOf(p) ^ pc.seed ^ 0xbee51u);
        if ((innerWave || middleWave || outerWave) && (swarm & 3u) != 0u)
            material = MAT_BEE;
        else if (radius < 58.0 && (swarm % 53u) == 0u)
            material = MAT_BEE;
    }

    for (int flower = 0; flower < 6; ++flower) {
        int x = width - 240 + flower * 26;
        if (p.x == x && p.y >= groundY - 5 && p.y <= groundY - 2)
            material = MAT_PLANT_STEM;
        if (p.x == x && p.y == groundY - 6) material = MAT_FLOWER;
    }

    if (material == MAT_EMPTY && p.y > groundY - 62 && p.y < groundY - 12 &&
        p.x > 150 && p.x < 430 &&
        (hash32(indexOf(p) ^ pc.seed ^ 0x02u) % 17u) == 0u)
        material = MAT_OXYGEN;
    if (material == MAT_EMPTY && p.y >= groundY - 16 && p.y < groundY &&
        (hash32(indexOf(p) ^ pc.seed ^ 0xc02u) % 13u) == 0u)
        material = MAT_CARBON_DIOXIDE;

    int gasLeft = width - 188;
    int gasRight = width - 20;
    int gasTop = 18;
    int gasBottom = 72;
    int gasThickness = 4;
    bool gasBounds = p.x >= gasLeft && p.x <= gasRight &&
                     p.y >= gasTop && p.y <= gasBottom;
    bool gasWall = gasBounds &&
        (p.x < gasLeft + gasThickness || p.x > gasRight - gasThickness ||
         p.y < gasTop + gasThickness || p.y > gasBottom - gasThickness);
    if (gasWall) material = MAT_GLASS;
    if (p.x >= gasLeft + gasThickness && p.x <= gasRight - gasThickness &&
        p.y >= gasTop + gasThickness && p.y <= gasBottom - gasThickness &&
        (hash32(indexOf(p) ^ pc.seed ^ 0x4a2u) & 1u) == 0u)
        material = MAT_HYDROGEN;

    return material;
}

uint engineeringMaterial(ivec2 p) {
    int floorY = int(pc.height) - 12;
    uint material = p.y >= floorY ? MAT_INSULATOR : MAT_EMPTY;

    // Left station: contained water/steam thermal vessel on a steel workbench.
    int tankLeft = 24;
    int tankRight = 188;
    int tankTop = 48;
    int tankBottom = 246;
    bool tankWall = (p.x == tankLeft || p.x == tankRight || p.y == tankTop || p.y == tankBottom) &&
                    p.x >= tankLeft && p.x <= tankRight && p.y >= tankTop && p.y <= tankBottom;
    if (tankWall) material = MAT_GLASS;
    if (p.x > tankLeft && p.x < tankRight && p.y > 132 && p.y < tankBottom) material = MAT_WATER;
    if (p.x > tankLeft + 8 && p.x < tankRight - 8 && p.y > tankTop + 10 && p.y < 118 &&
        (hash32(indexOf(p) ^ pc.seed) & 7u) == 0u) material = MAT_STEAM;
    if (rectContains(p, ivec2(78, tankBottom + 2), ivec2(134, tankBottom + 12))) material = MAT_COPPER;
    if (rectContains(p, ivec2(101, tankBottom - 5), ivec2(111, tankBottom + 2))) material = MAT_EMBER;

    // Center station: a real sediment sifter. Sand/silt and independent metal
    // pixels fall through a narrow outlet toward a magnet and separated bins.
    int hopperLeft = 226;
    int hopperRight = 390;
    int hopperTop = 42;
    int hopperBottom = 150;
    bool hopperWall = (p.x == hopperLeft || p.x == hopperRight || p.y == hopperTop) &&
                      p.x >= hopperLeft && p.x <= hopperRight && p.y >= hopperTop && p.y <= hopperBottom;
    if (hopperWall) material = MAT_STEEL;
    if (p.y == hopperBottom && p.x >= hopperLeft && p.x <= hopperRight && abs(p.x - 308) > 7)
        material = MAT_STEEL;
    if (p.x > hopperLeft && p.x < hopperRight && p.y > hopperTop + 8 && p.y < hopperBottom) {
        uint mix = hash32(indexOf(p) ^ pc.seed ^ 0x5f17u);
        if ((mix % 71u) == 0u) material = MAT_ALUMINUM_SHAVINGS;
        else if ((mix % 43u) == 0u) material = MAT_COPPER;
        else if ((mix % 23u) == 0u) material = MAT_IRON_SHAVINGS;
        else material = (mix & 3u) == 0u ? MAT_SILT : MAT_SAND;
    }
    if (rectContains(p, ivec2(410, 154), ivec2(444, 214))) material = MAT_MAGNET;
    if (rectContains(p, ivec2(232, 246), ivec2(438, 254))) material = MAT_STEEL;
    if ((p.x == 232 || p.x == 332 || p.x == 438) && p.y >= 214 && p.y <= 306) material = MAT_GLASS;
    if (p.y == 306 && p.x >= 232 && p.x <= 438) material = MAT_GLASS;

    // Right station: sealed, readable pink hydrogen and cyan oxygen chamber.
    int gasLeft = int(pc.width) - 172;
    int gasRight = int(pc.width) - 24;
    int gasTop = 42;
    int gasBottom = 164;
    bool gasWall = (p.x == gasLeft || p.x == gasRight || p.y == gasTop || p.y == gasBottom) &&
                   p.x >= gasLeft && p.x <= gasRight && p.y >= gasTop && p.y <= gasBottom;
    if (gasWall) material = MAT_GLASS;
    if (p.x > gasLeft && p.x < gasRight && p.y > gasTop && p.y < gasBottom) {
        int split = (gasLeft + gasRight) / 2;
        material = p.x < split ? MAT_HYDROGEN : MAT_OXYGEN;
    }
    if (rectContains(p, ivec2((gasLeft + gasRight) / 2 - 2, gasBottom - 9),
                         ivec2((gasLeft + gasRight) / 2 + 3, gasBottom))) material = MAT_EMBER;

    if (p.y >= floorY - 8 && p.y < floorY && p.x > 12 && p.x < int(pc.width) - 12)
        material = MAT_STEEL;
    return material;
}

uint goldMineMaterial(ivec2 p) {
    int width = int(pc.width);
    int height = int(pc.height);
    int floorY = height - 10;
    int upperFloor = 130;
    int middleFloor = 210;
    int lowerFloor = 286;
    uint material = MAT_EMPTY;

    if (p.y >= floorY) return MAT_STONE;
    if ((p.x < 12 || p.x >= width - 12) && p.y >= 18) material = MAT_STONE;

    // Tall left water tower and controlled waterfall.
    int towerLeft = 28;
    int towerRight = 132;
    int towerTop = 30;
    int towerBottom = upperFloor;
    bool towerWall = (p.x == towerLeft || p.x == towerRight || p.y == towerTop || p.y == towerBottom) &&
                     p.x >= towerLeft && p.x <= towerRight && p.y >= towerTop && p.y <= towerBottom;
    if (towerWall) material = MAT_STEEL;
    if (p.x > towerLeft && p.x < towerRight && p.y > towerTop + 8 && p.y < 78) material = MAT_WATER;
    if (p.x >= 74 && p.x <= 80 && p.y >= 78 && p.y < towerBottom) material = MAT_WATER;
    if ((p.x == 70 || p.x == 84) && p.y >= 74 && p.y < towerBottom) material = MAT_GLASS;

    // Large upper reservoir and filter bed, matching the reference layout.
    int reservoirLeft = 176;
    int reservoirRight = width - 28;
    int reservoirTop = 24;
    int reservoirBottom = 106;
    bool reservoirWall = (p.x == reservoirLeft || p.x == reservoirRight ||
                          p.y == reservoirTop || p.y == reservoirBottom) &&
                         p.x >= reservoirLeft && p.x <= reservoirRight &&
                         p.y >= reservoirTop && p.y <= reservoirBottom;
    if (reservoirWall) material = MAT_STEEL;
    if (p.x > reservoirLeft && p.x < reservoirRight && p.y > reservoirTop && p.y < 84)
        material = MAT_WATER;
    if (p.x > reservoirLeft && p.x < reservoirRight && p.y >= 84 && p.y < reservoirBottom)
        material = ((p.x / 8) & 1) == 0 ? MAT_STONE : MAT_GRASS;

    // Upper player deck.
    if (p.y >= upperFloor && p.y < upperFloor + 6 && p.x >= 22 && p.x < 226)
        material = MAT_STEEL;
    if (p.x >= 22 && p.x < 30 && p.y >= upperFloor && p.y < middleFloor)
        material = MAT_STEEL;

    // Middle deck, a loose sand pile with independent metal pixels, and a water room.
    if (p.y >= middleFloor && p.y < middleFloor + 6 && p.x >= 22 && p.x < width - 22)
        material = MAT_STEEL;
    ivec2 pileCenter = ivec2(286, middleFloor);
    ivec2 pile = p - pileCenter;
    if (pile.y <= 0 && pile.y > -58 && abs(pile.x) < 68 + pile.y) {
        uint mix = hash32(indexOf(p) ^ pc.seed ^ 0x91f3u);
        if ((mix % 97u) == 0u) material = MAT_ALUMINUM_SHAVINGS;
        else if ((mix % 41u) == 0u) material = MAT_COPPER;
        else if ((mix % 29u) == 0u) material = MAT_IRON_SHAVINGS;
        else material = MAT_SAND;
    }

    int poolLeft = width - 176;
    int poolRight = width - 32;
    int poolTop = 146;
    int poolBottom = middleFloor;
    bool poolWall = (p.x == poolLeft || p.x == poolRight || p.y == poolTop || p.y == poolBottom) &&
                    p.x >= poolLeft && p.x <= poolRight && p.y >= poolTop && p.y <= poolBottom;
    if (poolWall) material = MAT_GLASS;
    if (p.x > poolLeft && p.x < poolRight && p.y > poolTop + 12 && p.y < poolBottom)
        material = MAT_WATER;

    // Reachable steel ramps connect every level without teleporting the actor.
    if (p.x >= 126 && p.x < 226) {
        int rampY = middleFloor - ((p.x - 126) * (middleFloor - upperFloor)) / 100;
        if (p.y >= rampY && p.y < rampY + 3) material = MAT_STEEL;
    }
    if (p.x >= 34 && p.x < 134) {
        int rampY = lowerFloor - ((p.x - 34) * (lowerFloor - middleFloor)) / 100;
        if (p.y >= rampY && p.y < rampY + 3) material = MAT_STEEL;
    }

    // Lower combat floor and a contained lava hazard trench.
    if (p.y >= lowerFloor && p.y < lowerFloor + 6 && p.x >= 22 && p.x < width - 22)
        material = MAT_STEEL;
    int trenchLeft = 258;
    int trenchRight = 388;
    if ((p.x == trenchLeft || p.x == trenchRight) && p.y >= lowerFloor && p.y < floorY)
        material = MAT_STONE;
    if (p.x > trenchLeft && p.x < trenchRight && p.y > lowerFloor + 18 && p.y < floorY)
        material = MAT_LAVA;
    if (p.y == lowerFloor - 1 && p.x > width - 150 && p.x < width - 46 && (p.x % 23) == 0)
        material = MAT_BEETLE;
    if (rectContains(p, ivec2(430, lowerFloor - 10), ivec2(446, lowerFloor)))
        material = MAT_PLASMA_AMMO;

    return material;
}

uint demolitionMaterial(ivec2 p) {
    int floorY = int(pc.height) - 12;
    if (p.y >= floorY) return MAT_STONE;
    uint material = MAT_EMPTY;

    // Two grounded towers support a long hanging bridge made from the same cells as particles.
    if ((p.x >= 96 && p.x < 128 && p.y >= floorY - 174 && p.y < floorY) ||
        (p.x >= int(pc.width) - 128 && p.x < int(pc.width) - 96 && p.y >= floorY - 174 && p.y < floorY)) {
        material = MAT_STONE;
    }
    if (p.y >= floorY - 178 && p.y < floorY - 154 && p.x >= 96 && p.x < int(pc.width) - 96) material = MAT_ALUMINUM;
    if (p.y >= floorY - 154 && p.y < floorY - 146 && p.x >= 128 && p.x < int(pc.width) - 128) material = MAT_GLASS;

    // Suspended pixel loads demonstrate the 50-percent block integrity release.
    if (rectContains(p, ivec2(206, floorY - 234), ivec2(286, floorY - 178))) material = MAT_SAND;
    if (rectContains(p, ivec2(358, floorY - 226), ivec2(438, floorY - 178))) material = MAT_WATER;
    return material;
}


uint frontierBaseMaterial(ivec2 p) {
    const int surfaceY = 92;
    const int floorY = int(pc.height) - 8;
    uint material = MAT_EMPTY;

    // Terraria-like surface and Noita-like destructible underground strata.
    int terrainNoise = int(hash32(uint(p.x) * 7349u ^ pc.seed) % 9u) - 4;
    int localSurface = surfaceY + terrainNoise;
    if (p.y >= floorY) material = MAT_STONE;
    else if (p.y >= localSurface) {
        material = p.y == localSurface ? MAT_GRASS : (p.y < localSurface + 14 ? MAT_DIRT : MAT_STONE);
    }

    // Underground base shell and rooms. All walls are ordinary structural cells.
    bool baseOuter = rectContains(p, ivec2(32, 142), ivec2(430, 328));
    bool baseInner = rectContains(p, ivec2(42, 152), ivec2(420, 318));
    if (baseOuter) material = MAT_STEEL;
    if (baseInner) material = MAT_EMPTY;
    if (baseInner && (p.y == 208 || p.y == 264) && p.x > 42 && p.x < 420) material = MAT_STEEL;
    if (baseInner && (p.x == 136 || p.x == 250 || p.x == 356) && p.y > 152 && p.y < 318) material = MAT_STEEL;

    // Walkable internal ramps keep all three base levels reachable by the same
    // grid actor. Floors are opened first, then a two-cell steel stair surface
    // descends one cell for every two horizontal cells.
    if (p.y == 208 && p.x >= 136 && p.x < 232) material = MAT_EMPTY;
    if (p.x >= 136 && p.x < 232) {
        int rampY = 208 + ((p.x - 136) * 55) / 95;
        if (p.y >= rampY && p.y < rampY + 2) material = MAT_STEEL;
        else if (p.y >= 208 && p.y < rampY) material = MAT_EMPTY;
    }
    if (p.y == 264 && p.x >= 52 && p.x < 148) material = MAT_EMPTY;
    if (p.x >= 52 && p.x < 148) {
        int rampY = 264 + ((p.x - 52) * 53) / 95;
        if (p.y >= rampY && p.y < rampY + 2) material = MAT_STEEL;
        else if (p.y >= 264 && p.y < rampY) material = MAT_EMPTY;
    }

    // Doors and circulation openings.
    if (rectContains(p, ivec2(128, 188), ivec2(145, 208)) ||
        rectContains(p, ivec2(242, 244), ivec2(259, 264)) ||
        rectContains(p, ivec2(348, 188), ivec2(365, 208))) material = MAT_EMPTY;

    // Sloped access tunnel to the surface.
    for (int step = 0; step < 62; ++step) {
        int x = 54 + step;
        int y = 142 - step / 2;
        if (p.x >= x && p.x < x + 8 && p.y >= y && p.y < y + 12) material = MAT_EMPTY;
        if (p.x >= x && p.x < x + 8 && p.y == y + 12) material = MAT_STEEL;
    }

    // Waterfall aerator: reservoir, drop shaft, and collection basin.
    if (rectContains(p, ivec2(44, 24), ivec2(98, 66))) material = MAT_WATER;
    if ((p.x == 40 || p.x == 101 || p.y == 20) && p.x >= 40 && p.x <= 101 && p.y >= 20 && p.y <= 68)
        material = MAT_GLASS;
    if (p.x >= 67 && p.x <= 73 && p.y >= 66 && p.y < 178) material = MAT_WATER;
    if ((p.x == 62 || p.x == 78) && p.y >= 66 && p.y < 184) material = MAT_GLASS;
    if (rectContains(p, ivec2(48, 178), ivec2(118, 204))) material = MAT_WATER;
    if ((p.x == 44 || p.x == 121 || p.y == 204) && p.x >= 44 && p.x <= 121 && p.y >= 174 && p.y <= 204)
        material = MAT_GLASS;

    // Breathable starting atmosphere inside the base; CO2 pools low.
    if (baseInner && material == MAT_EMPTY && p.y < 282 && ((p.x + p.y) & 1) == 0) material = MAT_OXYGEN;
    if (baseInner && material == MAT_EMPTY && p.y >= 302 && (p.x & 3) == 0) material = MAT_CARBON_DIOXIDE;

    // Factory floor: mined material falls onto one unified cell-grid conveyor line.
    if (p.y >= 288 && p.y < 296 && p.x >= 112 && p.x < 392) material = MAT_CONVEYOR;
    if (rectContains(p, ivec2(192, 280), ivec2(200, 288))) material = MAT_FACTORY_CORE;
    if (rectContains(p, ivec2(224, 280), ivec2(232, 288))) material = MAT_SMELTER;
    if (rectContains(p, ivec2(272, 280), ivec2(280, 288))) material = MAT_ASSEMBLER;
    if (rectContains(p, ivec2(328, 280), ivec2(336, 288))) material = MAT_INSECT_HABITAT;

    // Initial resources make the production chain visibly functional.
    if (rectContains(p, ivec2(116, 270), ivec2(132, 290))) material = (p.y & 1) == 0 ? MAT_IRON : MAT_GOLD;
    if (rectContains(p, ivec2(248, 270), ivec2(258, 290))) material = MAT_COPPER;
    if (rectContains(p, ivec2(300, 270), ivec2(310, 290))) material = MAT_POWER_CELL;

    // Surface battlefield and opposing deployment zones.
    if (p.y == localSurface - 1 && p.x > 150 && p.x < 250 && (p.x % 31) == 0) material = MAT_ANT;
    if (p.y == localSurface - 1 && p.x > int(pc.width) - 220 && p.x < int(pc.width) - 80 && (p.x % 17) == 0)
        material = MAT_BEETLE;
    if (rectContains(p, ivec2(int(pc.width) - 104, 54), ivec2(int(pc.width) - 72, localSurface))) material = MAT_STEEL;

    // Enemy underground reinforcement plant uses the same factory mechanics with an unpowered-side core.
    int enemyLeft = int(pc.width) - 160;
    if (rectContains(p, ivec2(enemyLeft, 156), ivec2(int(pc.width) - 18, 264))) material = MAT_STEEL;
    if (rectContains(p, ivec2(enemyLeft + 10, 166), ivec2(int(pc.width) - 28, 254))) material = MAT_EMPTY;
    if (rectContains(p, ivec2(enemyLeft + 24, 216), ivec2(enemyLeft + 32, 224))) material = MAT_FACTORY_CORE;
    if (rectContains(p, ivec2(enemyLeft + 64, 224), ivec2(enemyLeft + 72, 232))) material = MAT_INSECT_HABITAT;
    if (p.y >= 232 && p.y < 240 && p.x >= enemyLeft + 12 && p.x < int(pc.width) - 30) material = MAT_CONVEYOR;
    if (rectContains(p, ivec2(enemyLeft + 12, 208), ivec2(enemyLeft + 24, 230))) material = MAT_STEEL;
    if (rectContains(p, ivec2(enemyLeft + 32, 208), ivec2(enemyLeft + 44, 230))) material = MAT_COPPER;
    if (rectContains(p, ivec2(enemyLeft + 48, 208), ivec2(enemyLeft + 60, 230))) material = MAT_PLASMA_AMMO;

    return material;
}

uint materialForScene(uint scene, ivec2 p) {
    if (scene == SCENE_SANDBOX) return sandboxMaterial(p);
    if (scene == SCENE_VOLCANO) return volcanoMaterial(p);
    if (scene == SCENE_WATERWORKS) return waterworksMaterial(p);
    if (scene == SCENE_ECOSYSTEM) return ecosystemMaterial(p);
    if (scene == SCENE_ENGINEERING) return engineeringMaterial(p);
    if (scene == SCENE_GOLD_MINE) return goldMineMaterial(p);
    if (scene == SCENE_DEMOLITION) return demolitionMaterial(p);
    if (scene == SCENE_FRONTIER_BASE) return frontierBaseMaterial(p);
    return MAT_EMPTY;
}

bool looseAuthoredCargo(uint scene, ivec2 p, uint material) {
    if (scene == SCENE_ENGINEERING &&
        rectContains(p, ivec2(227, 51), ivec2(390, 150)) &&
        (material == MAT_IRON || material == MAT_COPPER || material == MAT_GOLD)) return true;
    if (scene == SCENE_GOLD_MINE &&
        (material == MAT_IRON || material == MAT_COPPER || material == MAT_GOLD)) return true;

    if (scene == SCENE_FRONTIER_BASE) {
        if (rectContains(p, ivec2(116, 270), ivec2(132, 290)) &&
            (material == MAT_IRON || material == MAT_GOLD)) return true;
        if (rectContains(p, ivec2(248, 270), ivec2(258, 290)) && material == MAT_COPPER) return true;
        if (rectContains(p, ivec2(300, 270), ivec2(310, 290)) && material == MAT_POWER_CELL) return true;

        int enemyLeft = int(pc.width) - 160;
        if (rectContains(p, ivec2(enemyLeft + 12, 208), ivec2(enemyLeft + 24, 230)) &&
            material == MAT_STEEL) return true;
        if (rectContains(p, ivec2(enemyLeft + 32, 208), ivec2(enemyLeft + 44, 230)) &&
            material == MAT_COPPER) return true;
        if (rectContains(p, ivec2(enemyLeft + 48, 208), ivec2(enemyLeft + 60, 230)) &&
            material == MAT_PLASMA_AMMO) return true;
    }
    return false;
}

bool looseAuthoredTerrain(uint scene, ivec2 p, uint material) {
    if (material != MAT_SAND && material != MAT_SILT && material != MAT_SALT && material != MAT_ICE)
        return false;

    // Deliberate simulation samples must remain loose. World terrain surrounding
    // those samples is authored as stable Terraria-style terrain.
    if (scene == SCENE_SANDBOX && material == MAT_SAND) {
        ivec2 sandCenter = ivec2(int(pc.width / 5u), int(pc.height - 80u));
        ivec2 d = p - sandCenter;
        return d.y >= 0 && d.y < 38 && abs(d.x) < 40 - d.y;
    }
    if (scene == SCENE_ECOSYSTEM && material == MAT_SILT) return true;
    if (scene == SCENE_ENGINEERING && (material == MAT_SAND || material == MAT_SILT)) return true;
    if (scene == SCENE_GOLD_MINE && (material == MAT_SAND || material == MAT_SILT)) return true;
    if (scene == SCENE_DEMOLITION && material == MAT_SAND) return true;
    return false;
}

bool authoredStructuralCell(uint scene, ivec2 p, uint material) {
    // Authored walls, slopes, shells, machines, and terrain are
    // structural even when they do not fill a globally aligned 8x8 block.
    // Explicit cargo and demonstration piles remain canonical loose material.
    bool authoredTerrain = material == MAT_DIRT || material == MAT_GRASS ||
                           material == MAT_SAND || material == MAT_SILT ||
                           material == MAT_SALT || material == MAT_ICE;
    return (isBlockCapable(material) || authoredTerrain) &&
           !looseAuthoredCargo(scene, p, material) &&
           !looseAuthoredTerrain(scene, p, material);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (!inside(p)) return;

    uint scene = pc.material % SCENE_COUNT;
    uint material = materialForScene(scene, p);
    bool structural = authoredStructuralCell(scene, p, material);
    bool anchored = p.y >= int(pc.height) - 9;
    Cell cell = structural ? makeStructuralCell(material, anchored) : makeCell(material);
    bool machineController = (material == MAT_SMELTER || material == MAT_ASSEMBLER ||
                              material == MAT_INSECT_HABITAT) && (p.x & 7) == 3 && (p.y & 7) == 3;

    cell.aux = (cell.aux & ~AUX_RANDOM_MASK) | (hash32(indexOf(p) ^ pc.seed) & AUX_RANDOM_MASK) |
               (cell.aux & (AUX_WET | AUX_CHARGED | AUX_BEE_POLLEN | AUX_BEE_FED |
                            AUX_PLANT_STEM | AUX_STRUCTURAL | AUX_SUPPORTED |
                            AUX_STATE_MASK));

    // Machine controllers use the texture-bit range as four packed inventory
    // counters. Initialize it after assigning static texture variation and keep
    // allegiance in the independent charged flag.
    if (machineController) {
        setMachineInventory(cell, uvec4(0u));
        if (scene == SCENE_FRONTIER_BASE && p.x > int(pc.width / 2u)) cell.aux &= ~AUX_CHARGED;
        else cell.aux |= AUX_CHARGED;
    }

    if (scene == SCENE_ENGINEERING && isConductive(material) && p.x < 70) cell.aux |= AUX_CHARGED;
    if (material == MAT_BEETLE) cell.aux &= ~AUX_CHARGED;
    if (material == MAT_ANT || material == MAT_CONVEYOR) cell.aux |= AUX_CHARGED;
    if (material == MAT_FACTORY_CORE) {
        if (scene == SCENE_FRONTIER_BASE && p.x > int(pc.width / 2u)) cell.aux &= ~AUX_CHARGED;
        else cell.aux |= AUX_CHARGED;
    }
    cells[indexOf(p)] = cell;
}
