#version 450
#extension GL_GOOGLE_include_directive : require
#include "materials.glsl"
#include "conservation.glsl"
#include "tiles.glsl"
#include "chunks.glsl"
#include "bee_swarm.glsl"
#include "beehive.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) buffer CurrentCells { Cell cells[]; };
layout(std430, binding = 1) readonly buffer PaintSnapshot { Cell paintSnapshot[]; };
layout(std430, binding = 7) buffer Chunks { ChunkState chunks[]; };

void markPaintChunkDirty(ivec2 p) {
    atomicOr(chunks[chunkIndex(p, pc.width)].flags, CHUNK_DIRTY | CHUNK_ACTIVE);
}

const ivec2 paintDisplacementOffsets[8] = ivec2[8](
    ivec2(-1, -1), ivec2(0, -1), ivec2(1, -1), ivec2(-1, 0),
    ivec2(1, 0), ivec2(-1, 1), ivec2(0, 1), ivec2(1, 1));

bool isDirectPaintLife(uint material) {
    return material == MAT_BEE || material == MAT_QUEEN_BEE ||
           material == MAT_ANT || material == MAT_BEETLE;
}

uint paintRepresentedGasVolume(Cell medium) {
    if (!isGas(medium.material)) return 0u;
    uint volume = stateValue(medium);
    return volume == 0u ? 1u : volume;
}

bool displacePaintGas(ivec2 p, Cell medium) {
    if (!isGas(medium.material)) return true;
    uint remaining = paintRepresentedGasVolume(medium);
    uint capacity = 0u;
    for (uint i = 0u; i < 8u; ++i) {
        ivec2 candidate = p + paintDisplacementOffsets[i];
        if (!inside(candidate)) continue;
        Cell receiver = cells[indexOf(candidate)];
        if (receiver.material != medium.material) continue;
        capacity += 255u - min(paintRepresentedGasVolume(receiver), 255u);
    }
    if (capacity < remaining) return false;
    for (uint i = 0u; i < 8u && remaining != 0u; ++i) {
        ivec2 candidate = p + paintDisplacementOffsets[i];
        if (!inside(candidate)) continue;
        uint receiverIndex = indexOf(candidate);
        Cell receiver = cells[receiverIndex];
        if (receiver.material != medium.material) continue;
        uint represented = min(paintRepresentedGasVolume(receiver), 255u);
        uint transfer = min(remaining, 255u - represented);
        if (transfer == 0u) continue;
        setStateValue(receiver, represented + transfer);
        cells[receiverIndex] = receiver;
        markPaintChunkDirty(candidate);
        remaining -= transfer;
    }
    return remaining == 0u;
}

bool displacePaintMediumUpward(ivec2 p) {
    Cell contacted = cells[indexOf(p)];
    if (!isCellLiquid(contacted) && !isCellGas(contacted)) return true;

    int holeY = -1;
    for (int y = p.y - 1; y >= 0; --y) {
        ivec2 candidate = ivec2(p.x, y);
        Cell medium = cells[indexOf(candidate)];
        if (medium.material == MAT_EMPTY) {
            holeY = y;
            break;
        }
        if (isCellGas(medium)) {
            if (!displacePaintGas(candidate, medium)) return false;
            holeY = y;
            break;
        }
        if (!isCellLiquid(medium)) return false;
    }
    if (holeY < 0) return false;

    for (int y = holeY; y < p.y; ++y) {
        ivec2 destination = ivec2(p.x, y);
        ivec2 source = ivec2(p.x, y + 1);
        Cell moved = cells[indexOf(source)];
        moved.age = 0u;
        moved.aux |= AUX_MOVED;
        cells[indexOf(destination)] = moved;
        markPaintChunkDirty(destination);
    }
    return true;
}

bool paintColonySignature(ivec2 queen) {
    if (!inside(queen - ivec2(10)) || !inside(queen + ivec2(10)) ||
        paintSnapshot[indexOf(queen)].material != MAT_QUEEN_BEE) return false;
    // Both the accepted Fix29 and obsolete round body contain these seven
    // shell witnesses. A lone Queen or unrelated Honey/Pollen is not a colony.
    const ivec2 witnesses[7] = ivec2[7](
        ivec2(-8, 0), ivec2(0, -8), ivec2(0, 8),
        ivec2(-6, -6), ivec2(6, -6), ivec2(-6, 6), ivec2(6, 6));
    for (int i = 0; i < 7; ++i)
        if (paintSnapshot[indexOf(queen + witnesses[i])].material != MAT_BEEHIVE)
            return false;
    return true;
}

void erasePaintColonyCell(ivec2 p) {
    uint index = indexOf(p);
    Cell replacement = makeCell(MAT_ATMOSPHERE);
    recordConservation(cells[index], replacement);
    cells[index] = replacement;
    markPaintChunkDirty(p);
}

bool paintColonyOwnsCell(ivec2 queen, ivec2 p, Cell candidate, bool explicitOwner) {
    ivec2 delta = p - queen;
    bool body = delta.x * delta.x + delta.y * delta.y < 100 &&
        (candidate.material == MAT_BEEHIVE ||
         candidate.material == MAT_HONEY || candidate.material == MAT_POLLEN ||
         (all(equal(p, queen)) && candidate.material == MAT_QUEEN_BEE));
    if (body) return true;
    uint packedHome = beePackMetadata(0u, queen, 0u, pc.width, pc.height);
    ivec2 home = beeHomeCenterFromAux(packedHome, pc.width, pc.height);
    if (candidate.material == MAT_BEE)
        return ((candidate.aux & BEE_AUX_SWARM) != 0u &&
                all(equal(beeHomeCenterFromAux(candidate.aux, pc.width, pc.height), home))) ||
               (!explicitOwner && (candidate.aux & ~AUX_RANDOM_MASK) == 0u &&
                candidate.age == 0u && candidate.temperature == 20);
    // Only a complete old 72x8 supported Wood perch is recognizable as the
    // retired prefab. Partial/unrelated Wood is deliberately preserved.
    ivec2 perch = (queen / 8) * 8 + ivec2(-40, -16);
    if (candidate.material != MAT_WOOD ||
        any(lessThan(p, perch)) || any(greaterThanEqual(p, perch + ivec2(72, 8))))
        return false;
    bool legacyPerch = inside(perch) && inside(perch + ivec2(71, 7));
    for (int y = 0; y < 8 && legacyPerch; ++y)
        for (int x = 0; x < 72 && legacyPerch; ++x) {
            Cell perchCell = paintSnapshot[indexOf(perch + ivec2(x, y))];
            ivec2 offset = perch + ivec2(x, y) - queen;
            bool bodyOverlap = offset.x * offset.x + offset.y * offset.y < 100 &&
                perchCell.material == MAT_BEEHIVE;
            bool swarmOverlap = perchCell.material == MAT_BEE &&
                beeFormationSlotFromOffset(offset) >= 0;
            legacyPerch = bodyOverlap || swarmOverlap || (perchCell.material == MAT_WOOD &&
                (perchCell.aux & (AUX_STRUCTURAL | AUX_SUPPORTED)) ==
                    (AUX_STRUCTURAL | AUX_SUPPORTED));
        }
    return legacyPerch;
}

void main() {
    ivec2 local = ivec2(gl_GlobalInvocationID.xy);
    if (pc.activeMode == 3u || pc.activeMode == 4u) {
        // Each invocation owns one destination; all signature/perch reads use
        // the immutable bounded snapshot, never concurrently erased cells.
        // No invocation scans the former 385x385 explicit-owner footprint.
        int diameter = int(pc.radius * 2u + 1u);
        if (local.x >= diameter || local.y >= diameter) return;
        ivec2 center = ivec2(pc.brushX, pc.brushY);
        ivec2 p = center + local - ivec2(int(pc.radius));
        if (!inside(p)) return;
        Cell candidate = paintSnapshot[indexOf(p)];
        if (candidate.material != MAT_BEEHIVE && candidate.material != MAT_HONEY &&
            candidate.material != MAT_POLLEN && candidate.material != MAT_QUEEN_BEE &&
            candidate.material != MAT_BEE && candidate.material != MAT_WOOD) return;
        if (pc.activeMode == 4u) {
            if (paintColonyOwnsCell(center, p, candidate, true))
                erasePaintColonyCell(p);
        } else {
            for (int y = -54; y <= 54; ++y)
                for (int x = -54; x <= 54; ++x) {
                    ivec2 queen = center + ivec2(x, y);
                    if (paintColonySignature(queen) &&
                        paintColonyOwnsCell(queen, p, candidate, false)) {
                        erasePaintColonyCell(p);
                        return;
                    }
                }
        }
        return;
    }
    if (pc.activeMode == 2u) {
        // Nuke from Space recovers the accepted upper-left connected-Air
        // behavior without a CPU flood: the continuous Cloud deck is the
        // boundary, so only the bounded high sky dispatched above it may burn.
        ivec2 p = ivec2(pc.brushX, pc.brushY) + local;
        if (!inside(p) || local.x >= int(pc.radius) ||
            local.y >= int(pc.reserved)) return;
        if ((p.x & int(CHUNK_CELL_SIZE - 1u)) == 0 &&
            (p.y & int(CHUNK_CELL_SIZE - 1u)) == 0)
            markPaintChunkDirty(p);
        uint index = indexOf(p);
        Cell previous = cells[index];
        if (previous.material == MAT_ATMOSPHERE)
            cells[index] = makeCell(MAT_FIRE);
        return;
    }
    int diameter = int(pc.radius * 2u + 1u);
    if (local.x >= diameter || local.y >= diameter) return;

    ivec2 center = ivec2(pc.brushX, pc.brushY);
    ivec2 p = center + local - ivec2(int(pc.radius));
    if (!inside(p)) return;

    uint material = pc.material & 0xffffu;
    uint brushShape = (pc.material >> 16u) & 3u;
    bool tileMode = ((pc.material >> 18u) & 1u) != 0u;
    material = material < MATERIAL_COUNT ? material : MAT_EMPTY;

    if (tileMode) {
        ivec2 blockOrigin = (center / int(STRUCTURAL_BLOCK_SIZE)) * int(STRUCTURAL_BLOCK_SIZE);
        ivec2 blockEnd = blockOrigin + ivec2(int(STRUCTURAL_BLOCK_SIZE));
        if (p.x < blockOrigin.x || p.y < blockOrigin.y || p.x >= blockEnd.x || p.y >= blockEnd.y) return;
        bool anchored = blockEnd.y >= int(pc.height) - 1;
        Cell cell = isReconstructableMaterial(material) ? makeStructuralCell(material, anchored)
                                                       : makeCell(material);
        bool machineController = (material == MAT_SMELTER || material == MAT_ASSEMBLER ||
                                  material == MAT_INSECT_HABITAT || material == MAT_SLUICE_BOX) &&
                                 (p.x & 7) == 3 && (p.y & 7) == 3;
        uint paintEntropy = material == MAT_ATMOSPHERE
            ? 0u : (cellHash(p, uint(local.x + local.y * diameter)) & AUX_RANDOM_MASK);
        cell.aux = (cell.aux & ~AUX_RANDOM_MASK) | paintEntropy |
                   (cell.aux & (AUX_WET | AUX_CHARGED | AUX_BEE_POLLEN | AUX_BEE_FED |
                                AUX_PLANT_STEM | AUX_STRUCTURAL | AUX_SUPPORTED | AUX_STATE_MASK));
        if (machineController) {
            setMachineInventory(cell, uvec4(0u));
            cell.aux |= AUX_CHARGED;
        }
        uint index = indexOf(p);
        Cell previous = cells[index];
        if (material == MAT_SMOKE && (isCellLiquid(previous) || isCellGas(previous)) &&
            !displacePaintMediumUpward(p)) return;
        if (isDirectPaintLife(material) && isGas(previous.material) &&
            !displacePaintGas(p, previous)) return;
        recordConservation(previous, cell);
        cells[index] = cell;
        markPaintChunkDirty(p);
        return;
    }

    if ((material == MAT_SEED || isDirectPaintLife(material)) && any(notEqual(p, center))) return;

    ivec2 delta = p - center;
    int distanceSquared = delta.x * delta.x + delta.y * delta.y;
    int radius = int(pc.radius);
    bool insideBrush = false;
    if (brushShape == 0u) insideBrush = distanceSquared <= radius * radius;
    else if (brushShape == 1u) insideBrush = abs(delta.x) <= radius && abs(delta.y) <= radius;
    else if (brushShape == 2u) insideBrush = abs(delta.x) <= radius && abs(delta.y) <= 1;
    else insideBrush = abs(delta.x) <= 1 && abs(delta.y) <= radius;
    if (!insideBrush) return;

    Cell cell;
    int colonySlot = -1;
    if (material == MAT_BEEHIVE) {
        ivec2 prefabQueen = center;
        uint prefabDistrict = 0u;
        ivec2 prefabDistrictLocal = ivec2(0);
        if (beePersistentAddress(center, pc.width, pc.height,
                                 prefabDistrict, prefabDistrictLocal))
            prefabQueen = prefabDistrictLocal;
        uint prefab = beehivePrefabMaterial(
            prefabQueen, delta, beehivePrefabEntropy(prefabQueen, delta));
        if (prefab != MATERIAL_COUNT) {
            bool fixedHiveContent = prefab == MAT_BEEHIVE ||
                                    prefab == MAT_HONEY || prefab == MAT_POLLEN;
            cell = fixedHiveContent ? makeStructuralCell(prefab, true) : makeCell(prefab);
        } else {
            colonySlot = beeFormationSlotFromOffset(delta);
            if (colonySlot < 0) return;
            cell = makeCell(MAT_BEE);
        }
    } else {
        cell = makeCell(material);
    }

    uint paintEntropy = material == MAT_ATMOSPHERE
        ? 0u : (cellHash(p, uint(local.x + local.y * diameter)) & AUX_RANDOM_MASK);
    cell.aux = (cell.aux & ~AUX_RANDOM_MASK) | paintEntropy |
               (cell.aux & (AUX_WET | AUX_CHARGED | AUX_BEE_POLLEN | AUX_BEE_FED |
                            AUX_PLANT_STEM | AUX_STRUCTURAL | AUX_SUPPORTED | AUX_STATE_MASK));
    if (colonySlot >= 0) {
        cell.aux |= BEE_AUX_SWARM | BEE_AUX_FED;
        cell.aux = beePackMetadata(cell.aux, center, uint(colonySlot), pc.width, pc.height);
        cell.age = beePackAge(beeInitialTimer(uint(colonySlot)), BEE_TARGET_NONE);
    } else if (material == MAT_BEE) {
        uint slot = cellHash(center, 0xb33f1u) % BEE_FORMATION_COUNT;
        cell.aux |= BEE_AUX_SWARM | BEE_AUX_FED;
        cell.aux = beePackMetadata(cell.aux, center, slot, pc.width, pc.height);
        cell.age = beePackAge(beeInitialTimer(slot), BEE_TARGET_NONE);
    }

    uint index = indexOf(p);
    Cell previous = cells[index];
    if (material == MAT_SMOKE && (isCellLiquid(previous) || isCellGas(previous)) &&
        !displacePaintMediumUpward(p)) return;
    if (isDirectPaintLife(material) && isGas(previous.material) &&
        !displacePaintGas(p, previous)) return;
    recordConservation(previous, cell);
    cells[index] = cell;
    markPaintChunkDirty(p);
}
