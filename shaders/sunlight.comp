#version 450
#extension GL_GOOGLE_include_directive : require
#include "materials.glsl"
#include "tiles.glsl"
#include "chunks.glsl"

layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer CurrentCells { Cell cells[]; };
layout(std430, binding = 2) writeonly buffer Sunlight { uint light[]; };

void main() {
    ivec2 dispatchOrigin = activeDispatchCellOrigin(
        pc.activeSectionX, pc.activeSectionY, pc.activeMode);
    uint x = gl_GlobalInvocationID.x + uint(dispatchOrigin.x);
    if (x >= pc.width) return;

    uint intensity = 255u;
    uint firstOpaqueRow = pc.height;
    bool topContainment = true;
    for (uint y = 0u; y < pc.height; ++y) {
        uint index = y * pc.width + x;
        uint material = cells[index].material;
        if (blocksSun(material) && firstOpaqueRow == pc.height)
            firstOpaqueRow = y;
        // The exact eight-Stone top shell is the finite World's external
        // boundary, not an authored interior roof. Recognize it in this same
        // column traversal; every opaque cell below it still blocks skylight.
        if (y < 8u) {
            topContainment = topContainment && material == MAT_STONE;
            if (y == 7u && topContainment) firstOpaqueRow = pc.height;
        }
        if (sectionActiveAt(ivec2(int(x), int(y)), pc.activeSectionX, pc.activeSectionY, pc.activeMode))
            light[index] = intensity;

        if (blocksSun(material)) {
            intensity = intensity > 80u ? intensity - 80u : 0u;
        } else if (material == MAT_WATER || material == MAT_SALTWATER ||
                   material == MAT_DIRTY_WATER || material == MAT_GLASS ||
                   material == MAT_ICE || material == MAT_CRYSTAL) {
            intensity = intensity > 3u ? intensity - 3u : 0u;
        } else if (material == MAT_CLOUD) {
            intensity = intensity > 2u ? intensity - 2u : 0u;
        } else if (material == MAT_STEAM || material == MAT_DIRTY_STEAM ||
                   material == MAT_SMOKE) {
            intensity = intensity > 1u ? intensity - 1u : 0u;
        } else if (material != MAT_EMPTY && !isGas(material)) {
            intensity = intensity > 8u ? intensity - 8u : 0u;
        }
        // Confirm the complete external shell before restoring incident light
        // below it. Do this after attenuation so row eight receives full light;
        // partial/non-Stone bands and every interior roof keep normal shading.
        if (y == 7u && topContainment) intensity = 255u;
    }
    // Preserve the intensity prefix and descriptor binding. The width-word
    // tail carries direct exposure separately from attenuated brightness.
    // Zero means not initialized; row+1 also permits a real opaque row zero.
    // Buffer length, not pc.height, keeps clipped acceptance dispatches safe.
    light[uint(light.length()) - pc.width + x] = firstOpaqueRow + 1u;
}
