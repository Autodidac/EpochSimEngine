#version 450
#extension GL_GOOGLE_include_directive : require
#define EPOCH_SAND_NO_SIM_PUSH
#include "materials.glsl"
#include "tiles.glsl"
#include "chunks.glsl"
#include "debug_stats.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) buffer CurrentCells { Cell cells[]; };
layout(std430, binding = 4) readonly buffer Tiles { TileState tiles[]; };
layout(std430, binding = 5) buffer DebugStatsBuffer { uint debugStats[]; };
layout(std430, binding = 7) buffer Chunks { ChunkState chunks[]; };

layout(push_constant) uniform MovementPush {
    uint width;
    uint height;
    uint step;
    uint seed;
    int phase;
    int parity;
    uint collectDebug;
    uint reserved1;
} macroPc;

shared uint macroMoveAllowed;
shared ivec2 sourceTileShared;
shared ivec2 targetTileShared;

bool macroInside(ivec2 p) {
    return p.x >= 0 && p.y >= 0 && p.x < int(macroPc.width) && p.y < int(macroPc.height);
}

uint macroIndex(ivec2 p) { return uint(p.y) * macroPc.width + uint(p.x); }

Cell macroAt(ivec2 p) {
    return macroInside(p) ? cells[macroIndex(p)] : Cell(MAT_STONE, 0u, 20, AUX_STRUCTURAL);
}

uint macroHash(ivec2 tile, uint salt) {
    return hash32(uint(tile.x) * 73856093u ^ uint(tile.y) * 19349663u ^
        macroPc.step * 83492791u ^ macroPc.seed ^ salt);
}

bool bulkMovable(Cell cell) {
    return cell.material != MAT_EMPTY && cell.material < MATERIAL_COUNT &&
 !isStructural(cell) && !isCellGas(cell) &&
 (isCellLiquid(cell) || isCellPowder(cell));
}

bool bulkMovementAllows(Cell cell, uint randomValue) {
    if (cell.material == MAT_DIRT) return (randomValue & 3u) == 0u;
    if (cell.material == MAT_MUD) return (randomValue % 24u) == 0u;
    if (cell.material == MAT_HONEY) return (randomValue & 3u) == 0u;
    if (cell.material == MAT_LAVA) return stateValue(cell) >= 160u || (randomValue & 1u) == 0u;
    return true;
}

bool sourceRegion(ivec2 origin, out Cell representative) {
    representative = macroAt(origin);
    if (!bulkMovable(representative) || (representative.aux & AUX_MOVED) != 0u) return false;
    for (int y = 0; y < int(TILE_SIZE); ++y) {
        for (int x = 0; x < int(TILE_SIZE); ++x) {
  Cell cell = macroAt(origin + ivec2(x, y));
  if (cell.material != representative.material || !bulkMovable(cell) ||
      (cell.aux & AUX_MOVED) != 0u) return false;
        }
    }
    return true;
}

bool materialCanDisplace(Cell source, Cell target) {
    if (target.material == MAT_EMPTY) return true;
    if (isStructural(target) || isCellImmovable(target)) return false;
    if (isCellGas(target) && !isCellGas(source)) return true;
    if (isCellPowder(source))
        return isCellLiquid(target) && materialDensity(source.material) > materialDensity(target.material);
    if (isCellLiquid(source))
        return isCellGas(target) ||
     (isCellLiquid(target) && materialDensity(source.material) > materialDensity(target.material));
    return false;
}

bool targetRegionAllows(ivec2 origin, Cell source) {
    Cell first = macroAt(origin);
    if (!materialCanDisplace(source, first)) return false;
    for (int y = 0; y < int(TILE_SIZE); ++y) {
        for (int x = 0; x < int(TILE_SIZE); ++x) {
  Cell target = macroAt(origin + ivec2(x, y));
  if (target.material != first.material || !materialCanDisplace(source, target)) return false;
        }
    }
    return true;
}

bool targetRegionEmpty(ivec2 origin) {
    for (int y = 0; y < int(TILE_SIZE); ++y)
        for (int x = 0; x < int(TILE_SIZE); ++x)
  if (macroAt(origin + ivec2(x, y)).material != MAT_EMPTY) return false;
    return true;
}

bool regionSupported(ivec2 origin, Cell source) {
    int belowY = origin.y + int(TILE_SIZE);
    if (belowY >= int(macroPc.height)) return true;
    for (int x = 0; x < int(TILE_SIZE); ++x) {
        Cell below = macroAt(ivec2(origin.x + x, belowY));
        if (materialCanDisplace(source, below)) return false;
    }
    return true;
}

bool pairCoordinates(out ivec2 sourceTile, out ivec2 targetTile) {
    uint columns = tileColumns(macroPc.width);
    uint rows = (macroPc.height + TILE_SIZE - 1u) / TILE_SIZE;
    ivec2 pair = ivec2(gl_WorkGroupID.xy);
    if (macroPc.phase == 0) {
        sourceTile = ivec2(pair.x, pair.y * 2 + macroPc.parity);
        targetTile = sourceTile + ivec2(0, 1);
    } else if (macroPc.phase == 1 || macroPc.phase == 2) {
        sourceTile = ivec2(pair.x, pair.y * 2 + macroPc.parity);
        targetTile = sourceTile + ivec2(macroPc.phase == 1 ? -1 : 1, 1);
    } else {
        int baseX = pair.x * 2 + macroPc.parity;
        sourceTile = macroPc.phase == 3 ? ivec2(baseX, pair.y) : ivec2(baseX + 1, pair.y);
        targetTile = macroPc.phase == 3 ? sourceTile + ivec2(1, 0) : sourceTile + ivec2(-1, 0);
    }
    return sourceTile.x >= 0 && sourceTile.y >= 0 && targetTile.x >= 0 && targetTile.y >= 0 &&
 sourceTile.x < int(columns) && targetTile.x < int(columns) &&
 sourceTile.y < int(rows) && targetTile.y < int(rows);
}

void markMacroChunkDirty(ivec2 p) {
    atomicOr(chunks[chunkIndex(p, macroPc.width)].flags, CHUNK_DIRTY | CHUNK_ACTIVE);
}

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        macroMoveAllowed = 0u;
        ivec2 sourceTile;
        ivec2 targetTile;
        if (pairCoordinates(sourceTile, targetTile)) {
  sourceTileShared = sourceTile;
  targetTileShared = targetTile;
  ivec2 sourceOrigin = sourceTile * int(TILE_SIZE);
  ivec2 targetOrigin = targetTile * int(TILE_SIZE);
  Cell source;
  uint randomValue = macroHash(sourceTile, uint(macroPc.phase) + 1u);
  bool validSource = sourceRegion(sourceOrigin, source) &&
                     bulkMovementAllows(source, randomValue);
  bool allowed = false;
  if (validSource && macroPc.phase == 0) {
      allowed = targetRegionAllows(targetOrigin, source);
  } else if (validSource && (macroPc.phase == 1 || macroPc.phase == 2)) {
      allowed = regionSupported(sourceOrigin, source) &&
                targetRegionAllows(targetOrigin, source);
  } else if (validSource) {
      allowed = isCellLiquid(source) && regionSupported(sourceOrigin, source) &&
                targetRegionEmpty(targetOrigin);
  }
  macroMoveAllowed = allowed ? 1u : 0u;
        }
    }
    barrier();
    if (macroMoveAllowed == 0u) return;

    ivec2 local = ivec2(gl_LocalInvocationID.xy);
    ivec2 source = sourceTileShared * int(TILE_SIZE) + local;
    ivec2 target = targetTileShared * int(TILE_SIZE) + local;
    uint sourceIndex = macroIndex(source);
    uint targetIndex = macroIndex(target);
    Cell a = cells[sourceIndex];
    Cell b = cells[targetIndex];
    a.age = 0u;
    b.age = 0u;
    a.aux |= AUX_MOVED;
    b.aux |= AUX_MOVED;
    cells[sourceIndex] = b;
    cells[targetIndex] = a;

    if (gl_LocalInvocationIndex == 0u) {
        markMacroChunkDirty(source);
        markMacroChunkDirty(target);
        if (macroPc.collectDebug != 0u) {
  atomicAdd(debugStats[STAT_MACRO_TILE_MOVES], 1u);
  atomicAdd(debugStats[STAT_MACRO_CELL_MOVES], TILE_CELL_COUNT);
        }
    }
}
