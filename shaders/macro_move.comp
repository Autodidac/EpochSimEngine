#version 450
#extension GL_GOOGLE_include_directive : require
#define EPOCH_SAND_NO_SIM_PUSH
#include "materials.glsl"
#include "tiles.glsl"
#include "chunks.glsl"
#include "debug_stats.glsl"

// One workgroup owns one pair of 8x8 macro-cells. Thread zero validates the
// region; all 64 lanes then transfer the underlying canonical cells together.
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) buffer CurrentCells { Cell cells[]; };
layout(std430, binding = 4) readonly buffer Tiles { TileState tiles[]; };
layout(std430, binding = 5) buffer DebugStatsBuffer { uint debugStats[]; };
layout(std430, binding = 7) buffer Chunks { ChunkState chunks[]; };

layout(push_constant) uniform MovementPush {
    uint width;
    uint height;
    uint step;
    uint seed;
    int phase;
    int parity;
    uint collectDebug;
    uint reserved1;
} macroPc;

shared uint macroMoveAllowed;
shared ivec2 sourceTileShared;
shared ivec2 targetTileShared;

bool macroInside(ivec2 p) {
    return p.x >= 0 && p.y >= 0 && p.x < int(macroPc.width) && p.y < int(macroPc.height);
}
uint macroIndex(ivec2 p) { return uint(p.y) * macroPc.width + uint(p.x); }
Cell macroAt(ivec2 p) {
    return macroInside(p) ? cells[macroIndex(p)] : Cell(MAT_STONE, 0u, 20, AUX_STRUCTURAL);
}

uint macroHash(ivec2 tile, uint salt) {
    return hash32(uint(tile.x) * 73856093u ^ uint(tile.y) * 19349663u ^
        macroPc.step * 83492791u ^ macroPc.seed ^ salt);
}

bool openAtmosphere(Cell cell) {
    return cell.material == MAT_EMPTY || cell.material == MAT_OXYGEN;
}

bool bulkMovable(Cell cell) {
    if ((cell.aux & AUX_STRUCTURAL) != 0u || isCellGas(cell)) return false;
    return isCellLiquid(cell) || isCellPowder(cell);
}

bool bulkMovementAllows(uint material, uint randomValue) {
    if (material == MAT_DIRT) return (randomValue & 3u) == 0u;
    if (material == MAT_MUD) return (randomValue % 24u) == 0u;
    if (material == MAT_HONEY) return (randomValue & 3u) == 0u;
    if (material == MAT_LAVA) return (randomValue & 1u) == 0u;
    return true;
}

bool sourceRegion(ivec2 origin, out uint material) {
    Cell first = macroAt(origin);
    material = first.material;
    if (!bulkMovable(first) || !materialEnabled(material)) return false;
    for (int y = 0; y < int(TILE_SIZE); ++y) {
        for (int x = 0; x < int(TILE_SIZE); ++x) {
  Cell cell = macroAt(origin + ivec2(x, y));
  if (cell.material != material || !bulkMovable(cell)) return false;
  // Half-water is intentionally resolved by the fine passes. A macro
  // move never hides or duplicates half-unit volume state.
  if (material == MAT_WATER && isHalfWater(cell)) return false;
        }
    }
    return true;
}

bool regionOpen(ivec2 origin) {
    for (int y = 0; y < int(TILE_SIZE); ++y)
        for (int x = 0; x < int(TILE_SIZE); ++x)
  if (!openAtmosphere(macroAt(origin + ivec2(x, y)))) return false;
    return true;
}

bool materialCanDisplace(uint sourceMaterial, uint targetMaterial) {
    if (targetMaterial == MAT_EMPTY || targetMaterial == MAT_OXYGEN) return true;
    Cell source = Cell(sourceMaterial, 0u, 20, 0u);
    Cell target = Cell(targetMaterial, 0u, 20, 0u);
    if (isCellGas(target) && !isCellGas(source)) return true;
    if (isCellPowder(source))
        return isCellLiquid(target) && materialDensity(sourceMaterial) > materialDensity(targetMaterial);
    if (isCellLiquid(source))
        return isCellGas(target) ||
     (isCellLiquid(target) && materialDensity(sourceMaterial) > materialDensity(targetMaterial));
    return false;
}

bool targetRegionAllows(ivec2 origin, uint sourceMaterial) {
    if (regionOpen(origin)) return true;
    Cell first = macroAt(origin);
    uint targetMaterial = first.material;
    if ((first.aux & AUX_STRUCTURAL) != 0u || !materialCanDisplace(sourceMaterial, targetMaterial)) return false;
    for (int y = 0; y < int(TILE_SIZE); ++y) {
        for (int x = 0; x < int(TILE_SIZE); ++x) {
  Cell cell = macroAt(origin + ivec2(x, y));
  if (cell.material != targetMaterial || (cell.aux & AUX_STRUCTURAL) != 0u) return false;
        }
    }
    return true;
}

TileState tileStateAt(ivec2 tile) {
    uint columns = tileColumns(macroPc.width);
    return tiles[uint(tile.y) * columns + uint(tile.x)];
}

bool macroSupported(ivec2 sourceTile, uint sourceMaterial) {
    uint rows = (macroPc.height + TILE_SIZE - 1u) / TILE_SIZE;
    ivec2 belowTile = sourceTile + ivec2(0, 1);
    if (belowTile.y >= int(rows)) return true;
    TileState below = tileStateAt(belowTile);
    if (below.occupancy == 0u && below.material == MAT_EMPTY) return false;
    if (below.occupancy == TILE_CELL_COUNT && materialCanDisplace(sourceMaterial, below.material)) return false;
    return true;
}

bool pairCoordinates(out ivec2 sourceTile, out ivec2 targetTile) {
    uint columns = tileColumns(macroPc.width);
    uint rows = (macroPc.height + TILE_SIZE - 1u) / TILE_SIZE;
    ivec2 pair = ivec2(gl_WorkGroupID.xy);
    if (macroPc.phase == 0) {
        sourceTile = ivec2(pair.x, pair.y * 2 + macroPc.parity);
        targetTile = sourceTile + ivec2(0, 1);
    } else if (macroPc.phase == 1 || macroPc.phase == 2) {
        sourceTile = ivec2(pair.x, pair.y * 2 + macroPc.parity);
        targetTile = sourceTile + ivec2(macroPc.phase == 1 ? -1 : 1, 1);
    } else {
        int baseX = pair.x * 2 + macroPc.parity;
        sourceTile = macroPc.phase == 3 ? ivec2(baseX, pair.y) : ivec2(baseX + 1, pair.y);
        targetTile = macroPc.phase == 3 ? sourceTile + ivec2(1, 0) : sourceTile + ivec2(-1, 0);
    }
    return sourceTile.x >= 0 && sourceTile.y >= 0 && targetTile.x >= 0 && targetTile.y >= 0 &&
 sourceTile.x < int(columns) && targetTile.x < int(columns) &&
 sourceTile.y < int(rows) && targetTile.y < int(rows);
}

void markMacroChunkDirty(ivec2 p) {
    atomicOr(chunks[chunkIndex(p, macroPc.width)].flags, CHUNK_DIRTY | CHUNK_ACTIVE);
}

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        macroMoveAllowed = 0u;
        ivec2 sourceTile;
        ivec2 targetTile;
        if (pairCoordinates(sourceTile, targetTile)) {
  sourceTileShared = sourceTile;
  targetTileShared = targetTile;
  ivec2 sourceOrigin = sourceTile * int(TILE_SIZE);
  ivec2 targetOrigin = targetTile * int(TILE_SIZE);
  uint sourceMaterial = MAT_EMPTY;
  uint randomValue = macroHash(sourceTile, uint(macroPc.phase) + 1u);
  bool validSource = sourceRegion(sourceOrigin, sourceMaterial) &&
                     bulkMovementAllows(sourceMaterial, randomValue);
  bool allowed = false;
  if (validSource && macroPc.phase == 0) {
      allowed = targetRegionAllows(targetOrigin, sourceMaterial);
  } else if (validSource && (macroPc.phase == 1 || macroPc.phase == 2)) {
      allowed = macroSupported(sourceTile, sourceMaterial) &&
                targetRegionAllows(targetOrigin, sourceMaterial);
  } else if (validSource) {
      Cell source = macroAt(sourceOrigin);
      allowed = isCellLiquid(source) && macroSupported(sourceTile, sourceMaterial) &&
                regionOpen(targetOrigin);
  }
  macroMoveAllowed = allowed ? 1u : 0u;
        }
    }
    barrier();
    if (macroMoveAllowed == 0u) return;

    ivec2 local = ivec2(gl_LocalInvocationID.xy);
    ivec2 source = sourceTileShared * int(TILE_SIZE) + local;
    ivec2 target = targetTileShared * int(TILE_SIZE) + local;
    uint sourceIndex = macroIndex(source);
    uint targetIndex = macroIndex(target);
    Cell a = cells[sourceIndex];
    Cell b = cells[targetIndex];
    a.age = 0u;
    b.age = 0u;
    a.aux |= AUX_MOVED;
    b.aux |= AUX_MOVED;
    cells[sourceIndex] = b;
    cells[targetIndex] = a;

    if (gl_LocalInvocationIndex == 0u) {
        markMacroChunkDirty(source);
        markMacroChunkDirty(target);
        if (macroPc.collectDebug != 0u) {
  atomicAdd(debugStats[STAT_MACRO_TILE_MOVES], 1u);
  atomicAdd(debugStats[STAT_MACRO_CELL_MOVES], TILE_CELL_COUNT);
        }
    }
}
